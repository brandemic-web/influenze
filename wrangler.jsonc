{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "influenze",
  "compatibility_date": "2026-07-07",
  // The apex is the only hostname this Worker serves: www is a Cloudflare
  // Redirect Rule, which fires before Workers and so never arrives here, and
  // app.influenze.ai is Firebase.
  "routes": [
    { "pattern": "influenze.ai", "custom_domain": true }
  ],
  // Retires influenze.web-455.workers.dev, which served a public third copy of
  // the site. preview_urls must stay explicit — it defaults to workers_dev, so
  // deleting it here would silently take PR previews down too.
  "workers_dev": false,
  "preview_urls": true,
  // Server-rendered now (see astro.config.mjs). `main` is deliberately not
  // set here: @astrojs/cloudflare's build validates it eagerly against
  // dist/server/entry.mjs before that file exists, which breaks a clean
  // `astro build`. The adapter generates a complete config with `main`
  // already resolved at dist/server/wrangler.json — deploy with that one
  // (see the `deploy` script in package.json), not this file directly.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "SESSION", "id": "2d824550d547478dadc7d3f942d884db" }
  ]
}
