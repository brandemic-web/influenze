---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Button from "../components/common/Button.astro";
import bolt from "../assets/images/common/decor/green_bolt.png";
---

<Layout title="Page not found — Influenze.ai" hideCta noindex>
	<main
		class="flex min-h-[70vh] flex-col items-center justify-center gap-8 bg-[radial-gradient(120%_90%_at_50%_-10%,#7B4DFF_0%,#5A2FD8_35%,#2A1655_65%,#010101_100%)] px-6 pt-32 pb-24 text-center"
	>
		<Image src={bolt} alt="" class="w-30" loading="eager" />
		<h1 class="text-9xl capitalize leading-[1.1] text-white max-md:text-3xl">Page not found</h1>
		<p class="max-w-105 text-[1.125rem] leading-7 text-white/70">
			The page you're looking for doesn't exist or has been moved.
		</p>
		<Button href="/">Back to Home</Button>
	</main>
</Layout>
