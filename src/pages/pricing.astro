---
import Layout from "../layouts/Layout.astro";
import PricingPlans from "../components/pricing/PricingPlans.astro";
import ComparisonTable from "../components/common/ComparisonTable.astro";
import UseCasesSplit from "../components/pricing/UseCasesSplit.astro";
import { getPricingPage } from "../sanity/lib/queries";
import { getPerspectiveCookie } from "../lib/draft-mode";
import { parseStructuredDataOverride } from "../sanity/lib/customSchema";

const { data: page } = await getPricingPage(getPerspectiveCookie(Astro.cookies));
---

<Layout
	title={page?.seo?.title || "Pricing — Influenze.ai"}
	description={page?.seo?.description || "Built for teams that demand accuracy. Transparent, credit-based plans that cater to you."}
	noindex={page?.seo?.noindex ?? false}
	canonicalUrl={page?.seo?.canonicalUrl}
	structuredDataOverride={parseStructuredDataOverride(page?.seo?.customSchema)}
	scripts={page?.scripts}
	ctaButtonLabel="Sign Up"
>
	<main>
		<PricingPlans />
		<ComparisonTable />
		<UseCasesSplit />
	</main>
</Layout>
