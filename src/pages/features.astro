---
import Layout from "../layouts/Layout.astro";
import FeaturesHero from "../components/features/FeaturesHero.astro";
import CreatorShowcase from "../components/features/CreatorShowcase.astro";
import FeatureBlockHeading from "../components/features/FeatureBlockHeading.astro";
---

<Layout
	title="Features — Influenze.ai"
	description="A product that caters to you: targeted discovery, creator analytics, contact unlocks, comparisons, shortlists, sharing and reusable creator pools."
>
	<main>
		<FeaturesHero />
		<CreatorShowcase />
		<FeatureBlockHeading />
	</main>
</Layout>

<style is:global>
	html {
		scrollbar-width: none; /* Firefox */
		-ms-overflow-style: none; /* IE/Edge */
	}
	html::-webkit-scrollbar {
		display: none; /* Chrome, Safari, Opera */
	}
</style>
