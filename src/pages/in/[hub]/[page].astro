---
/**
 * /in/<hub>/<page>/: one Rankings list page, built from the backend
 * snapshot. Whether Google may index it is the admin tool's Publishing
 * setting for the page (`indexed`).
 */
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import CreatorList from "../../../components/rankings/CreatorList.astro";
import MoreLists from "../../../components/rankings/MoreLists.astro";
import RankingsHero from "../../../components/rankings/RankingsHero.astro";
import { RANKINGS_COPY as COPY, pageIntro, signupUrl } from "../../../data/rankings";
import { getHubs, getSnapshot, splitPath } from "../../../lib/rankings";

export const prerender = true;

export const getStaticPaths = (async () => {
	const snapshot = await getSnapshot();
	return snapshot.pages.map((page) => {
		const { hub, page: slug } = splitPath(page.path);
		return { params: { hub, page: slug } };
	});
}) satisfies GetStaticPaths;

const snapshot = await getSnapshot();
const page = snapshot.pages.find((p) => {
	const { hub, page: slug } = splitPath(p.path);
	return hub === Astro.params.hub && slug === Astro.params.page;
});
if (!page) return Astro.rewrite("/404");

const signup = signupUrl(page.path);
const { country } = splitPath(page.path);
const hubPath = `${country}/${page.hub}`;
const hub = (await getHubs()).find((h) => h.path === hubPath);

const siblings = (hub?.pages ?? [])
	.filter((p) => p.path !== page.path)
	.map((p) => ({ href: `/${p.path}/`, label: p.heading }))
	.slice(0, COPY.moreListsLimit);
const moreLists = hub ? [...siblings, { href: `/${hubPath}/`, label: `${COPY.allLists} →` }] : siblings;
---

<Layout title={page.title} description={page.meta} noindex={!page.indexed} ctaButtonLabel={COPY.ctaButton} ctaHref={signup}>
	<main>
		<RankingsHero
			heading={page.heading}
			intro={pageIntro(page.meta)}
			signupHref={signup}
			draft={!page.indexed}
		>
			<CreatorList creators={page.creators} plat={page.plat} pagePath={page.path} label={`${page.heading}: ${page.creators.length} ${COPY.listLabel}`} />
		</RankingsHero>
		<MoreLists heading={COPY.moreLists} items={moreLists} />
	</main>
</Layout>
