---
/**
 * /in/<hub>/: a Rankings hub, one per platform. Links to every published
 * list page under it. Open to Google once any of those pages is.
 */
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import MoreLists from "../../../components/rankings/MoreLists.astro";
import RankingsHero from "../../../components/rankings/RankingsHero.astro";
import { RANKINGS_COPY as COPY, signupUrl } from "../../../data/rankings";
import { getHubs, splitPath } from "../../../lib/rankings";

export const prerender = true;

export const getStaticPaths = (async () => {
	const hubs = await getHubs();
	return hubs.map((hub) => ({ params: { hub: splitPath(hub.path).hub } }));
}) satisfies GetStaticPaths;

const hub = (await getHubs()).find((h) => splitPath(h.path).hub === Astro.params.hub);
if (!hub) return Astro.rewrite("/404");

const cards = hub.pages.map((p) => ({
		href: `/${p.path}/`,
		label: p.heading,
		detail: `${p.stats.kept} ${COPY.hubCount}`,
		photos: p.creators.map((c) => c.photo_url).filter((url): url is string => Boolean(url)).slice(0, 3),
	}));
const signup = signupUrl(hub.path);
---

<Layout title={hub.title} description={hub.meta} noindex={!hub.indexed} ctaButtonLabel={COPY.ctaButton} ctaHref={signup}>
	<main>
		<RankingsHero
			heading={hub.heading}
			draft={!hub.indexed}
		>
			<MoreLists
				items={cards}
				variant="cards"
				search={{ label: COPY.searchLabel, placeholder: COPY.searchPlaceholder, empty: COPY.noMatches }}
			/>
		</RankingsHero>
	</main>
</Layout>
