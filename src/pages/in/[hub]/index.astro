---
/**
 * /in/<hub>/: a Top creators hub, one per platform. Links to every list page
 * under it that passed the quality gate. No creators and no search.
 *
 * First cut: noindex, plain markup, no design. The data pipeline is being
 * checked end to end before the pages get designed and opened to Google.
 */
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import { TOP_CREATORS_COPY as COPY } from "../../../data/top-creators";
import { getSnapshot, splitPath } from "../../../lib/top-creators";

export const prerender = true;

export const getStaticPaths = (async () => {
	const snapshot = await getSnapshot();
	return snapshot.hubs.map((hub) => ({ params: { hub: splitPath(hub.path).hub } }));
}) satisfies GetStaticPaths;

const snapshot = await getSnapshot();
const hub = snapshot.hubs.find((h) => splitPath(h.path).hub === Astro.params.hub);
if (!hub) return Astro.rewrite("/404");
const pages = hub.pages.map((path) => snapshot.pages.find((p) => p.path === path)).filter((p) => p != null);
---

<Layout title={hub.title} description={hub.meta} noindex hideCta>
	<main>
		<p><em>{COPY.draft}</em></p>
		<h1>{hub.heading}</h1>
		<p>{COPY.hubIntro}</p>
		<ul>
			{pages.map((page) => (
				<li>
					<a href={`/${page.path}/`}>{page.heading}</a>
					{" "}({page.stats.kept} creators)
				</li>
			))}
		</ul>
		<p>{COPY.refreshed} {snapshot.refreshed_at.slice(0, 10)}.</p>
	</main>
</Layout>
