---
/**
 * /in/<hub>/: a Top creators hub, one per platform. Links to every published
 * list page under it. Open to Google once any of those pages is.
 */
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import MoreLists from "../../../components/top-creators/MoreLists.astro";
import TopCreatorsHero from "../../../components/top-creators/TopCreatorsHero.astro";
import { TOP_CREATORS_COPY as COPY, formatDate, signupUrl } from "../../../data/top-creators";
import { getSnapshot, splitPath } from "../../../lib/top-creators";

export const prerender = true;

export const getStaticPaths = (async () => {
	const snapshot = await getSnapshot();
	return snapshot.hubs.map((hub) => ({ params: { hub: splitPath(hub.path).hub } }));
}) satisfies GetStaticPaths;

const snapshot = await getSnapshot();
const hub = snapshot.hubs.find((h) => splitPath(h.path).hub === Astro.params.hub);
if (!hub) return Astro.rewrite("/404");

const cards = hub.pages
	.map((path) => snapshot.pages.find((p) => p.path === path))
	.filter((p) => p != null)
	.map((p) => ({
		href: `/${p.path}/`,
		label: p.heading,
		detail: `${p.stats.kept} ${COPY.hubCount}`,
		photos: p.creators.map((c) => c.photo_url).filter((url): url is string => Boolean(url)).slice(0, 3),
	}));
const platformName = hub.plat ? COPY.platformNames[hub.plat] : null;
const signup = signupUrl(hub.path);
---

<Layout title={hub.title} description={hub.meta} noindex={!hub.indexed} ctaButtonLabel={COPY.ctaButton} ctaHref={signup}>
	<main>
		<TopCreatorsHero
			eyebrow={[COPY.eyebrow, platformName, COPY.countryLabel].filter(Boolean).join(" · ")}
			heading={hub.heading}
			intro={COPY.hubIntro}
			chips={snapshot.refreshed_at ? [`${COPY.refreshed} ${formatDate(snapshot.refreshed_at)}`] : []}
			draft={!hub.indexed}
		>
			<MoreLists items={cards} variant="cards" />
		</TopCreatorsHero>
	</main>
</Layout>
