---
import Layout from "../layouts/Layout.astro";
import ElementCard from "../components/ui-elements/ElementCard.astro";
import SearchUi from "../components/ui-elements/SearchUi.astro";
import PlatformUi from "../components/ui-elements/PlatformUi.astro";
import FollowerMetricsUi from "../components/ui-elements/FollowerMetricsUi.astro";
import FollowerQualityUi from "../components/ui-elements/FollowerQualityUi.astro";
import MetricTilesUi from "../components/ui-elements/MetricTilesUi.astro";
import AudienceAffinitiesUi from "../components/ui-elements/AudienceAffinitiesUi.astro";
import AddToListUi from "../components/ui-elements/AddToListUi.astro";
import CompareUi from "../components/ui-elements/CompareUi.astro";
import ShareToEmailUi from "../components/ui-elements/ShareToEmailUi.astro";
import CampaignCardUi from "../components/ui-elements/CampaignCardUi.astro";
import AnalyzedCreatorUi from "../components/ui-elements/AnalyzedCreatorUi.astro";
---

<Layout
	title="UI HTML Elements — Influenze.ai"
	description="Reference page holding plain-HTML versions of individual UI elements used across the product."
	hideCta={true}
>
	<main class="mx-auto max-w-6xl px-6 pt-32 pb-24">
		<header class="max-w-136">
			<h1 class="text-[2.25rem] font-bold text-white">UI HTML Elements</h1>
			<p class="mt-3 text-[1rem] leading-[1.6] text-[#8f88ab]">
				Plain-HTML versions of individual UI elements, styled with Tailwind
				utilities only. Each element is a component in <code
					class="text-[#b9b3cf]">src/components/ui-elements/</code
				> with a fixed rem size, so it can be dropped into any section and animated
				site-wide.
			</p>
		</header>

		<div
			class="mt-16 grid grid-cols-1 items-start gap-10 lg:grid-cols-2"
		>
			<ElementCard
				id="search-ui"
				name="Search UI"
			>
				<SearchUi />
			</ElementCard>

			<ElementCard
				id="platform-ui"
				name="Platform UI"
			>
				<PlatformUi />
			</ElementCard>

			<ElementCard
				id="follower-metrics-ui"
				name="Follower Metrics UI"
			>
				<FollowerMetricsUi />
			</ElementCard>

			<ElementCard
				id="follower-quality-ui"
				name="Follower Quality UI"
			>
				<FollowerQualityUi />
			</ElementCard>

			<ElementCard
				id="metric-tiles-ui"
				name="Metric Tiles UI"
			>
				<MetricTilesUi />
			</ElementCard>

			<ElementCard
				id="audience-affinities-ui"
				name="Audience Affinities UI"
			>
				<AudienceAffinitiesUi />
			</ElementCard>

			<ElementCard
				id="add-to-list-ui"
				name="Add to List UI"
			>
				<AddToListUi />
			</ElementCard>

			<ElementCard
				id="share-to-email-ui"
				name="Share to Email UI"
			>
				<ShareToEmailUi />
			</ElementCard>

			<ElementCard
				id="campaign-card-ui"
				name="Campaign Card UI"
			>
				<CampaignCardUi
					title="Zamna Campaign 2026"
					meta="last updated 2m ago"
					extraCount={3}
					selected
				/>
			</ElementCard>

			<ElementCard
				id="compare-ui"
				name="Compare UI"
				class="lg:col-span-2"
			>
				<CompareUi />
			</ElementCard>

			<ElementCard
				id="analyzed-creator-ui"
				name="Analyzed Creator UI"
				class="lg:col-span-2"
			>
				<AnalyzedCreatorUi
					title="Analyzed Creator"
					name="Justin Jose"
					tier="Macro Influencer"
					location="India"
					gender="Male"
					language="EN"
					enquireLabel="Enquire"
				/>
			</ElementCard>
		</div>
	</main>
</Layout>
