---
import Layout from "../layouts/Layout.astro";
import HeroBackdrop from "../components/compare/HeroBackdrop.astro";
import TwoTone from "../components/compare/TwoTone.astro";
import Icon from "../components/app/common/Icon.astro";
import { DEMO_PAGE } from "../data/demo";

const { title, description, heading, intro, facts, form } = DEMO_PAGE;
---

<Layout title={title} description={description} hideCta>
	<main class="relative isolate overflow-hidden bg-surface-dark">
		<div class="pointer-events-none absolute inset-0 opacity-45" aria-hidden="true">
			<HeroBackdrop fade="var(--color-surface-dark)" />
		</div>
		<div class="relative mx-auto grid max-w-[96.875rem] gap-y-8 px-6 pt-28 pb-14 sm:px-10 lg:grid-cols-2 lg:content-center lg:gap-x-16 lg:gap-y-10 lg:px-8 lg:pt-44 lg:pb-24">
			<div class="max-w-2xl lg:self-end">
				<h1 class="text-3xl leading-[1.08] tracking-tight text-balance sm:text-6xl lg:text-9xl">
					<TwoTone text={heading} accentBlock />
				</h1>
				<p class="mt-5 max-w-lg text-xs leading-relaxed text-white/80 lg:mt-6 lg:text-sm">{intro}</p>
			</div>

			<form
				id="demo-form"
				aria-labelledby="demo-form-title"
				action={form.emailHref}
				method="post"
				enctype="text/plain"
				class="min-w-0 rounded-[1.25rem] border border-white/15 bg-surface-card px-5 py-6 backdrop-blur-md sm:p-8 lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center lg:p-10"
			>
				<h2 id="demo-form-title" class="text-xl leading-[1.13] tracking-tight sm:text-3xl lg:text-4xl">
					<TwoTone text={form.heading} accentBlock />
				</h2>

				<div class="mt-6 grid gap-x-4 gap-y-4 sm:grid-cols-2 lg:mt-8 lg:gap-x-5 lg:gap-y-6">
					{form.fields.map((field) => (
						<label class="flex min-w-0 flex-col gap-2 text-xs">
							<span>{field.label} <span class="text-brand-primary" aria-hidden="true">*</span></span>
							<input
								type={field.type}
								name={field.label}
								autocomplete={field.autocomplete}
								maxlength={field.maxlength}
								required
								class="min-h-12 w-full min-w-0 rounded-sm border border-purple-soft/35 bg-surface-dark/50 px-3.5 text-xs text-white caret-brand-primary focus-visible:outline-2 focus-visible:outline-brand-primary"
							/>
						</label>
					))}
				</div>

				<fieldset class="mt-6 min-w-0 lg:mt-7">
					<legend class="text-xs">{form.roleLabel} <span class="text-brand-primary" aria-hidden="true">*</span></legend>
					<div class="mt-3 grid grid-cols-3 gap-2 sm:gap-3">
						{form.roles.map(({ label, icon }) => (
							<label class="relative cursor-pointer">
								<input type="radio" name={form.roleLabel} value={label} class="peer sr-only" required />
								<span class="flex h-full min-h-16 flex-col items-center justify-center gap-1.5 rounded-sm border border-purple-soft/25 bg-purple-deep/20 p-1.5 text-[0.875rem] text-white peer-checked:border-brand-primary peer-checked:bg-brand-primary/10 peer-checked:text-brand-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-primary hover:bg-purple-deep/35 lg:text-xs">
									<Icon name={icon} size="1.125rem" />
									{label}
								</span>
							</label>
						))}
					</div>
				</fieldset>

				<button type="submit" aria-describedby="demo-submit-note" class="hover-dark-pill mt-6 inline-flex min-h-11 cursor-pointer items-center justify-center rounded-full bg-button-primary px-6 py-3 text-xs font-semibold text-button-text lg:mt-8">
					{form.submitLabel}
				</button>
				<p id="demo-submit-note" class="mt-3 text-[0.875rem] leading-relaxed text-white/80">{form.submitNote}</p>
				<p class="mt-2 text-[0.875rem] leading-relaxed text-white/75">
					{form.privacyLead} <a href="/privacy/" class="text-brand-primary underline underline-offset-2">{form.privacyLabel}</a>.
				</p>
			</form>

			<dl class="grid grid-cols-2 gap-x-4 gap-y-5 border-t border-white/15 pt-5 lg:col-start-1 lg:row-start-2 lg:max-w-lg lg:grid-cols-1 lg:gap-y-4 lg:border-0 lg:pt-0">
				{facts.map(({ value, label, icon }) => (
					<div class="grid grid-cols-[auto_1fr] items-center gap-x-2.5 lg:grid-cols-[auto_7rem_1fr] lg:gap-x-4">
						<dt class="col-span-2 row-start-2 mt-1 text-[0.875rem] text-white/80 lg:col-span-1 lg:col-start-3 lg:row-start-1 lg:mt-0 lg:text-xs">{label}</dt>
						<dd class="col-span-2 row-start-1 grid grid-cols-subgrid items-center gap-x-2.5 lg:gap-x-4">
							<Icon name={icon} class="text-brand-primary" size="1.25rem" />
							<span class="text-md font-semibold tracking-tight tabular-nums lg:text-xl">{value}</span>
						</dd>
					</div>
				))}
			</dl>
		</div>
	</main>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>("#demo-form");
	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		const body = [...new FormData(form)].map(([label, value]) => `${label}: ${String(value).trim()}`).join("\r\n");
		window.location.href = `${form.action}&body=${encodeURIComponent(body)}`;
	});
</script>
