---
import Layout from "../layouts/Layout.astro";
import LegalDocument from "../components/legal/LegalDocument.astro";
import { TERMS } from "../data/terms";
import { LEGAL_UPDATED_ISO } from "../data/legal";
---

<Layout
	title={`${TERMS.title} — Influenze.ai`}
	description={TERMS.description}
	hideCta
	dateModified={LEGAL_UPDATED_ISO}
>
	<LegalDocument doc={TERMS} sibling={{ label: "Privacy Policy", href: "/privacy" }} />
</Layout>
