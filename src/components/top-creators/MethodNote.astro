---
/** How a Top creators list is made: three short points under the list. */
import { TOP_CREATORS_COPY as COPY } from "../../data/top-creators";
---

<section class="px-6 pb-20 lg:pb-32" aria-labelledby="method-heading">
	<div class="mx-auto max-w-280">
		<h2 id="method-heading" class="text-center text-[1.5rem] text-white lg:text-[2.25rem]">{COPY.method.heading}</h2>
		<ol class="mt-8 grid gap-4 lg:mt-10 lg:grid-cols-3 lg:gap-6">
			{COPY.method.points.map((point, i) => (
				<li class="rounded-[1.25rem] border border-white/15 bg-surface-dark/40 p-6 lg:p-8">
					<span class="text-[1.25rem] text-brand-primary lg:text-md">{String(i + 1).padStart(2, "0")}</span>
					<p class="mt-3 text-[0.9375rem] leading-6 text-white/80 lg:text-[1rem] lg:leading-6.5">{point}</p>
				</li>
			))}
		</ol>
	</div>
</section>
