---
/**
 * "Without Influenze — the manual way": eyebrow, heading and a bordered text box between
 * the 3D spreadsheet and hashtag icons, at the design's offsets on the 108rem stage.
 * Below lg the icons sit in front of the box, smaller, on its corners: each overlaps only
 * the top or bottom padding band, so no text is covered.
 */
import { Image } from "astro:assets";
import TwoTone from "../compare/TwoTone.astro";
import spreadsheet from "../../assets/images/feature_page/manual_way/spreadsheet_icon_3d.png";
import hashtag from "../../assets/images/feature_page/manual_way/hashtag_icon_3d.png";
import { plainText } from "../../data/feature";

interface Props {
	eyebrow: string;
	heading: string;
	body: string;
}

const { eyebrow, heading, body } = Astro.props;
---

<section class="relative px-6 pt-16 pb-14 lg:h-[35.8125rem] lg:w-[108rem] lg:mx-[calc(50%-54rem)] lg:p-0" aria-labelledby="manual-heading">
	<p
		class="text-center text-[0.875rem] uppercase text-brand-primary [text-box:trim-both_cap_alphabetic] lg:absolute lg:top-[7.375rem] lg:left-0 lg:w-full lg:text-[1.125rem]"
	>
		{plainText(eyebrow)}
	</p>
	<h2
		id="manual-heading"
		class="mt-4 text-center text-[1.875rem] capitalize leading-[1.15] text-white [text-box:trim-both_cap_alphabetic] lg:absolute lg:top-[11.3125rem] lg:left-0 lg:mt-0 lg:w-full lg:text-[2.25rem]"
	>
		<TwoTone text={heading} />
	</h2>

	<div class="relative mx-auto mt-16 flex max-w-[33.375rem] items-center justify-center lg:static lg:mt-0">
		<Image
			src={spreadsheet}
			alt=""
			widths={[317, 634]}
			sizes="(min-width: 1024px) 19.8125rem, 6rem"
			class="absolute -top-14 -left-3 size-20 max-lg:z-2 lg:top-[7.375rem] lg:left-[20.0625rem] lg:size-[19.8125rem]"
			loading="lazy"
		/>
		<p
			class="card-edge relative z-1 w-full rounded-sm px-6 py-8 text-center text-[0.9375rem] leading-6 text-[#cdcdcd]/70 lg:absolute lg:top-[15.875rem] lg:left-[37.3125rem] lg:min-h-[10.75rem] lg:w-[33.375rem] lg:px-[3.75rem] lg:py-10 lg:text-[1.125rem] lg:leading-6.5"
		>
			{plainText(body)}
		</p>
		<Image
			src={hashtag}
			alt=""
			widths={[310, 620]}
			sizes="(min-width: 1024px) 19.375rem, 6rem"
			class="absolute -right-3 -bottom-14 size-20 max-lg:z-2 lg:top-[13.1875rem] lg:left-[68.0625rem] lg:size-[19.375rem]"
			loading="lazy"
		/>
	</div>
</section>
