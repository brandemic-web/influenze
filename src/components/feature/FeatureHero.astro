---
/**
 * Feature-page hero. From lg up it is the Figma frame's first 1376px, each element at
 * its design coordinates (px ÷ 16 → rem on the 108rem stage); below lg the elements
 * stack. Backdrop, panel, pills and bubbles follow the platform hero.
 */
import { Image } from "astro:assets";
import Button from "../common/Button.astro";
import Icon from "../app/common/Icon.astro";
import HeroBackdrop from "../compare/HeroBackdrop.astro";
import HeroPills from "../compare/HeroPills.astro";
import TwoTone from "../compare/TwoTone.astro";
import logoButton from "../../assets/images/feature_page/hero/search_logo_button.png";
import { APP_URL, opensNewTab } from "../../data/site";
import { plainText, resolveBubbles } from "../../data/feature";
import type { ResolvedFeature } from "../../lib/feature-source";
import { heroCtaId } from "../../data/ctaIds";

interface Props {
	page: ResolvedFeature;
}

const { copy, heroBubbles } = Astro.props.page;

// Every creator_bubble_<name>.png in the folder is a candidate; the page's pick (Studio, or the code file's)
// chooses which six, in number order. Dropping a new file in the folder adds it to the pool.
const bubbleFiles = import.meta.glob<{ default: ImageMetadata }>("../../assets/images/feature_page/hero/creator_bubble_*.png", {
	eager: true,
});
const bubbleImages = Object.fromEntries(
	Object.entries(bubbleFiles).map(([path, file]) => [path.match(/creator_bubble_([a-z]+)[.]png$/)![1], file.default]),
);
const shown = resolveBubbles(heroBubbles, Object.keys(bubbleImages));

/** Design position and size of each creator bubble slot, in px on the 1728 frame. */
const bubbleSlots = [
	{ x: 288, y: 633, w: 187, h: 190 },
	{ x: 676, y: 533, w: 167, h: 171 },
	{ x: 1013, y: 550, w: 162, h: 165 },
	{ x: 1221, y: 667, w: 186, h: 188 },
	{ x: 554, y: 808, w: 161, h: 166 },
	{ x: 902, y: 801, w: 143, h: 146 },
];
const bubbles = bubbleSlots.flatMap((slot, i) => (shown[i] ? [{ ...slot, src: bubbleImages[shown[i]] }] : []));
const rem = (px: number) => `${px / 16}rem`;
/** A title line longer than the design's (25 characters) steps down a size so it still sets in two lines. */
const titleLines = plainText(copy.heroTitle).split("\n");
const longTitle = Math.max(...titleLines.map((l) => l.length)) > 25;
// Everything under the title is in normal flow, so a longer title simply pushes the pills, search box,
// CTA and body copy down; no line counting is needed. A long line only steps the title down a size.
const titleClass = longTitle
	? "lg:w-[59.25rem] lg:text-[3rem] lg:leading-[3.5rem]"
	: "lg:w-[51.5rem] lg:text-9xl lg:leading-[4.5rem]";
/** Title-to-pills gap: the design's pills sit 10px under a 2-line title at 4.5rem, 26px under one at 3.5rem. */
const pillsGap = longTitle ? "lg:mt-[2.625rem]" : "lg:mt-[1.625rem]";
/** Eyebrow-to-title gap, as drawn (the long title sits a rem lower). */
const titleGap = longTitle ? "lg:mt-[3.1rem]" : "lg:mt-[2.1rem]";
---

<section class="relative overflow-hidden" aria-labelledby="feature-title">
	<HeroBackdrop fade="#13101c" />

	<div class="relative mx-auto flex flex-col items-center px-6 pt-32 pb-0 text-center lg:min-h-[86rem] lg:w-[108rem] lg:mx-[calc(50%-54rem)] lg:px-0 lg:pt-[12.6875rem] lg:pb-[10.9rem]">

		{/* The panel is the real wrapper: from lg it is the drawn 63.3rem box (a minimum height) and grows with its content, so nothing below the title can be overlapped. */}
		<div class="relative -mx-3 flex flex-col self-stretch items-center rounded-[1.25rem] border border-white/10 bg-[#0a0718]/40 px-5 pt-10 pb-10 backdrop-blur-md lg:w-[63.3125rem] lg:min-h-[49.5625rem] lg:self-center lg:mx-0 lg:px-0 lg:pt-[3.8125rem] lg:pb-0">
			<p
				class="relative text-[0.875rem] uppercase text-brand-primary [text-box:trim-both_cap_alphabetic] lg:w-full lg:text-[1.125rem]"
			>
				{plainText(copy.heroEyebrow)}
			</p>
			<h1
				id="feature-title"
				class:list={[
					"relative mt-4 text-[2.125rem] leading-[1.1] lg:whitespace-pre-line text-white [text-box:trim-both_cap_alphabetic] lg:tracking-[-0.08rem] lg:text-balance",
					titleGap,
					titleClass,
				]}
			>
				<TwoTone text={copy.heroTitle} />
			</h1>

			<div class="relative mt-8 flex w-full justify-center lg:mt-0">
				<HeroPills row={pillsGap} />
			</div>

			{/*
				A working search box that hands off to the app. The two-tone prompt can't be a native
				placeholder, so it sits under a transparent input and hides once something is typed.
				The input has no name, so the app opens at its start page whatever was entered.
			*/}
			<div class="relative flex w-full justify-center lg:mt-[13.5rem]">
				<form
					action={APP_URL}
					method="get"
					target="_blank"
					role="search"
					class="relative mt-8 flex h-14 w-full max-w-[27.625rem] items-center rounded-full bg-white/10 pr-1.5 pl-4 backdrop-blur-md focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-brand-primary lg:mt-0 lg:h-[4.375rem] lg:w-[27.625rem] lg:pr-0 lg:pl-[1.0625rem]"
				>
					<Icon name="search" size="1.5rem" class="shrink-0 text-white" />
					<span class="relative ml-2.5 flex h-full min-w-0 flex-1 items-center lg:ml-[0.6875rem] lg:mr-[4.5rem]">
						<input
							type="text"
							placeholder=" "
							autocomplete="off"
							spellcheck="false"
							aria-label={plainText(copy.searchPrompt)}
							class="peer h-full w-full min-w-0 bg-transparent text-[0.875rem] leading-none text-white caret-brand-primary outline-none lg:text-[1.114rem]"
						/>
						<span
							class="pointer-events-none absolute top-1/2 left-0 max-w-full -translate-y-1/2 truncate text-[0.875rem] leading-none whitespace-nowrap text-white peer-[:not(:placeholder-shown)]:hidden lg:overflow-visible lg:text-[1.114rem]"
							aria-hidden="true"
						>
							<TwoTone text={copy.searchPrompt} accentClass="text-[#33e889]" />
						</span>
					</span>
					<button
						type="submit"
						aria-label="Search in Influenze.ai"
						class="ml-auto size-11 shrink-0 cursor-pointer rounded-full transition-transform hover:scale-105 focus-visible:outline-none lg:absolute lg:top-[0.375rem] lg:left-[23.5625rem] lg:ml-0 lg:size-[3.5625rem]"
					>
						<img src={logoButton.src} alt="" width="57" height="57" class="size-full" loading="eager" />
					</button>
				</form>
				{/* Desktop bubbles hang off the search box, so they stay around it however far the title pushes it down. */}
				<ul class="pointer-events-none absolute top-0 left-0 hidden w-full lg:block" aria-hidden="true">
					{
						bubbles.map((b) => (
							<li
								class="absolute"
								style={`left:calc(${rem(b.x)} - 22.375rem);top:calc(${rem(b.y)} - 46.125rem);width:${rem(b.w)};height:${rem(b.h)}`}
							>
								<Image src={b.src} alt="" width={374} class="h-full w-full object-contain" loading="eager" />
							</li>
						))
					}
				</ul>
			</div>

			<div class="relative z-10 mt-8 lg:mt-[9.125rem] lg:-mb-[1.75rem] lg:flex lg:w-full lg:justify-center">
				<Button href={copy.heroCtaLink} newTab={opensNewTab(copy.heroCtaLink)} ctaId={heroCtaId(Astro.url.pathname)}>{plainText(copy.heroCta)}</Button>
			</div>
		</div>

		<p
			class="relative mt-10 max-w-[39.3125rem] text-[1rem] leading-6 text-[#cdcdcd] [text-box:trim-both_cap_alphabetic] lg:mt-[7.625rem] lg:text-[1.125rem] lg:leading-7"
		>
			<TwoTone text={copy.heroBody} accentClass="text-[1.375rem] font-semibold text-brand-primary" />
		</p>

		<ul class="relative mt-10 flex flex-wrap justify-center gap-2 lg:hidden" aria-hidden="true">
			{
				bubbles.map((b) => (
					<li class="size-16 shrink-0">
						<Image src={b.src} alt="" width={374} class="h-full w-full object-contain" loading="lazy" />
					</li>
				))
			}
		</ul>
	</div>
</section>
