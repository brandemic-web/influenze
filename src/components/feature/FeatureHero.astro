---
/**
 * Feature-page hero. From lg up it is the Figma frame's first 1376px, each element at
 * its design coordinates (px ÷ 16 → rem on the 108rem stage); below lg the elements
 * stack. Backdrop, panel, pills and bubbles follow the platform hero.
 */
import { Image } from "astro:assets";
import Button from "../common/Button.astro";
import Icon from "../app/common/Icon.astro";
import HeroBackdrop from "../compare/HeroBackdrop.astro";
import HeroPills from "../compare/HeroPills.astro";
import TwoTone from "../compare/TwoTone.astro";
import bubbleOne from "../../assets/images/feature_page/hero/creator_bubble_one.png";
import bubbleTwo from "../../assets/images/feature_page/hero/creator_bubble_two.png";
import bubbleThree from "../../assets/images/feature_page/hero/creator_bubble_three.png";
import bubbleFour from "../../assets/images/feature_page/hero/creator_bubble_four.png";
import bubbleFive from "../../assets/images/feature_page/hero/creator_bubble_five.png";
import bubbleSix from "../../assets/images/feature_page/hero/creator_bubble_six.png";
import logoButton from "../../assets/images/feature_page/hero/search_logo_button.png";
import { opensNewTab } from "../../data/site";
import { plainText } from "../../data/feature";
import type { ResolvedFeature } from "../../lib/feature-source";
import { heroCtaId } from "../../data/ctaIds";

interface Props {
	page: ResolvedFeature;
}

const { copy } = Astro.props.page;

/** Design position and size of each creator bubble, in px on the 1728 frame. */
const bubbles = [
	{ src: bubbleOne, x: 288, y: 633, w: 187, h: 190 },
	{ src: bubbleTwo, x: 676, y: 533, w: 167, h: 171 },
	{ src: bubbleThree, x: 1013, y: 550, w: 162, h: 165 },
	{ src: bubbleFour, x: 1221, y: 667, w: 186, h: 188 },
	{ src: bubbleFive, x: 554, y: 808, w: 161, h: 166 },
	{ src: bubbleSix, x: 902, y: 801, w: 143, h: 146 },
];
const rem = (px: number) => `${px / 16}rem`;
/** A title line longer than the design's (25 characters) steps down a size so it still sets in two lines. */
const longTitle = Math.max(...plainText(copy.heroTitle).split("\n").map((l) => l.length)) > 25;
---

<section class="relative overflow-hidden" aria-labelledby="feature-title">
	<HeroBackdrop fade="#13101c" />

	<div class="relative mx-auto flex flex-col items-center px-6 pt-32 pb-0 text-center lg:block lg:h-[86rem] lg:w-[108rem] lg:mx-[calc(50%-54rem)] lg:p-0">
		<div
			class="pointer-events-none absolute hidden rounded-[1.25rem] border border-white/10 bg-[#0a0718]/40 backdrop-blur-md lg:block lg:inset-auto lg:top-[12.6875rem] lg:left-[22.375rem] lg:h-[49.5625rem] lg:w-[63.3125rem]"
			aria-hidden="true"
		>
		</div>

		{/* Below lg the panel wraps its content; from lg it is the drawn box behind absolutely placed pieces. */}
		<div class="relative -mx-3 flex flex-col self-stretch items-center rounded-[1.25rem] border border-white/10 bg-[#0a0718]/40 px-5 pt-10 pb-10 backdrop-blur-md lg:contents">
			<p
				class="relative text-[0.875rem] uppercase text-brand-primary [text-box:trim-both_cap_alphabetic] lg:absolute lg:top-[16.5rem] lg:left-0 lg:w-full lg:text-[1.125rem]"
			>
				{plainText(copy.heroEyebrow)}
			</p>
			<h1
				id="feature-title"
				class:list={[
					"relative mt-4 text-[2.125rem] leading-[1.1] lg:whitespace-pre-line text-white [text-box:trim-both_cap_alphabetic] lg:absolute lg:mt-0 lg:tracking-[-0.08rem] lg:text-balance",
					// A long title also takes the panel's full inner width, so an unbroken one still sets in two lines clear of the pills.
					longTitle
						? "lg:top-[20.75rem] lg:left-[24.375rem] lg:w-[59.25rem] lg:text-[3rem] lg:leading-[3.5rem]"
						: "lg:top-[19.75rem] lg:left-[28.25rem] lg:w-[51.5rem] lg:text-9xl lg:leading-[4.5rem]",
				]}
			>
				<TwoTone text={copy.heroTitle} />
			</h1>

			<div class="relative mt-8 flex w-full justify-center lg:static lg:mt-0">
				<HeroPills row="lg:top-[29.375rem]" />
			</div>

			<div
				class="relative mt-8 flex h-14 w-full max-w-[27.625rem] items-center rounded-full bg-white/10 pr-1.5 pl-4 backdrop-blur-md lg:absolute lg:top-[46.125rem] lg:left-[40.1875rem] lg:mt-0 lg:h-[4.375rem] lg:w-[27.625rem] lg:pr-0 lg:pl-[1.0625rem]"
				aria-hidden="true"
			>
				<Icon name="search" size="1.5rem" class="shrink-0 text-white" />
				<span class="ml-2.5 min-w-0 truncate text-[0.875rem] leading-none whitespace-nowrap text-white lg:ml-[0.6875rem] lg:overflow-visible lg:text-[1.114rem]">
					<TwoTone text={copy.searchPrompt} accentClass="text-[#33e889]" />
				</span>
				<img
					src={logoButton.src}
					alt=""
					width="57"
					height="57"
					class="ml-auto size-11 shrink-0 lg:absolute lg:top-[0.375rem] lg:left-[23.5625rem] lg:ml-0 lg:size-[3.5625rem]"
					loading="eager"
				/>
			</div>

			<div class="relative mt-8 lg:absolute lg:top-[60.625rem] lg:left-0 lg:mt-0 lg:flex lg:w-full lg:justify-center">
				<Button href={copy.heroCtaLink} newTab={opensNewTab(copy.heroCtaLink)} ctaId={heroCtaId(Astro.url.pathname)}>{plainText(copy.heroCta)}</Button>
			</div>
		</div>

		<p
			class="relative mt-10 max-w-[39.3125rem] text-[1rem] leading-6 text-[#cdcdcd] [text-box:trim-both_cap_alphabetic] lg:absolute lg:top-[69.875rem] lg:left-[34.375rem] lg:mt-0 lg:text-[1.125rem] lg:leading-7"
		>
			<TwoTone text={copy.heroBody} accentClass="text-[1.375rem] font-semibold text-brand-primary" />
		</p>

		<ul class="relative mt-10 flex flex-wrap justify-center gap-2 lg:static lg:mt-0" aria-hidden="true">
			{
				bubbles.map((b) => (
					<li
						class="size-16 shrink-0 lg:absolute lg:size-auto"
						style={`--x:${rem(b.x)};--y:${rem(b.y)};--w:${rem(b.w)};--h:${rem(b.h)}`}
					>
						<Image src={b.src} alt="" class="h-full w-full object-contain" loading="eager" />
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	@media (min-width: 1024px) {
		li[style*="--x"] {
			left: var(--x);
			top: var(--y);
			width: var(--w);
			height: var(--h);
		}
	}
</style>
