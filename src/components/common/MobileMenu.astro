---
import { NAV_ITEMS } from "../../data/nav";
import { LOGIN_URL } from "../../data/site";
import Button from "./Button.astro";

// Matches Header.astro — current page gets the brand green.
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (item: { href: string; newTab?: boolean }) =>
	!item.newTab && item.href.replace(/\/+$/, "") === currentPath;
---

<!-- Hamburger + slide-down panel. No mobile design exists; inferred (PLAN.md Phase 1). -->
<button
	type="button"
	id="mobile-menu-button"
	class="flex h-5 w-12 flex-col items-center justify-center gap-1.5 lg:hidden"
	aria-expanded="false"
	aria-controls="mobile-menu"
	aria-label="Open menu"
>
	<span class="bar bar-top block h-0.5 w-6.5 bg-white transition-transform duration-300 ease-in-out"></span>
	<span class="bar bar-middle block h-0.5 w-6.5 bg-white transition-opacity duration-300 ease-in-out"></span>
	<span class="bar bar-bottom block h-0.5 w-6.5 bg-white transition-transform duration-300 ease-in-out"></span>
</button>

<div id="mobile-menu" class="fixed inset-x-0 top-17 z-40  lg:hidden">
	<div class="menu-inner">
		<div class="rounded-[1.5rem] border border-brand-primary bg-[#18122b] p-6">
			<nav aria-label="Mobile">
				<ul class="flex flex-col">
					{
						NAV_ITEMS.map((item, index) =>
							item.dropdown ? (
								<li class={index < NAV_ITEMS.length - 1 ? "border-b border-white/10" : ""}>
									<button
										type="button"
										class="res-toggle flex w-full items-center justify-between py-4 text-[0.875rem] text-white"
										aria-expanded="false"
									>
										{item.label}
										<svg
											class="chevron h-2 w-3 transition-transform duration-300"
											viewBox="0 0 8 5"
											fill="none"
											aria-hidden="true"
										>
											<path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.5" />
										</svg>
									</button>
									<div class="submenu">
										<div class="overflow-hidden">
											<ul class="pb-2">
												{item.dropdown.map((link) => (
													<li>
														<a
															href={link.href}
															class="block py-2.5 pl-3 text-base text-white/60 hover:text-white"
														>
															{link.label}
														</a>
													</li>
												))}
											</ul>
										</div>
									</div>
								</li>
							) : (
								<li class={index <= NAV_ITEMS.length - 1 ? "border-b border-white/10" : ""}>
									<a
										href={item.href}
										target={item.newTab ? "_blank" : undefined}
										rel={item.newTab ? "noopener noreferrer" : undefined}
										aria-current={isActive(item) ? "page" : undefined}
										class:list={[
											"flex items-center gap-3 py-4 text-[0.875rem]",
											isActive(item) ? "text-brand-primary" : "text-white",
										]}
									>
										{item.label}
										{item.badge && (
											<span class="flex items-center gap-1.25 rounded-[0.3125rem] bg-button-primary p-2 text-[0.6875rem] leading-none font-semibold text-[#1D192B]">
												{item.badge}
												<svg class="h-2 w-2" viewBox="0 0 7 7" fill="none" aria-hidden="true">
													<path
														d="M0.450195 6.44995L6.45019 0.449951M6.45019 6.44995L6.45019 0.449951L0.450195 0.449952"
														stroke="currentColor"
														stroke-width="1"
														stroke-linecap="round"
													/>
												</svg>
											</span>
										)}
									</a>
								</li>
							),
						)
					}
				</ul>
			</nav>
			<Button
				href={LOGIN_URL}
				class="mt-6"
				newTab
			>
			Get Access
			</Button>
		</div>
	</div>
</div>

<style>
	/* Hamburger → X */
	#mobile-menu-button.is-open .bar-top {
		transform: translateY(0.5rem) rotate(45deg);
	}
	#mobile-menu-button.is-open .bar-middle {
		opacity: 0;
	}
	#mobile-menu-button.is-open .bar-bottom {
		transform: translateY(-0.5rem) rotate(-45deg);
	}

	/* Panel height-reveal (grid-rows 0fr → 1fr animates to content height) */
	#mobile-menu .menu-inner {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		visibility: hidden;
		transition:
			grid-template-rows 300ms ease,
			opacity 300ms ease,
			visibility 300ms;
	}
	#mobile-menu.is-open .menu-inner {
		grid-template-rows: 1fr;
		opacity: 1;
		visibility: visible;
	}
	#mobile-menu .menu-inner > div {
		overflow: hidden;
	}

	/* Resources submenu reveal */
	.submenu {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 300ms ease;
	}
	.res-toggle.is-open + .submenu {
		grid-template-rows: 1fr;
	}
	.res-toggle.is-open .chevron {
		transform: rotate(180deg);
	}
</style>

<script>
	const button = document.getElementById("mobile-menu-button")!;
	const menu = document.getElementById("mobile-menu")!;
	button.addEventListener("click", () => {
		const open = menu.classList.toggle("is-open");
		button.classList.toggle("is-open", open);
		button.setAttribute("aria-expanded", String(open));
		button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
	});

	menu.querySelectorAll<HTMLButtonElement>(".res-toggle").forEach((toggle) => {
		toggle.addEventListener("click", () => {
			const open = toggle.classList.toggle("is-open");
			toggle.setAttribute("aria-expanded", String(open));
		});
	});
</script>
