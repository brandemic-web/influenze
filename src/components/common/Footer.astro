---
import { Image } from "astro:assets";
import bolt from "../../assets/images/common/logos_and_icons/footer_logo.webp";
import wordmark from "../../assets/images/common/logos_and_icons/footer_text.png";
import gradientBg from "../../assets/images/common/decor/footer_gradient_mask.svg";
import influenze_mobile from "../../assets/images/common/logos_and_icons/influenze_wordmark_mobile.png";
import { FOOTER_COLUMNS } from "../../data/footer";

// Mobile stacks the columns in a single file to the right of the bolt; the `pl`
// on the wrapper is what clears it, and the small `pt` keeps the stack level with
// the bolt rather than sinking below it. Desktop is the flex row of columns.
---

<footer class="relative lg:overflow-hidden bg-surface-dark">
	<img
		src={gradientBg.src}
		alt=""
		class="pointer-events-none absolute inset-x-0 bottom-0 h-full lg:h-137.5 w-full object-cover max-lg:-scale-y-100"
		loading="lazy"
	/>

	<div class="relative mx-auto max-w-[108rem]">
		{/*
			Draws at w-45 (180px) on mobile and lg:w-95 (380px) from lg up, so these two
			widths cover both at 2x. Without them Astro would ship the full 796px source
			to a phone that paints it at 180.
		*/}
		<Image
			src={bolt}
			alt=""
			class="pointer-events-none absolute left-3.75 -top-8.5 w-45 lg:left-0 lg:bottom-1.25 lg:w-95 lg:top-auto"
			widths={[360, 760]}
			sizes="(min-width: 1024px) 380px, 180px"
			loading="lazy"
		/>

		<div
			class="flex flex-col gap-10 pt-6 pb-10 pl-52 pr-6 sm:pr-12 lg:flex-row lg:flex-wrap lg:justify-end lg:gap-x-47.5 lg:gap-y-10 lg:pt-48 lg:pr-25 lg:pb-7.5 lg:pl-150"
		>
			{
				FOOTER_COLUMNS.map((column) => (
					<nav aria-label={column.title}>
						<h2 class="text-[1.125rem] lg:text-[1.375rem] font-bold text-white">
							{column.title}
						</h2>
						<ul class="mt-5 flex flex-col gap-1 lg:gap-4 lg:mt-7.5">
							{column.links.map((link) => (
								<li>
									<a
										href={link.href}
										target={link.newTab ? "_blank" : undefined}
										rel={link.newTab ? "noopener noreferrer" : undefined}
										class="text-[0.875rem] lg:text-[1.125rem] text-white/50 transition-colors hover:text-white"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>

		<div
			class="relative flex justify-center px-6 lg:justify-end lg:pr-18.5 lg:pl-67"
		>
			<Image
				src={influenze_mobile}
				alt="influenze.ai"
				class="block w-full max-w-346.5 lg:hidden"
				loading="lazy"
			/>
			<Image
				src={wordmark}
				alt="influenze.ai"
				class="hidden w-full max-w-346.5 translate-y-[0%] lg:block"
				loading="lazy"
			/>
		</div>
	</div>
</footer>
