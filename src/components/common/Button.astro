---
/**
 * Button — shared pill button/link. Dark pill wrapped in a purple → mint
 * GRADIENT border, mint-filled on hover.
 *
 * Usage:
 *   <Button href="/signup">Sign Up</Button>
 *   <Button href={LOGIN_URL} class="w-full">Login / Sign Up</Button>
 *
 * Pass extra utility classes via `class` (e.g. `w-full` for full-width in the mobile menu).
 * Set `newTab` for links that leave the site, e.g. the app's login page.
 */
interface Props {
	href: string;
	class?: string;
	/** Open in a new tab. Adds the rel guard that `target="_blank"` needs. */
	newTab?: boolean;
}

const { href, class: className = "", newTab = false } = Astro.props;

// `noopener` keeps the opened page from reaching back through window.opener.
const target = newTab ? "_blank" : undefined;
const rel = newTab ? "noopener noreferrer" : undefined;
---

{
	/*
	 * The outer <a> is the gradient "border" (purple → mint). A ~1.5px padding
	 * (p-[1.5px]) reveals the gradient around the inner dark span, whose
	 * matching rounded-full clip turns that padding into a ring.
	 */
}
<a
	href={href}
	target={target}
	rel={rel}
	class:list={[
		"group inline-flex rounded-full bg-linear-to-r from-brand-primary to-[#0F5B33] p-[1.5px] transition-[transform,--tw-gradient-from,--tw-gradient-to] duration-300 hover:from-brand-primary hover:to-brand-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary",
		className,
	]}
>
	<span class="inline-flex w-full items-center justify-center rounded-full bg-surface-pill px-4 py-3 text-[0.75rem] leading-none text-white transition-colors duration-300 group-hover:bg-brand-primary group-hover:text-button-text lg:text-xs lg:px-6 lg:py-4">
		<slot />
	</span>
</a>
