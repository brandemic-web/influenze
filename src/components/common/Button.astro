---
type Props = {
	class?: string;
	/** Accessible name when the visible label alone is vague, e.g. "Learn More". Should start with the visible label. */
	ariaLabel?: string;
	title?: string;
} & (
	| {
		href: string;
		disabled?: false;
		newTab?: boolean;
		/** Marketing's name for this button in its click event (data/ctaIds.ts). */
		ctaId?: string;
	}
	| { disabled: true; href?: never; newTab?: never; ctaId?: never }
);

const { href, class: className = "", newTab = false, ctaId, ariaLabel, disabled = false, title } = Astro.props;

const Tag = disabled ? "button" : "a";
const attributes = disabled
	? { type: "button" as const, disabled: true }
	: {
		href,
		target: newTab ? "_blank" : undefined,
		rel: newTab ? "noopener noreferrer" : undefined,
		"data-cta-id": ctaId,
	};
---

{/* Padding exposes the green gradient around the inner dark pill. */}
<Tag
	{...attributes}
	aria-label={ariaLabel}
	title={title}
	class:list={[
		"group inline-flex rounded-full bg-linear-to-r from-brand-primary to-[#0F5B33] p-[1.5px] transition-[transform,--tw-gradient-from,--tw-gradient-to] duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary",
		!disabled && "hover:from-brand-primary hover:to-brand-primary",
		className,
	]}
>
	<span class:list={[
		"inline-flex w-full items-center justify-center rounded-full bg-surface-pill px-4 py-3 text-[0.75rem] leading-none text-white transition-colors duration-300 lg:text-xs lg:px-6 lg:py-4",
		!disabled && "group-hover:bg-brand-primary group-hover:text-button-text",
	]}>
		<slot />
	</span>
</Tag>
