---
import { Image } from "astro:assets";
import { SIGNUP_URL } from "../../data/site";
import Button from "./Button.astro";

// Bg images
import glowCenter from "../../assets/images/common/decor/glow_ellipse_center.svg";
import glowSide from "../../assets/images/common/decor/glow_ellipse_side.svg";
import bg_svg from "../../assets/images/common/cta_section/bg_svg_lines.svg";

//creator images
import creatorOne from "../../assets/images/common/cta_section/cta_creator_one.png";
import creatorTwo from "../../assets/images/common/cta_section/cta_creator_two.png";
import creatorThree from "../../assets/images/common/cta_section/cta_creator_three.png";
import creatorFour from "../../assets/images/common/cta_section/cta_creator_four.png";
import followersChip from "../../assets/images/common/cta_section/followers_count.svg";
import followers570k from "../../assets/images/common/cta_section/followers_count_570k.png";
import hyperLogo from "../../assets/images/common/cta_section/hyper_logo.svg";
import brandemicLogo from "../../assets/images/common/cta_section/brandemic_logo.svg";
import plusIcon from "../../assets/images/common/logos_and_icons/plus_icon_with_gradient.svg";
import shareIcon from "../../assets/images/common/logos_and_icons/share_icon_with_gradient.svg";

interface Props {
	buttonLabel?: string;
}

const { buttonLabel = "Sign Up" } = Astro.props;
---

<section
	class="relative overflow-hidden bg-background-primary py-[140px] lg:h-[610px] lg:py-0"
	aria-labelledby="cta-heading"
>
	<img src={bg_svg.src} alt="" class=" pointer-events-none absolute inset-0 h-full w-full" loading="lazy" />
	<!-- glows -->
	<img src={glowCenter.src} alt="" class="pointer-events-none absolute top-0 left-1/2 h-full lg:w-[1200px] w-[300px] -translate-x-1/2" loading="lazy" />
	<img src={glowSide.src} alt="" class="pointer-events-none absolute top-0 left-[-128px] h-full lg:w-[264px] w-[100px]" loading="lazy" />
	<img src={glowSide.src} alt="" class="pointer-events-none absolute top-0 right-[-128px] h-full lg:w-[264px] w-[100px]" loading="lazy" />

	<!-- floating creators + chips (mobile base, lg: desktop) -->
	<div class="pointer-events-none absolute inset-0 max-w-[1643px] mx-auto" aria-hidden="true">
		<!-- share icon -->
		<div class="absolute top-[38%] left-[-3%] w-[35px] z-10 lg:top-[11%] lg:left-[10%] lg:w-[65px]">
			<img src={shareIcon.src} alt="" loading="lazy" />
		</div>
		<!-- sunglasses creator -->
		<div class="absolute top-[40%] left-[2%] w-[80px] rotate-[-11deg] rounded-md overflow-hidden lg:top-[12%] lg:left-[13%] lg:w-40">
			<Image src={creatorOne} alt="" loading="lazy" />
		</div>
		<!-- plus icon -->
		<div class="absolute top-[25%] right-[23%] w-[30px] z-10 lg:top-[58%] lg:right-[18%] lg:w-[37px]">
			<img src={plusIcon.src} alt="" loading="lazy" />
		</div>
		<!-- woman creator -->
		<div class="absolute top-[14%] right-[3%] w-[80px] rotate-3 rounded-md overflow-hidden lg:top-[47%] lg:right-[12%] lg:w-[100px] lg:rounded-[12px] lg:rotate-[5deg] lg:z-10">
			<Image src={creatorThree} alt="" loading="lazy" />
		</div>
		<!-- orange creator -->
		<div class="absolute bottom-[22%] right-[10%] w-[65px] h-[65px] rotate-3 rounded-md overflow-hidden lg:bottom-auto lg:top-[7%] lg:right-[23%] lg:w-[135px] lg:h-[145px] lg:rotate-[5deg] lg:rounded-[12px]">
			<Image src={creatorFour} alt="" loading="lazy" />
		</div>
		<!-- followers chip -->
		<div class="absolute bottom-[14%] right-[2%] w-[90px] -rotate-6 lg:bottom-auto lg:top-[17%] lg:right-[12%] lg:w-[184px] lg:rotate-[-10deg]">
			<img src={followersChip.src} alt="" loading="lazy" />
		</div>
		<div class="lg:block absolute bottom-[16%] left-[8%] w-[50px] rotate-30 lg:top-[-32%] lg:right-[4%]">
			<img src={brandemicLogo.src} alt="" loading="lazy" />
		</div>

		<!-- desktop-only decorations -->
		<div class="hidden lg:block absolute top-[53%] left-[19%] w-24 rotate-20 rounded-md overflow-hidden">
			<Image src={creatorTwo} alt="" loading="lazy" />
		</div>
		<!-- hyper logo -->
		<div class="hidden absolute bottom-[16%] left-[8%] w-[90px] rotate-[-20deg] lg:bottom-[20%] lg:left-[6%] lg:w-[120px]">
			<img src={hyperLogo.src} alt="" loading="lazy" />
		</div>
		<div class="hidden lg:block absolute top-[65%] left-[15%] w-[115px] rotate-[-10deg]">
			<Image src={followers570k} alt="" loading="lazy" />
		</div>
	</div>

	<div class="relative flex h-full flex-col items-center justify-center gap-3 lg:gap-10">
		<h2 id="cta-heading" class="text-center text-[2rem] capitalize text-white max-md:text-3xl lg:text-[58px]">
			Ready to get influenzed?
		</h2>
		<Button href={SIGNUP_URL}>{buttonLabel}</Button>
	</div>
</section>
