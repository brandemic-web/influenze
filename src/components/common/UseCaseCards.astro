---
import { USE_CASES, USE_CASES_HEADING } from "../../data/useCases";
import { getHomePage } from "../../sanity/lib/queries";
import { getPerspectiveCookie } from "../../lib/draft-mode";

const { data: home } = await getHomePage(getPerspectiveCookie(Astro.cookies));
const heading = home?.useCases?.heading || USE_CASES_HEADING;
const useCases = home?.useCases?.cards?.length ? home.useCases.cards : USE_CASES;
---

<section class="bg-background-primary py-10 lg:pt-25 lg:pb-30" aria-labelledby="use-cases-heading">
	{/*
		`relative z-2` lifts the heading above the CreatorsAI gradient, which is
		absolutely positioned with z-0 and overhangs this section. The marquee
		below already does the same.
	*/}
	<h2
		id="use-cases-heading"
		class="relative z-2 text-center text-md lg:text-2xl capitalize text-brand-primary"
	>
		{heading}
	</h2>

	{/* GSAP marquee: cards rendered twice for a seamless loop; pauses on hover. */}
	<div class="use-case-marquee mt-8.5 overflow-hidden pb-1 relative z-2">
		<ul class="use-case-track flex w-max gap-5">
			{
				[...useCases, ...useCases].map((useCase, i) => (
					<li
						aria-hidden={i >= useCases.length ? "true" : undefined}
						class="w-121.25 max-w-[85vw] shrink-0 rounded-sm bg-linear-to-r from-[#19123A] via-[#19123A] to-[#575757] p-px"
					>
						<div class="h-full rounded-sm bg-background-primary px-6 lg:px-14.5 py-6 lg:py-10">
							<h3 class="text-sm lg:text-md text-white">{useCase.title}</h3>
							<p class="mt-5 text-[0.875rem] lg:text-[1.125rem] leading-6.5 text-[#CECECE]/70 ">
								{useCase.description}
							</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	import "../../scripts/use-case-cards";
</script>