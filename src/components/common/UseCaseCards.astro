---
import { USE_CASES } from "../../data/useCases";
---

<section class="bg-background-primary py-20 lg:pt-25 lg:pb-6.25" aria-labelledby="use-cases-heading">
	<h2 id="use-cases-heading" class="text-center text-[30px] lg:text-[2.25rem] capitalize text-brand-primary">
		Who is it for?
	</h2>

	<!-- GSAP marquee: cards rendered twice for a seamless loop; pauses on hover. -->
	<div class="use-case-marquee mt-15 overflow-hidden pb-1 relative z-2">
		<ul class="use-case-track flex w-max gap-5">
			{
				[...USE_CASES, ...USE_CASES].map((useCase, i) => (
					<li
						aria-hidden={i >= USE_CASES.length ? "true" : undefined}
						class="w-121.25 max-w-[85vw] shrink-0 rounded-sm bg-linear-to-r from-[#19123A] via-[#19123A] to-[#575757] p-px"
					>
						<div class="h-full rounded-sm bg-background-primary px-6 lg:px-14.5 py-6 lg:py-10">
							<h3 class="text-[20px] lg:text-md text-white">{useCase.title}</h3>
							<p class="mt-7 text-[14px] lg:text-[1.125rem] leading-6.5 text-[#CECECE]/38">
								{useCase.description}
							</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	import "../../scripts/use-case-cards";
</script>