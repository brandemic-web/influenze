---
import { Image } from "astro:assets";
import logo from "../../assets/images/common/logos_and_icons/influenze_logo_nav.svg";
import { NAV_ITEMS } from "../../data/nav";
import Button from "./Button.astro";
import MobileMenu from "./MobileMenu.astro";
import { LOGIN_URL } from "../../data/site";
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-2 lg:px-10 lg:pt-8">
	<div
		class="mx-auto flex  max-w-410.75 items-center justify-between rounded-full border border-brand-primary bg-surface-header py-2.5 pr-4.5 pl-1.5 backdrop-blur-md lg:pl-10 lg:flex-row"
	>
		<a href="/" class="shrink-0" aria-label="influenze.ai home">
			<Image src={logo} alt="influenze.ai" class="h-10 w-auto lg:h-16" />
		</a>

		<nav class="hidden items-center gap-10 lg:flex xl:gap-15" aria-label="Main">
			{
				NAV_ITEMS.map((item) =>
					item.dropdown ? (
						<div class="group relative" data-nav-dropdown>
							<button
								type="button"
								class="flex items-center gap-2.5 text-xs text-white hover:text-brand-primary cursor-pointer"
								aria-expanded="false"
								aria-haspopup="true"
							>
								{item.label}
								<svg
									class="h-1.25 w-2 transition-transform group-data-open:rotate-180"
									viewBox="0 0 8 5"
									fill="none"
									aria-hidden="true"
								>
									<path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.5" />
								</svg>
							</button>
							<ul
								class="invisible absolute top-full left-1/2 mt-4 w-48 -translate-x-1/2 rounded-[1rem] border border-white/10 bg-background-primary p-2 opacity-0 transition-all group-data-open:visible group-data-open:opacity-100 "
							>
								{item.dropdown.map((link) => (
									<li>
										<a
											href={link.href}
											class="block rounded-[0.625rem] px-4 py-3 text-xs text-white/80 hover:bg-white/5 hover:text-brand-primary"
										>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					) : (
						<a
							href={item.href}
							target={item.newTab ? "_blank" : undefined}
							rel={item.newTab ? "noopener noreferrer" : undefined}
							class="flex items-center gap-2.5 text-xs text-white hover:text-brand-primary"
						>
							{item.label}
							{item.badge && (
								<span class="flex items-center gap-1.25 rounded-[0.3125rem] bg-button-primary p-2 text-[0.6875rem] leading-none text-[#1D192B] font-semibold ">
									{item.badge}
									<svg class="h-2 w-2" viewBox="0 0 7 7" fill="none" aria-hidden="true">
										<path d="M0.450195 6.44995L6.45019 0.449951M6.45019 6.44995L6.45019 0.449951L0.450195 0.449952" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
									</svg>
								</span>
							)}
						</a>
					),
				)
			}
		</nav>

		<div class="hidden lg:block">
			<Button href={LOGIN_URL} variant="nav" newTab>Login / Sign Up</Button>
		</div>

		<MobileMenu />
	</div>
</header>

<script>
	document.querySelectorAll<HTMLElement>("[data-nav-dropdown]").forEach((dropdown) => {
		const button = dropdown.querySelector("button")!;
		button.addEventListener("click", (e) => {
			e.stopPropagation();
			const open = dropdown.hasAttribute("data-open");
			dropdown.toggleAttribute("data-open", !open);
			button.setAttribute("aria-expanded", String(!open));
		});
		document.addEventListener("click", () => {
			dropdown.removeAttribute("data-open");
			button.setAttribute("aria-expanded", "false");
		});
	});
</script>
