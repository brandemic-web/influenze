---
/**
 * Scripted pointer used by the CreatorsAI panel demos. It renders hidden and is
 * driven entirely by GSAP (see `scripts/creators-ai-demo.ts`), which positions
 * it in the stage's unscaled coordinate space — so it must sit as a direct
 * child of a panel, not inside one of the scaled cards.
 */
interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
	data-demo-cursor
	class:list={[
		"pointer-events-none absolute left-0 top-0 z-30 opacity-0",
		className,
	]}
	aria-hidden="true"
>
	<span
		data-demo-cursor-ring
		class="absolute -left-4 -top-4 block size-8 rounded-full border-2 border-brand-primary opacity-0"
	></span>
	<svg
		class="block size-6 drop-shadow-[0_0.125rem_0.25rem_rgba(0,0,0,0.6)]"
		viewBox="0 0 24 24"
		fill="none"
	>
		<path
			d="M5 2.5 18.5 12.2l-5.8.6-3 5.4z"
			fill="#ffffff"
			stroke="#0b0916"
			stroke-width="1.2"
			stroke-linejoin="round"></path>
	</svg>
</div>
