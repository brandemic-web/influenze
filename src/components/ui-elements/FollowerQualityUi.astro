---
/**
 * Follower Quality UI — audience breakdown with share bars.
 */
interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;

/** icon: person glyph plus a badge mark, drawn in the row's accent colour */
const rows = [
	{ label: "Real Followers", value: "62.28%", width: "62.28%", accent: "#34d399", badge: "check" },
	{ label: "Mass Followers", value: "22.45%", width: "22.45%", accent: "#fb923c", badge: "cross" },
	{ label: "Influencers", value: "2.42%", width: "2.42%", accent: "#a855f7", badge: "plus" },
	{ label: "Suspicious", value: "12.85%", width: "12.85%", accent: "#ef4444", badge: "mask" },
];
---

<div
	class:list={[
		"w-[25.9375rem] max-w-full rounded-[1rem] bg-[#212529] px-5 pt-4 pb-2 font-sans text-white",
		className,
	]}
>
	<span class="text-[0.8125rem] font-semibold">Follower Quality</span>

	<ul class="mt-1 flex list-none flex-col p-0">
		{
			rows.map((row) => (
				<li class="flex items-center gap-4 py-3.5">
					<svg
						class="size-6 flex-none"
						viewBox="0 0 24 24"
						aria-hidden="true"
						style={`color: ${row.accent}`}
					>
						<circle
							cx="10"
							cy="8"
							r="3.4"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
						/>
						<path
							d="M4 19c0-3.2 2.7-5 6-5 1 0 1.9.2 2.7.5"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
						/>
						{row.badge === "check" && (
							<path
								d="m14.5 15.5 1.8 1.8 3.2-3.6"
								fill="none"
								stroke="currentColor"
								stroke-width="1.7"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						)}
						{row.badge === "cross" && (
							<path
								d="m15 14.5 4 4m0-4-4 4"
								fill="none"
								stroke="currentColor"
								stroke-width="1.7"
								stroke-linecap="round"
							/>
						)}
						{row.badge === "plus" && (
							<path
								d="M17 13.6v5m-2.5-2.5h5"
								fill="none"
								stroke="currentColor"
								stroke-width="1.7"
								stroke-linecap="round"
							/>
						)}
						{row.badge === "mask" && (
							<path
								d="M4.5 15.5h11m-9.5 0v1.8a2 2 0 0 0 2 2h5.5a2 2 0 0 0 2-2v-1.8"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
							/>
						)}
					</svg>

					<div class="flex-auto">
						<span class="block text-[1.0625rem] font-bold">{row.label}</span>
						<span class="mt-2 block h-[0.1875rem] w-full rounded-full bg-white/10">
							<span
								class="block h-full rounded-full bg-linear-to-r from-[#7c5cff] to-[#22d18f]"
								style={`width: ${row.width}`}
							/>
						</span>
					</div>

					<span class="text-[1.25rem] font-bold tabular-nums">{row.value}</span>
				</li>
			))
		}
	</ul>
</div>
