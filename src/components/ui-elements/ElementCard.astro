---
/**
 * Showcase cell for the UI elements page: a name and a stage holding one element.
 */
interface Props {
	name: string;
	id?: string;
	class?: string;
}

const { name, id, class: className = "" } = Astro.props;
---

<article id={id} class:list={["flex flex-col", className]}>
	<h2 class="text-[1.125rem] font-semibold tracking-[0.01em] text-brand-primary">
		{name}
	</h2>
	<div
		class="mt-4 flex flex-auto items-start justify-center rounded-[1rem] border border-white/[0.07] bg-[#060309] p-6"
	>
		<slot />
	</div>
</article>
