---
import Icon from "./Icon.astro";

/**
 * Share to Email UI — share modal with an expiry picker.
 */
interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
	class:list={[
		"w-[25.1875rem] max-w-full overflow-hidden rounded-[1rem] border border-white/8 bg-[#17151f] font-sans text-white",
		className,
	]}
>
	<div class="relative px-5 pt-5 pb-4">
		<h3 class="text-center text-[1.125rem] font-medium">Share to email</h3>
		<button
			type="button"
			aria-label="Close"
			class="absolute top-4 right-4 inline-flex cursor-pointer p-0.5 text-ui-muted hover:text-white"
		>
			<Icon name="close" class="size-3" strokeWidth={1.6} />
		</button>
	</div>

	<div class="px-5 pb-5">
		<div class="flex items-center gap-2.5 rounded-sm bg-[#35315a] px-3.5 py-3">
			<Icon name="mail" class="size-4 text-ui-violet-hover" />
			<span class="flex-auto text-[0.9375rem]">aesha@spenny</span>
			<span class="text-[0.75rem] text-ui-muted">expires on</span>
			<button
				type="button"
				class="inline-flex cursor-pointer items-center gap-1.5 rounded-[0.375rem] bg-white px-2.5 py-1 text-[0.75rem] font-semibold text-[#111318]"
			>
				3 Jul
				<Icon name="arrow-down" class="size-3" strokeWidth={1.5} />
			</button>
		</div>
	</div>

	<div class="border-t border-white/8 px-5 pt-5 pb-5">
		<button
			type="button"
			class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-sm bg-[#3b2f7a] py-3.5 text-[1.125rem] font-semibold text-ui-subtle hover:bg-[#463891]"
		>
			Send
			<svg class="size-4 flex-none" viewBox="0 0 16 16" aria-hidden="true">
				<path
					d="M6.5 3.5H12v5.5M12 3.9 7 8.9M11.5 9.5v2a1.5 1.5 0 0 1-1.5 1.5H4.5A1.5 1.5 0 0 1 3 11.5V6a1.5 1.5 0 0 1 1.5-1.5h2"
					fill="none"
					stroke="currentColor"
					stroke-width="1.3"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>

		<p class="mt-4 text-center">
			<a
				href="#"
				class="text-[0.8125rem] text-ui-violet-link underline underline-offset-2 hover:text-ui-violet-hover"
			>
				Manage Shared Links
			</a>
		</p>
	</div>
</div>
