---
import Icon from "./Icon.astro";

/**
 * Search UI — filter panel.
 */
interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;

/**
 * Location pills. The last one is the pill the panel-0 demo drops in, so it
 * carries `data-search-pill` — see scripts/creators-ai-panels.
 */
const regions = ["United States", "Germany", "India"];
---

<div
	class:list={[
		"flex h-154.75 w-108.5 max-w-full flex-col overflow-hidden rounded-[1.25rem] border border-white/8 bg-[#040308] px-4 pt-4 pb-5 font-sans text-white",
		className,
	]}
>
	<!-- Top bar -->
	<div class="flex items-center gap-3.5 border-b border-white/9 pb-4 pl-3">
		<span class="text-[1.0625rem] font-semibold">Filters</span>
		<button
			type="button"
			class="cursor-pointer text-[0.9375rem] font-medium text-ui-violet-link hover:text-ui-violet-hover"
		>
			Clear All
		</button>
		<button
			type="button"
			class="ml-auto cursor-pointer rounded-sm bg-gradient-primary px-3.75 py-2 text-[0.875rem] font-semibold text-white hover:bg-ui-indigo-hover"
		>
			Apply &amp; Search
		</button>
	</div>

	<!-- Lookalike group -->
	<div class="mt-4 overflow-hidden rounded-sm">
		<div
			class="flex items-center justify-between bg-[#5a44a8] px-4 py-3.25 text-white mb-2"
		>
			<span
				class="inline-flex items-center gap-1.75 text-[0.9375rem] font-medium"
			>
				Lookalike
				<Icon name="info" class="size-4 text-white/65" />
			</span>
			<Icon name="chevron-down" class="size-4" />
		</div>

		<div
			class="rounded-b-sm bg-linear-[67deg] from-[#201D36] to-[#121214] px-3.5 pt-3.75 pb-5.5 border-2 border-[#574789]"
		>
			<div class="flex gap-3" role="group" aria-label="Lookalike type">
				<button
					type="button"
					aria-pressed="true"
					class="inline-flex cursor-pointer items-center gap-1.75 rounded-[0.625rem] border border-[#7E57EA] bg-[#50349E] px-4 py-2.5 text-[0.9375rem] font-medium text-white"
				>
					<Icon name="audience" class="size-3.5 text-ui-violet" />
					Audience
				</button>
				<button
					type="button"
					aria-pressed="false"
					class="inline-flex cursor-pointer items-center gap-1.75 rounded-[0.625rem] border border-white/12 bg-[#161423] px-4 py-2.5 text-[0.9375rem] font-medium text-ui-subtle hover:border-white/24 hover:text-white"
				>
					<Icon name="creator" class="size-3.5 text-ui-violet" />
					Creator
				</button>
			</div>

			<div
				data-search-field="handle"
				class="mt-3.75 flex items-center gap-0.5 border-b border-white/14 px-1 py-1 pb-1 text-ui-subtle"
			>
				<Icon name="search" class="size-4 text-ui-muted" />
				<p class="text-white" data-search-text>
					<span class="text-brand-primary">@</span>nikhilchinapa
				</p>
				<span
					data-search-caret
					class="ml-px inline-block h-4 w-px flex-none bg-white opacity-0"
					aria-hidden="true"></span>
			</div>
		</div>
	</div>

	<!-- Sort By card -->
	<div class="mt-4 rounded-md bg-[#100e1b] px-3.5 pt-4 pb-4.5">
		<div class="flex items-center justify-between gap-3">
			<span class="text-[0.9375rem] font-medium text-white">Sort By</span>
			<button
				type="button"
				aria-label="Remove Sort By"
				class="inline-flex cursor-pointer p-0.5 text-ui-muted hover:text-white"
			>
				<Icon name="close" class="size-4" />
			</button>
		</div>
		<div
			class="relative mt-3.75 flex items-center gap-2.5 rounded-[0.625rem] bg-[#1a1826] px-3.5 py-2.75 text-ui-subtle"
		>
			<span class="flex-auto text-[0.9375rem] text-white"
				>Audience Lookalikes</span
			>
			<Icon
				name="arrow-down"
				class="size-4 absolute top-3.25 left-34 text-brand-primary"
			/>
			<Icon name="chevron-down" class="size-4 text-ui-muted" />
		</div>
	</div>

	<!-- Creator Location card -->
	<div class="mt-4 rounded-md bg-[#100e1b] px-3.5 pt-4 pb-4.5">
		<div class="flex items-center justify-between gap-3">
			<span class="text-[0.9375rem] font-medium text-white"
				>Creator Location</span
			>
			<button
				type="button"
				aria-label="Remove Creator Location"
				class="inline-flex cursor-pointer p-0.5 text-ui-muted hover:text-white"
			>
				<Icon name="close" class="size-4" />
			</button>
		</div>
		<div
			data-search-field="region"
			class="mt-3.75 flex items-center gap-1.5 rounded-[0.625rem] bg-[#1a1826] px-3.5 py-2.75 text-ui-subtle"
		>
			<Icon name="search" class="size-4 text-ui-muted" />
			<p class="text-white" data-search-text>India</p>
			<span
				data-search-caret
				class="ml-px inline-block h-4 w-px flex-none bg-white opacity-0"
				aria-hidden="true"></span>
		</div>
		<ul class="mt-3.75 flex list-none flex-wrap gap-2.5 p-0">
			{
				regions.map((region, i) => (
					<li
						data-search-pill={i === regions.length - 1 ? true : undefined}
						class="inline-flex items-center gap-2 rounded-sm border border-brand-primary/45 px-3 py-1.75 text-[0.875rem] font-medium text-brand-primary"
					>
						{region}
						<button
							type="button"
							aria-label={`Remove ${region}`}
							class="inline-flex cursor-pointer text-current"
						>
							<Icon name="close" class="size-3" strokeWidth={1.6} />
						</button>
					</li>
				))
			}
		</ul>
	</div>
</div>
