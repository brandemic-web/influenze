---
/**
 * Audience Affinities UI — tabbed top-five list.
 *
 * Both lists are rendered into one grid cell so the card's height is the taller
 * of the two and swapping between them can't shift the layout. The markup ships
 * in its *settled* state — Brand Affinities, where the beat in
 * `creators-ai/beats/knowAudience.ts` leaves it. That beat rewinds the card to
 * Interests and clicks across, so `SELECTED` is the end of its story rather than
 * the start; change it and the beat's two ends swap with it.
 */
interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;

const AFFINITY_GROUPS = [
	{
		key: "interests",
		label: "Interests",
		items: [
			"Friends, Family & Relationships",
			"Camera & Photography",
			"Clothes, Shoes, Handbags & Accessories",
			"Travel, Tourism & Aviation",
			"Restaurants, Food & Grocery",
		],
	},
	{
		key: "brands",
		label: "Brand Affinities",
		items: [
			"Travelgram",
			"Apple",
			"Royal Enfield",
			"Nikon",
			"National Geographic",
		],
	},
];

/** The group the markup renders as selected. */
const SELECTED = "brands";
---

<div
	data-affinity-ui
	class:list={[
		"w-[18.6875rem] max-w-full rounded-[1rem] bg-[#212529] px-4 pt-3.5 pb-2 font-sans text-white",
		className,
	]}
>
	<span class="text-[0.75rem] font-semibold">Audience Affinities</span>

	<div class="mt-3 flex gap-2.5" role="group" aria-label="Affinity type">
		{
			AFFINITY_GROUPS.map((group) => (
				<button
					type="button"
					data-affinity-tab={group.key}
					aria-pressed={group.key === SELECTED ? "true" : "false"}
					class="affinity-tab cursor-pointer rounded-full px-4 py-2 text-[0.8125rem]"
				>
					{group.label}
				</button>
			))
		}
	</div>

	<div class="mt-3 grid">
		{
			AFFINITY_GROUPS.map((group) => (
				<ol
					data-affinity-list={group.key}
					class:list={[
						"col-start-1 row-start-1 flex list-none flex-col p-0",
						group.key !== SELECTED && "invisible opacity-0",
					]}
				>
					{group.items.map((name, index) => (
						<li class="flex items-center gap-3.5 border-b border-white/8 py-3.5 last:border-b-0">
							<span class="text-[0.75rem] font-semibold text-[#6b7280]">
								#{index + 1}
							</span>
							<span class="text-[0.8125rem] font-semibold">{name}</span>
						</li>
					))}
				</ol>
			))
		}
	</div>
</div>

<style>
	.affinity-tab {
		transition:
			background-color 0.3s ease,
			color 0.3s ease;
	}
	.affinity-tab[aria-pressed="false"] {
		background-color: #2b3033;
		color: #e5e7eb;
		font-weight: 500;
	}
	.affinity-tab[aria-pressed="false"]:hover {
		background-color: #343a3e;
	}
	.affinity-tab[aria-pressed="true"] {
		background-color: #fff;
		color: #111318;
		font-weight: 600;
	}
</style>

<script>
	import "../../scripts/audience-affinities";
</script>
