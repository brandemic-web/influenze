---
import instaIcon from "../../assets/images/common/logos_and_icons/insta_icon.svg";

/**
 * Platform UI — platform picker.
 */
interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
	class:list={[
		"w-92.5 max-w-full rounded-md border border-white/8 bg-[#0b0916] px-3.5 pt-3.5 pb-4 font-sans text-white",
		className,
	]}
>
	<span class="text-[0.8125rem] font-medium text-ui-subtle">Platform</span>

	<div class="mt-2.5 flex gap-2.5" role="group" aria-label="Platform">
		<button
			type="button"
			aria-pressed="true"
			class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-transparent bg-gradient-primary px-2.5 py-2 text-[0.875rem] font-medium text-white">
			<img
				src={instaIcon.src}
				alt=""
				width={instaIcon.width}
				height={instaIcon.height}
				class="size-5"
				loading="lazy"
			/>
			Instagram
		</button>

		<button
			type="button"
			aria-pressed="false"
			class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-white/12 bg-[#161423] px-2.5 py-2 text-[0.875rem] font-medium text-white hover:border-white/24"
		>
			<span
				class="inline-flex size-5 flex-none items-center justify-center rounded-[0.3125rem] bg-white"
			>
				<svg class="size-3.5 flex-none" viewBox="0 0 24 24" aria-hidden="true">
					<rect x="2" y="5.5" width="20" height="13" rx="4" fill="#ff0000"></rect>
					<path d="M10.2 9.2v5.6l4.8-2.8z" fill="#fff"></path>
				</svg>
			</span>
			Youtube
		</button>

		<button
			type="button"
			aria-pressed="false"
			class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-white/12 bg-[#161423] px-2.5 py-2 text-[0.875rem] font-medium text-white hover:border-white/24"
		>
			<span
				class="inline-flex size-5 flex-none items-center justify-center rounded-[0.3125rem] bg-white"
			>
				<svg class="size-3.5 flex-none" viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M13.4 3h2.4c.2 1.9 1.3 3.3 3.2 3.5v2.4c-1.2 0-2.3-.3-3.2-.9v4.9a5.3 5.3 0 1 1-5.3-5.3c.2 0 .5 0 .7.1v2.5a2.9 2.9 0 1 0 2.2 2.8V3Z"
						fill="#010101"></path>
				</svg>
			</span>
			TikTok
		</button>
	</div>
</div>
