---
import { Image } from "astro:assets";
import campaignOne from "../../assets/images/common/logos_and_icons/campaign_profile_1.png";
import campaignTwo from "../../assets/images/common/logos_and_icons/campaign_profile_2.png";
import campaignThree from "../../assets/images/common/logos_and_icons/campaign_profile_3.png";



/**
 * Campaign Card UI — creator collage with a selectable footer.
 */
interface Props {
	/** Campaign name shown under the collage */
	title?: string;
	/** Secondary line, e.g. "last updated 2m ago" */
	meta?: string;
	/** Creators beyond the three tiles; renders as the "+3" tile */
	extraCount?: number;
	/** Renders the footer checkbox as ticked */
	selected?: boolean;
	class?: string;
}

const {
	title = "Zamna Campaign 2026",
	meta = "last updated 2m ago",
	extraCount = 3,
	selected = true,
	class: className = "",
} = Astro.props;
---

<div
	class:list={[
		"w-[16.375rem] max-w-full rounded-[1.25rem] border border-white/8 bg-[#1c1a26] p-3.5 font-sans text-white",
		className,
	]}
>
	<div class="grid grid-cols-2 gap-3">
		{/* placeholder creator tiles — swap for real images later */}
		<span class="aspect-square rounded-[1.25rem] bg-white/10 overflow-hidden"><Image src={campaignOne}  alt=""></Image></span>
		<span class="aspect-square rounded-[1.25rem] bg-white/10 overflow-hidden"><Image src={campaignTwo}  alt=""></Image></span>
		<span class="aspect-square rounded-[1.25rem] bg-white/10 overflow-hidden"><Image src={campaignThree}  alt=""></Image></span>
		<span
			class="flex aspect-square items-center justify-center rounded-[1.25rem] bg-[#221f2e] text-[1.5rem] font-semibold text-ui-violet-link"
		>
			+{extraCount}
		</span>
	</div>

	<div class="mt-4 flex items-end justify-between gap-3">
		<span class="min-w-0">
			<span class="block truncate text-[1.0625rem] font-medium">{title}</span>
			<span class="mt-1.5 block text-[0.75rem] text-ui-muted">{meta}</span>
		</span>

		{
			selected ? (
				<span
					class="inline-flex size-5 flex-none items-center justify-center rounded-[0.375rem] bg-gradient-primary"
					role="img"
					aria-label="Selected"
				>
					<svg class="size-3 flex-none" viewBox="0 0 16 16" aria-hidden="true">
						<path
							d="m3.5 8.5 3 3 6-6.5"
							fill="none"
							stroke="#fff"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</span>
			) : (
				<span class="size-5 flex-none rounded-[0.375rem] border border-white/20" />
			)
		}
	</div>
</div>
