---
import { Image } from "astro:assets";
import Button from "../common/Button.astro";
import { SIGNUP_URL } from "../../data/site";
import { CREATORS_AI_FEATURES, CREATORS_AI_BUTTON } from "../../data/creatorsAI";
import productShot from "../../assets/images/home_page/sign_up/search_global_1.png";
import tabsChip from "../../assets/images/home_page/sign_up/search_global_3.svg";
import metricsChip from "../../assets/images/home_page/sign_up/search_global_2.svg";
import iconSearch from "../../assets/images/common/icons/search.svg";
import iconUsers from "../../assets/images/common/icons/users.svg";
import iconSquareCheck from "../../assets/images/common/icons/square_check_big.svg";
import iconScaling from "../../assets/images/common/icons/scaling.svg";

const featureIcons: Record<string, ImageMetadata> = {
	search: iconSearch,
	users: iconUsers,
	"square-check": iconSquareCheck,
	scaling: iconScaling,
};
---

<section class="relative" aria-labelledby="creators-ai-heading">

	<div
		class="pointer-events-none absolute inset-x-0 top-[-35%] lg:top-[-40%] h-[150%] lg:h-400 bg-[linear-gradient(178.32deg,#010101_1.67%,#21144B_11.9%,#8058FF_43.98%,#251949_75.14%,#000000_98.38%)] z-0"
		aria-hidden="true"
	>
	</div>
	<div class="relative z-10 mx-auto flex w-full max-w-393 flex-col items-center px-4 pb-16 pt-10 lg:pt-12 lg:pb-0">
		<h2
			id="creators-ai-heading"
			class="mb-8 w-full max-w-222.25 text-center text-[30px] lg:text-3xl capitalize leading-[1.2] text-white lg:text-[3.4375rem] lg:leading-[normal] lg:[text-box:trim-both_cap_alphabetic]"
		>
			The world's creators,<br /><span class="text-brand-primary">found with AI</span>
		</h2>

		<!-- outer glass panel -->
		<div class="relative mt-8 flex w-full flex-col items-center gap-8 rounded-[1.75rem] bg-white/10 px-5 pb-8 pt-12 lg:h-199.25 lg:flex-row lg:items-center lg:justify-between lg:py-5.75 lg:pl-[min(148px,8%)] lg:pr-4.75 ">

			<div class="absolute -top-6 left-0 right-0 mx-auto w-max">
				<Button href={SIGNUP_URL} variant="nav">{CREATORS_AI_BUTTON}</Button>
			</div>

			<!-- feature list -->
			<div class="flex w-full min-w-0 flex-col gap-6 lg:max-w-143.75 lg:gap-8" data-reveal data-reveal-stagger="0.12">
				{
					CREATORS_AI_FEATURES.map((feature, i) => (
						<>
						   {i !== 0 && <div class="h-px w-full bg-white/40 lg:max-w-124"></div>}

							<div class="flex flex-col gap-3 lg:max-w-126">
								<div class="flex items-center gap-4">
									<img src={featureIcons[feature.icon].src} alt="" class="h-7.5 w-7.5 rounded-sm lg:h-12 lg:w-12" loading="lazy" />
									<h3 class="text-[18px] lg:text-md capitalize leading-[normal] text-white lg:[text-box:trim-both_cap_alphabetic]">{feature.title}</h3>
								</div>
								<p class="pl-12 text-[14px] lg:text-[1rem] leading-6.5 text-white lg:pl-16.25 lg:[text-box:trim-both_cap_alphabetic]">{feature.description}</p>
							</div>
						</>
					))
				}
			</div>

			<!-- inner panel -->
			<div class="w-full shrink-0 overflow-hidden rounded-[1.25rem] bg-white/20 p-4 lg:h-189.5 lg:w-172.5 lg:overflow-visible lg:p-0 lg:pl-5.5 lg:pt-22">
				<div class="relative w-full lg:w-108.5">
					<Image
						src={productShot}
						alt="Influenze.ai creator search filters — lookalike audience, sort, and location"
						class="w-[75%] rounded-md object-cover object-top lg:h-145.75 lg:w-108.5"
						widths={[434, 868, 1738]}
						sizes="(min-width: 1024px) 434px, 100vw"
						loading="lazy"
					/>

					<!-- floating chips over the screenshot's right edge -->
					<img src={tabsChip.src} alt="" class="absolute left-34 top-18 lg:left-72.75 lg:top-30.25 w-40 lg:w-76.25 " loading="lazy" />
					<img src={metricsChip.src} alt="" class="absolute left-34 top-33 w-40 lg:left-72.75 lg:top-57.75 lg:w-87" loading="lazy" />
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import "../../scripts/reveals";
</script>
