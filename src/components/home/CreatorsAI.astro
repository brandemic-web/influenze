---
import Button from "../common/Button.astro";
import { FEATURES_URL } from "../../data/site";
import { CREATORS_AI_FEATURES, CREATORS_AI_BUTTON } from "../../data/creatorsAI";
import { panelId, tabId } from "../../scripts/creators-ai";
import AnalyzeFilterSidebar from "../app/elements/AnalyzeFilterSidebar.astro";
import PlatformFilter from "../app/elements/PlatformFilter.astro";
import FollowerMetricsFilter from "../app/elements/FollowerMetricsFilter.astro";
import TopDemographics from "../app/elements/TopDemographics.astro";
import FollowerQuality from "../app/elements/FollowerQuality.astro";
import AffinitiesCard from "../app/elements/AffinitiesCard.astro";
import CompareCreatorColumn from "../app/elements/CompareCreatorColumn.astro";
import AddToListDialog from "../app/elements/AddToListDialog.astro";
import AnalyzedCreator from "../app/elements/CreatorDetailPanel.astro";
import DemoCursor from "../app/story/DemoCursor.astro";
import iconSearch from "../../assets/images/common/icons/search.svg";
import iconUsers from "../../assets/images/common/icons/users.svg";
import iconSquareCheck from "../../assets/images/common/icons/square_check_big.svg";
import iconScaling from "../../assets/images/common/icons/scaling.svg";
import shareIcon from "../../assets/images/common/logos_and_icons/share_icon_with_gradient.svg";

const featureIcons: Record<string, ImageMetadata> = {
	search: iconSearch,
	users: iconUsers,
	"square-check": iconSquareCheck,
	scaling: iconScaling,
};

/**
 * The visuals are real UI element components at their design size, laid out on a
 * fixed 668 x 680 px stage (w-167 x h-170) so every panel shares one coordinate
 * space. Below `lg` the whole stage is scaled down as a unit — that keeps the
 * collage's relative positions identical at every breakpoint, and the wrapper
 * heights below mirror stage height x scale.
 *
 * Panel/tab ids come from `scripts/creators-ai` — the same helpers the tab
 * controller and the panel demos use, so the three files can't drift.
 */
---

<section class="relative" aria-labelledby="creators-ai-heading">
	<div
		class="pointer-events-none absolute inset-x-0 top-[-35%] lg:top-[-40%] h-[150%] lg:h-400 bg-[linear-gradient(178.32deg,#010101_1.67%,#21144B_11.9%,#8058FF_43.98%,#251949_75.14%,#000000_98.38%)] z-0"
		aria-hidden="true"
	>
	</div>
	<div
		class="relative z-10 mx-auto flex w-full max-w-393 flex-col items-center px-4 pb-10 pt-10 lg:pt-12 lg:pb-0"
		data-creators-tabs
	>
		<h2
			id="creators-ai-heading"
			class="mb-8 w-full max-w-222.25 text-center text-[1.875rem] lg:text-3xl capitalize leading-[1.2] text-white lg:text-[3.4375rem] lg:leading-[normal] lg:[text-box:trim-both_cap_alphabetic]"
		>
			The world's creators,<br /><span class="text-brand-primary"
				>found with AI</span
			>
		</h2>

		<!-- outer glass panel -->
		<div
			class="relative mt-8 flex w-full flex-col items-center gap-8 rounded-[1.75rem] border border-white/15 bg-white/10 shadow-[0_0.5rem_2rem_rgba(0,0,0,0.18),inset_0_0.0625rem_0_rgba(255,255,255,0.18)] backdrop-blur-md backdrop-saturate-150 px-5 pb-8 pt-12 lg:h-199.25 lg:flex-row lg:items-center lg:justify-between lg:py-5.75 lg:pl-[min(9.25rem,8%)] lg:pr-4.75"
		>
			<div class="absolute -top-6 left-0 right-0 mx-auto w-max">
				<Button href={FEATURES_URL}>{CREATORS_AI_BUTTON}</Button>
			</div>

			<!-- feature list — doubles as the tab list for the visuals on the right -->
			<div
				class="flex w-full min-w-0 flex-col gap-6 lg:max-w-143.75 lg:gap-8"
				role="tablist"
				aria-orientation="vertical"
			>
				{
					CREATORS_AI_FEATURES.map((feature, i) => (
						<>
							{i !== 0 && <div class="h-px w-full bg-white/40 lg:max-w-124" />}

							<button
								type="button"
								id={tabId(i)}
								role="tab"
								aria-controls={panelId(i)}
								aria-selected={i === 0 ? "true" : "false"}
								tabindex={i === 0 ? 0 : -1}
								data-creators-tab
								class="creators-tab flex cursor-pointer flex-col gap-3 text-left lg:max-w-126"
							>
								<span class="flex items-center gap-4">
									<img
										src={featureIcons[feature.icon].src}
										alt=""
										class="h-7.5 w-7.5 rounded-sm lg:h-12 lg:w-12"
										loading="lazy"
									/>
									<span class="text-[1.125rem] lg:text-md capitalize leading-[normal] text-white lg:[text-box:trim-both_cap_alphabetic]">
										{feature.title}
									</span>
								</span>
								<span class="block pl-12 text-[0.875rem] lg:text-xs leading-6.5 text-white lg:pl-16.25 lg:[text-box:trim-both_cap_alphabetic]">
									{feature.description}
								</span>
							</button>
						</>
					))
				}
			</div>

			<div
				class="w-full shrink-0 overflow-hidden rounded-[1.25rem] border border-white/20 bg-white/15 shadow-[inset_0_0.0625rem_0_rgba(255,255,255,0.22)] backdrop-blur-sm p-4 lg:h-189.5 lg:w-172.5 lg:p-0 lg:pl-5.5 lg:pt-22"
			>
				<!-- stage viewport: height tracks the scaled stage at each breakpoint -->
				<div class="relative h-75 w-full sm:h-102 md:h-128 lg:h-170">
					<div
						class="absolute left-0 top-0 h-170 w-167 origin-top-left scale-[0.44] sm:scale-[0.6] md:scale-[0.75] lg:scale-100"
					>
						<!-- Search Globally -->
						<div
							id={panelId(0)}
							role="tabpanel"
							aria-labelledby={tabId(0)}
							data-creators-panel
							class="creators-panel absolute inset-0"
						>
							<!--
								The three cards span ~598 of the stage's 668, so the group is
								nudged right to sit centred. The cursor stays outside it: its
								park position is in stage coordinates, and it reads its targets
								from the DOM at play time, so it follows the shift on its own.
							-->
							<div class="absolute inset-0 translate-x-8.75">
								<!--
									Each card sits in its own untransformed wrapper so the
									intro stagger can own `transform` without clobbering the
									component's own scale.
								-->
								<div data-search-card class="absolute left-0 top-0">
									<AnalyzeFilterSidebar />
								</div>
								<div data-search-card class="absolute left-66 top-30.25">
									<PlatformFilter class="scale-80" />
								</div>
								<div data-search-card class="absolute left-69 top-48.75">
									<FollowerMetricsFilter class="scale-84" />
								</div>
							</div>

							<DemoCursor />
						</div>

						<!-- Know The Audience -->
						<div
							id={panelId(1)}
							role="tabpanel"
							aria-labelledby={tabId(1)}
							aria-hidden="true"
							data-creators-panel
							class="creators-panel absolute inset-0 invisible opacity-0"
						>
							<div data-panel-item class="absolute left-[17%] top-0">
								<TopDemographics />
							</div>
							<!--
								Tops follow the Figma group (688:5097): a 25px gap under the
								tiles, and the affinities card starting ~56% down the follower
								quality card so the two overlap. Figma's own y values can't be
								copied straight across — its placeholders are screenshots of the
								older, taller cards — so the *gaps* are what carry over.
							-->
							<div data-panel-item class="absolute left-0 top-27.5">
								<FollowerQuality />
							</div>
							<div data-panel-item class="absolute left-[47%] top-58">
								<AffinitiesCard />
							</div>

							<DemoCursor />
						</div>

						<!-- Choose The Right Creators -->
						<div
							id={panelId(2)}
							role="tabpanel"
							aria-labelledby={tabId(2)}
							aria-hidden="true"
							data-creators-panel
							class="creators-panel absolute inset-0 invisible opacity-0"
						>
							<!--
								Same as panel 1: the group spans ~613 of the stage's 668 — from
								the list dialog's left edge to the compare panel's right — so it
								is nudged right by half the slack to sit centred.
							-->
							<div class="absolute inset-0 translate-x-6.75">
								<img
									data-panel-item
									src={shareIcon.src}
									alt=""
									class="absolute w-28 right-24.75 top-17.75"
									loading="lazy"
								/>
								<div data-panel-item class="absolute left-[5%] top-38 z-10">
									<CompareCreatorColumn />
								</div>
								<div data-panel-item class="absolute left-0 top-4">
									<AddToListDialog />
								</div>
							</div>
						</div>

						<!-- Scale Campaigns Confidently -->
						<div
							id={panelId(3)}
							role="tabpanel"
							aria-labelledby={tabId(3)}
							aria-hidden="true"
							data-creators-panel
							class="creators-panel absolute inset-0 invisible opacity-0"
						>
							<!--
								The card is the whole panel, so it centres rather than being
								placed by hand. The wrapper owns the intro tween's transform, so
								the scale sits on the card inside it.

								`pb-24` is what makes it look centred in the *well* rather than
								on the stage: the well insets the stage by `pt-22` (88px) and is
								10px shorter than it, so a stage-centred card carries ~121px of
								air above and ~23px below. Centring inside a box shortened by
								twice the difference splits that evenly.
							-->
							<div
								data-panel-item
								class="absolute inset-0 grid place-items-center pb-24"
							>
								<AnalyzedCreator class="scale-120" />
							</div>

							<DemoCursor />
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.creators-tab {
		transition: opacity 0.4s ease;
	}
	.creators-tab[aria-selected="false"] {
		opacity: 0.5;
	}
	.creators-panel {
		contain: layout;
	}
</style>

<script>
	import "../../scripts/reveals";
	import "../../scripts/creators-ai-tabs";
	import "../../scripts/creators-ai-panels";
</script>
