---
/**
 * The hand cursor that drives the workflow story.
 *
 * Deliberately a sibling of the screen layers rather than a child of one: the
 * layers are hidden as the story advances, and this has to survive across them.
 * It lives in stage coordinates so it scales with the canvas, and starts
 * invisible — GSAP owns x/y/scale/opacity from there. See `.wf-pointer` in
 * styles/workflow.css for the fingertip offset, and
 * scripts/home-page/workflow/pointer.ts for the motion.
 */
import handPointing from "../../../../assets/images/common/utils/handpointing.svg";
---

<div class="wf-pointer" data-wf-pointer aria-hidden="true">
	<img src={handPointing.src} alt="" width="32" height="32" />
</div>
