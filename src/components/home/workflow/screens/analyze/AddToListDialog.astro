---
/**
 * The add-to-list dialog, over the creator's media kit.
 *
 * The app as it ships, so the design's ShortLists/Lists switcher is deliberately
 * not here. The backdrop is the frame the dialog is opened from, embedded rather
 * than duplicated, so the two can never drift apart.
 */
import CenteredModalOverlay from "../../common/CenteredModalOverlay.astro";
import CreatorAvatar from "../../common/CreatorAvatar.astro";
import Icon from "../../common/Icon.astro";
import AnalyzedCreator from "./AnalyzedCreator.astro";
import { CREATOR_LISTS, STORY_LIST } from "../../../../../data/workflowMockup";
---

<CenteredModalOverlay width="30rem">
	<AnalyzedCreator tab="mediaKit" slot="backdrop" />

	<span class="flex justify-end pt-4 pr-4">
		<span class="flex" data-wf-modal-close>
			<Icon name="cross" size="1.125rem" class="text-wf-text-muted" />
		</span>
	</span>

	<span class="flex items-center justify-center gap-2 text-[1.375rem] whitespace-nowrap">
		<span class="text-wf-text">Add to List</span>
		<!-- The braces are literal in the app's string. -->
		<span class="text-[#4d4565]">{"{1}"}</span>
	</span>

	<!--
		The app's `SizedBox(height: 16)` sits between the title and the list region —
		see the `mt-4` below. Nothing in between: the ShortLists/Lists switcher is a
		future feature that only exists in the Figma frame.
	-->

	<!-- List region: maxHeight 220, so a third row is only partly visible. -->
	<div class="mt-4 h-55 overflow-hidden px-6 pb-2">
		<div class="flex flex-col gap-2">
			{
				CREATOR_LISTS.map((list) => (
					<div
						class="flex items-center rounded-[1rem] border border-[#3b3b62] bg-[#2e2e4e] px-3 py-2.5"
						data-wf-list-target={list.name === STORY_LIST ? "" : undefined}
					>
						<span class="grid size-15 shrink-0 grid-cols-2 content-start">
							{list.preview.map((handle) => (
								<CreatorAvatar size="1.625rem" radius="0.4375rem" handle={handle} class="m-0.5 block bg-wf-surface" />
							))}
						</span>
						<span class="ml-3 flex min-w-0 flex-1 flex-col">
							<span class="mb-3 text-[0.875rem] whitespace-nowrap text-wf-text">{list.name}</span>
							<span class="text-[0.625rem] whitespace-nowrap text-wf-meta">{list.count} Creators</span>
						</span>
						<span
							class="ml-3 grid h-9 min-w-16 shrink-0 place-items-center rounded-[1.25rem] bg-wf-action px-3 text-[0.625rem] text-wf-text"
							data-wf-add
						>
							<span class="wf-untrimmed col-start-1 row-start-1" data-wf-add-label="idle">
								Add
							</span>
							<span class="wf-untrimmed col-start-1 row-start-1 opacity-0" data-wf-add-label="done">
								Added
							</span>
						</span>
					</div>
				))
			}
		</div>
	</div>

	<span class="mt-4 block h-px w-full bg-[#463c60]"></span>

	<span class="mt-3.5 mb-8 flex justify-center">
		<span class="flex h-9 min-w-16 items-center gap-1 rounded-[1.5rem] bg-wf-action px-4 text-[0.625rem] font-medium text-wf-text">
			<Icon name="addToList" size="0.625rem" />
			Create New List
		</span>
	</span>
</CenteredModalOverlay>
