---
/**
 * My Lists.
 *
 * Frame: `padding 50` → panel `#232339` radius 12 → `padding 40`,
 * giving 1228 of content at 1440. Grid is `clamp(floor(w / 240), 1, 4)` columns,
 * so four across at this width, with `cardHeight = cardWidth + 94`.
 *
 * The centred "My Lists" heading and the rule under it are the app's; the
 * design's ShortLists/Lists tabs are a future feature and deliberately absent.
 */
import AppShell from "../../common/AppShell.astro";
import CreatorAvatar from "../../common/CreatorAvatar.astro";
import Icon from "../../common/Icon.astro";
import PlatformIcon from "../../common/PlatformIcon.astro";
import ToolbarAction from "./widgets/ToolbarAction.astro";
import { CREATOR_LISTS, STORY_LIST } from "../../../../../data/workflowMockup";

/** Squircle tiles: the app clips a custom path; 32% is the closest CSS match. */
const tileClass = "block size-[7.40625rem] border border-[#463c60] bg-wf-chip";
const tileStyle = "border-radius:32%";
---

<AppShell active="lists">
	<div class="absolute top-32.5 left-16.5 h-176 w-327 overflow-hidden rounded-md bg-wf-panel">
		<div class="flex h-full flex-col p-10">
			<p class="text-center text-md font-light text-wf-text">My Lists</p>

			<!--
				The app's `Divider(lavender11, height: 1)` under the heading, with its 20
				above and 24 below. The design's ShortLists/Lists tabs sat on this rule,
				but they are a future feature, so only the rule is here.
			-->
			<span class="mt-5 block h-px w-full bg-wf-rule"></span>

			<div class="mt-6 flex items-center">
				<!-- Search is 30% of the window, and carries no leading icon. -->
				<div class="flex h-16.25 w-27 items-center rounded-md bg-wf-search px-6" style="width:27rem">
					<span class="text-[0.875rem] font-medium whitespace-nowrap">
						<span class="text-wf-text-muted">Search&nbsp;&nbsp;</span><span class="text-wf-green">Lists</span>
					</span>
				</div>

				<div class="ml-2 flex h-14 w-18 shrink-0 items-center justify-center gap-1 rounded-md bg-wf-search p-2">
					<PlatformIcon platform="instagram" tile="2.5rem" glyph="1.5rem" radius="0.5rem" />
					<Icon name="arrowIcon" size="0.75rem" class="text-wf-text-soft" />
				</div>

				<!--
					Import ends the row. Its separator, Cancel and Delete List are one
					widget in the app — `ListsDeleteButton` — and it collapses to nothing
					while no list is selected, which is how this frame sits.
				-->
				<ToolbarAction label="Import" icon="import" class="ml-auto" />
			</div>

			<div class="mt-8 flex min-h-0 flex-1 gap-4 overflow-hidden">
				{
					CREATOR_LISTS.map((list) => (
						<article
						class="flex h-97.25 w-73.75 shrink-0 flex-col rounded-[1.5rem] border border-[#2a2634] bg-wf-surface p-4"
						data-wf-list-target={list.name === STORY_LIST ? "" : undefined}
					>
							<div class="grid size-65.75 shrink-0 grid-cols-2 gap-2.5 p-2">
								{list.preview.slice(0, 3).map((handle) => (
									<CreatorAvatar size="7.40625rem" radius="32%" handle={handle} class="border border-[#463c60] bg-wf-chip" />
								))}
								<span class={`${tileClass} grid place-items-center`} style={tileStyle}>
									<span class="text-md font-medium text-[#6c5ba1]">+{list.count - 3}</span>
								</span>
							</div>

							<p class="mt-3.5 px-1.5 py-3 text-[1rem] font-medium whitespace-nowrap text-wf-text">{list.name}</p>
							<div class="mt-1 flex items-end justify-between px-1.5">
								<span class="text-[0.625rem] whitespace-nowrap text-wf-meta">{list.updated}</span>
								{/* `SelectionIndicator` unselected: transparent, a lavender14 border, no mark. */}
								<span class="size-4 rounded-xs border-[0.083rem] border-wf-control-border" />
							</div>
						</article>
					))
				}
			</div>
		</div>
	</div>
</AppShell>
