---
/**
 * Platform mark on its brand tile — the app's `platformIconData`: a rounded tile
 * filled with the platform's brand background, holding the glyph inset by the
 * tile's padding. Icons are the app's own assets.
 */
import instagram from "../../../../assets/icons/workflow/platform/instagram.svg";
import youtube from "../../../../assets/icons/workflow/platform/youtube.svg";
import tiktok from "../../../../assets/icons/workflow/platform/tiktok.svg";
import linkedin from "../../../../assets/icons/workflow/platform/linkedin.svg";

export type Platform = "instagram" | "youtube" | "tiktok" | "linkedin";

interface Props {
	platform?: Platform;
	/** Outer tile size, in rem. */
	tile?: string;
	/** Glyph size, in rem — the app insets it by the tile's padding. */
	glyph?: string;
	radius?: string;
	class?: string;
}

const { platform = "instagram", tile = "1.25rem", glyph = "0.625rem", radius = "0.25rem", class: className = "" } =
	Astro.props;

/** Brand tile fills, per `PlatformOption.iconBgColor`. */
const marks = {
	instagram: { src: instagram.src, bg: "#000000" },
	youtube: { src: youtube.src, bg: "#ffffff" },
	tiktok: { src: tiktok.src, bg: "#000000" },
	linkedin: { src: linkedin.src, bg: "#ffffff" },
} as const;

const mark = marks[platform];
---

<span
	data-wf-logo
	class={`grid shrink-0 place-items-center ${className}`}
	style={`width:${tile};height:${tile};border-radius:${radius};background:${mark.bg}`}
>
	<img src={mark.src} alt="" style={`width:${glyph};height:${glyph}`} class="object-contain" />
</span>
