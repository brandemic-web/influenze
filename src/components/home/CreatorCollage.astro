---
import { Image } from "astro:assets";
import bolt from "../../assets/images/common/decor/green_bolt.png";
import glowBand from "../../assets/images/home_page/choose_creators/glow_band.svg";
import plusButton from "../../assets/images/common/logos_and_icons/plus_icon_with_gradient.svg";
import bubbleA from "../../assets/images/home_page/choose_creators/bubble_image_one.png";
import bubbleB from "../../assets/images/home_page/choose_creators/bubble_image_two.png";
import bubbleC from "../../assets/images/home_page/choose_creators/bubble_image_three.png";
import bubbleD from "../../assets/images/home_page/choose_creators/bubble_image_four.png";
import bubbleE from "../../assets/images/home_page/choose_creators/bubble_image_five.png";
import bubbleF from "../../assets/images/home_page/choose_creators/bubble_image_six.png";
import bubbleG from "../../assets/images/home_page/choose_creators/bubble_image_seven.png";
import addedToZaamna from "../../assets/images/home_page/choose_creators/added_to_zaamna.png";
import addedToNykaa from "../../assets/images/home_page/choose_creators/added_to_nykaa.png";
import StatTag from "./StatTag.astro";

// Every bubble paints at 18–30% of the viewport on mobile and 9.5–12.8% from lg
// up, so the ~850px sources were roughly eight times the pixels any of them draws.
// These widths cover both breakpoints to 3x DPR; `sizes` is what lets the browser
// pick one, and it has to be given alongside `widths` for Astro to emit a srcset.
const BUBBLE_WIDTHS = [140, 260, 460];
const BUBBLE_SIZES = "(min-width: 1024px) 13vw, 30vw";
---

<section
	class="relative mt-64 h-100 lg:-mt-3.5 lg:h-280"
	aria-label="Discover and analyze winning creators"
	data-collage
>
	<div class="pointer-events-none absolute top-0 left-1/2 flex h-full w-full -translate-x-1/2 lg:items-center lg:justify-center">
		<img
			src={glowBand.src}
			alt=""
			class="absolute bottom-12 w-full object-cover lg:top-auto lg:-bottom-110"
			loading="lazy"
		/>

		<h2
			class="relative z-4 w-186.25 text-center text-[1.875rem] leading-10 text-white lg:text-9xl lg:leading-20 capitalize"
			data-collage-reveal
		>
			Discover &amp; Analyze<br />
			<span class="text-brand-primary">winning creators</span>
		</h2>

		<Image
			src={bolt}
			alt=""
			class="absolute z-2 top-[-40%] left-0 right-0 mx-auto w-[25%] lg:top-[34%] lg:right-[15.45%] lg:left-auto lg:mx-0 lg:w-[18.34%]"
			widths={[317, 634]}
			sizes="18.34vw"
			loading="lazy"
			data-collage-reveal
		/>

		<!--
			The bubbles live in their own layer so the intro can rotate all seven as
			one ring (see scripts/home-page/creatorCollage.ts). `inset-0` makes this
			box identical to its parent, so the bubbles' percentage offsets resolve
			exactly as they did when they were direct children.
		-->
		<div class="absolute inset-0 xl:overflow-x-hidden" data-orbit>
			<!-- Bubble + its stat tag travel together on the wrapper. -->
			<div
				class="absolute top-[-30%] right-[2%] w-[28%] lg:top-[34%] lg:left-[-1.5%] lg:right-auto lg:w-[12%]"
				data-bubble
			>
				<Image
					src={bubbleA}
					alt=""
					class="w-full"
					loading="lazy"
					widths={BUBBLE_WIDTHS}
					sizes={BUBBLE_SIZES}
				/>
				<StatTag
					label="Engagement Rate"
					value="2.5%"
					class="top-[75%] right-[61%] lg:top-[-1%] lg:right-auto lg:left-[65%]"
				/>
			</div>

			<Image
				src={bubbleB}
				alt=""
				class="absolute top-[-26%] left-[-5%] w-[25%] lg:top-[43%] lg:left-[12%] lg:w-[10.5%]"
				loading="lazy"
				data-bubble
				widths={BUBBLE_WIDTHS}
				sizes={BUBBLE_SIZES}
			/>

			<!-- Bubble + its list pill travel together on the wrapper. -->
			<div
				class="absolute top-[25%] left-[-3%] w-[30%] lg:top-auto lg:bottom-[25%] lg:left-[22%] lg:w-[12.56%]"
				data-bubble
			>
				<Image
					src={bubbleC}
					alt=""
					class="w-full"
					loading="lazy"
					widths={BUBBLE_WIDTHS}
					sizes={BUBBLE_SIZES}
				/>
				<Image
					src={addedToZaamna}
					alt="Added to Zaamna list"
					class="absolute z-1 top-0 right-[-70%] w-[63.1%] lg:top-[56%] lg:left-[-72.8%] lg:right-auto"
					loading="lazy"
					data-bubble-tag
				/>
				<img
					src={plusButton.src}
					alt=""
					class="absolute top-[15%] right-[-14%] w-[35%] lg:top-[71.9%] lg:left-[-17.5%] lg:right-auto"
					loading="lazy"
					data-bubble-tag
				/>
				<StatTag
					label="Followers"
					value="156K"
					class="top-[83%] left-[34%] lg:top-[24%] lg:right-[85%] lg:left-auto"
				/>
			</div>

			<Image
				src={bubbleE}
				alt=""
				class="absolute top-[33%] right-[3%] w-[23%] lg:top-auto lg:right-[29.05%] lg:bottom-[24%] lg:w-[11.23%]"
				loading="lazy"
				data-bubble
				widths={BUBBLE_WIDTHS}
				sizes={BUBBLE_SIZES}
			/>

			<div
				class="absolute top-[-45%] left-[28%] w-[18%] lg:top-[33%] lg:right-[13.95%] lg:left-auto lg:w-[9.9%]"
				data-bubble
			>
				<Image
					src={bubbleF}
					alt=""
					class="w-full"
					loading="lazy"
					widths={BUBBLE_WIDTHS}
					sizes={BUBBLE_SIZES}
				/>
				<Image
					src={addedToNykaa}
					alt="Added to Nykaa list"
					class="absolute z-1 top-[-33.9%] left-[90.6%] w-[70.8%]"
					loading="lazy"
					data-bubble-tag
				/>
				<img
					src={plusButton.src}
					alt=""
					class="absolute top-[-13.2%] left-[63.7%] w-[44.4%]"
					loading="lazy"
					data-bubble-tag
				/>
				<StatTag
					label="Avg Likes"
					value="21.4K"
					class="top-[-16%] left-[-88%] lg:top-0 lg:right-[70%] lg:left-auto"
				/>
			</div>

			<Image
				src={bubbleD}
				alt=""
				class="absolute top-[38%] right-[35%] w-[25%] lg:top-auto lg:right-[44%] lg:bottom-[18.74%] lg:w-[12.79%]"
				loading="lazy"
				data-bubble
				widths={BUBBLE_WIDTHS}
				sizes={BUBBLE_SIZES}
			/>

			<Image
				src={bubbleG}
				alt=""
				class="absolute top-[-45%] right-[17%] w-[20%] lg:top-[52%] lg:right-0 lg:w-[9.49%]"
				loading="lazy"
				data-bubble
				widths={BUBBLE_WIDTHS}
				sizes={BUBBLE_SIZES}
			/>
		</div>
	</div>
</section>

<style>
	/*
		Bubbles start hidden so they can't flash at their final spots before the
		intro runs. Only when motion is welcome and JS can take over — a
		reduced-motion visitor, or one with scripting off (see <noscript>), keeps
		the static collage.
	*/
	@media (prefers-reduced-motion: no-preference) {
		[data-bubble],
		[data-bubble-tag],
		[data-collage-reveal] {
			opacity: 0;
		}
	}
</style>

<noscript>
	<style>
		[data-bubble],
		[data-bubble-tag],
		[data-collage-reveal] {
			opacity: 1 !important;
		}
	</style>
</noscript>

<script>
	import { initCreatorCollage } from "../../scripts/home-page/creatorCollage";

	initCreatorCollage();
</script>