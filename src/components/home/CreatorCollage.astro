---
import { Image } from "astro:assets";
import bolt from "../../assets/images/common/decor/green_bolt.png";
import glowBand from "../../assets/images/home_page/choose_creators/glow_band.svg";
import plusButton from "../../assets/images/common/logos_and_icons/plus_icon_with_gradient.svg";
import bubbleA from "../../assets/images/home_page/choose_creators/bubble_image_one.png";
import bubbleB from "../../assets/images/home_page/choose_creators/bubble_image_two.png";
import bubbleC from "../../assets/images/home_page/choose_creators/bubble_image_three.png";
import bubbleD from "../../assets/images/home_page/choose_creators/bubble_image_four.png";
import bubbleE from "../../assets/images/home_page/choose_creators/bubble_image_five.png";
import bubbleF from "../../assets/images/home_page/choose_creators/bubble_image_six.png";
import bubbleG from "../../assets/images/home_page/choose_creators/bubble_image_seven.png";
import addedToZaamna from "../../assets/images/home_page/choose_creators/added_to_zaamna.png";
import addedToNykaa from "../../assets/images/home_page/choose_creators/added_to_nykaa.png";
---

<section class="relative lg:-mt-3.5 lg:h-280" aria-label="Choose creators based on your preferences">
	<div class="pointer-events-none absolute top-0 left-1/2 hidden h-full w-full -translate-x-1/2 lg:flex lg:items-center lg:justify-center">
		<img
			src={glowBand.src}
			alt=""
			class="absolute -bottom-110 w-full object-cover"
			loading="lazy"
		/>

		<h2 class="relative z-4 w-186.25 text-center text-[4rem] capitalize leading-20 text-white">
			Choose creators based<br />on <span class="text-brand-primary">your preferences</span>
		</h2>
		
		<Image src={bolt} alt="" class="absolute z-2 top-[34%] right-[15.45%] w-[18.34%]" widths={[317, 634]} sizes="18.34vw" loading="lazy" />
		<Image src={bubbleA} alt="" class="absolute top-[34%] left-[-1.5%] w-[12%]" loading="lazy" />
		<Image src={bubbleB} alt="" class="absolute top-[43%] left-[12%] w-[10.5%] " loading="lazy" />
		<div class="absolute bottom-[25%] left-[22%] w-[12.56%]">
			<Image src={bubbleC} alt="" class="w-full" loading="lazy" />
			<Image src={addedToZaamna} alt="Added to Zaamna list" class="absolute z-1 top-[48%] left-[-72.8%] w-[63.1%]" loading="lazy" />
			<img src={plusButton.src} alt="" class="absolute top-[57.9%] left-[-17.5%] w-[35%]" loading="lazy" />
		</div>
		<Image src={bubbleE} alt="" class="absolute right-[29.05%] bottom-[24%] w-[11.23%]" loading="lazy" />
		<div class="absolute top-[33%] right-[13.95%] w-[9.9%]">
			<Image src={bubbleF} alt="" class="w-full" loading="lazy" />
			<Image src={addedToNykaa} alt="Added to Nykaa list" class="absolute z-1 top-[-33.9%] left-[90.6%] w-[70.8%]" loading="lazy" />
			<img src={plusButton.src} alt="" class="absolute top-[-13.2%] left-[63.7%] w-[44.4%]" loading="lazy" />
		</div>
		<Image src={bubbleD} alt="" class="absolute right-[44%] bottom-[18.74%] w-[12.79%]" loading="lazy" />
		<Image src={bubbleG} alt="" class="absolute top-[52%] right-0 w-[9.49%]" loading="lazy" />
	</div>

	<!-- mobile / tablet fallback: heading over the glow -->
	<div class="relative flex items-center justify-center overflow-hidden py-30 lg:hidden">
		<img
			src={glowBand.src}
			alt=""
			class="pointer-events-none absolute top-1/2 left-1/2 w-300 max-w-none -translate-x-1/2 -translate-y-1/2"
			loading="lazy"
		/>
		<h2 class="relative max-w-160 px-6 text-center text-3xl capitalize leading-[1.2] text-white">
			Choose creators based on <span class="text-brand-primary">your preferences</span>
		</h2>
	</div>
</section>
