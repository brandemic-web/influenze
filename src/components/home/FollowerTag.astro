---
/**
 * "Followers · 31.6K" pill that sits beside a creator bubble in the collage.
 *
 * Live text rather than an image export, so the counts stay crisp at any zoom
 * and are editable in CreatorCollage.astro. Styling is matched to the design by
 * eye — the Figma connector was unavailable when this was built, so the fill,
 * radius and type sizes are approximations worth checking against the file.
 *
 * Position with `class`, using offsets relative to the bubble wrapper.
 * `data-bubble-tag` opts it into the collage intro, fading in with the list
 * pills once its bubble has landed.
 */
interface Props {
	/** Follower count as shown, e.g. "31.6K". */
	count: string;
	class?: string;
}

const { count, class: className = "" } = Astro.props;
---

<div
	class:list={[
		"absolute z-2 flex items-center gap-3 rounded-xs bg-purple-soft px-1.5 py-2 whitespace-nowrap shadow-[0_8px_24px_-8px_rgba(0,0,0,0.45)] lg:gap-6 lg:rounded-sm lg:px-3 lg:py-3.5",
		className,
	]}
	data-bubble-tag
>
	<!--
		The divider is positioned against the label rather than the pill, so it
		always sits just past "Followers" regardless of how wide the count is.
		Its `ml` is half the flex `gap`, which centres it between the two.
	-->
	<span
		class="relative text-[0.375rem] leading-none font-medium text-purple-ink lg:text-[0.5rem]"
	>
		Followers
		<span
			class="absolute top-1/2 left-full ml-1.5 h-4.5 w-px -translate-y-1/2 bg-[#5140A5] lg:ml-3 lg:h-9.5"
		></span>
	</span>
	<span
		class="text-[0.875rem] leading-none font-semibold text-[#3B2E7E] lg:text-[1.8125rem]"
		>{count}</span
	>
</div>
