---
import { Image } from "astro:assets";
import SectionHeading from "../common/SectionHeading.astro";
import { FEATURE_TABS, FEATURE_TABS_PANEL } from "../../data/featureTabs";

import bubblesTrio from "../../assets/images/home_page/featured_tabs/discover_and_analyze_image.png";
import handleChip from "../../assets/images/home_page/featured_tabs/hamidbarkzi07_handle.svg";
import accountStats from "../../assets/images/common/ui_images/accounts_stats.svg";
import likesGraph from "../../assets/images/common/ui_images/avg_likes_graph.svg";
import filtersPanel from "../../assets/images/common/ui_images/creator_filters_panel.png";
import zamnaList from "../../assets/images/home_page/featured_tabs/zamna_campaign_list.png";
import sharePopup from "../../assets/images/common/ui_images/share_email_popup.png";
---

<section
	class="relative overflow-hidden bg-[radial-gradient(90%_90%_at_50%_35%,#A58DFA_0%,#7D55EC_35%,#3D2496_70%,#010101_100%)] py-24 lg:py-[140px]"
	aria-labelledby="feature-tabs-heading"
>
	<SectionHeading
		segments={[{ text: "Features that ", accent: true }, { text: "you get hooked to" }]}
		class="mx-auto max-w-[947px] px-6"
	/>
	<span id="feature-tabs-heading" class="sr-only">Features that you get hooked to</span>

	<div class="relative mx-auto mt-16 max-w-[1572px] px-4 lg:mt-[120px] lg:px-0">
		<!-- tab pills straddling the panel top edge -->
		<div
			class="absolute -top-[30px] left-1/2 z-10 flex w-max -translate-x-1/2 items-center gap-[7px] rounded-[43px] border border-[#DCDCCD] bg-[#F6F6F4] p-1"
			role="tablist"
			aria-label="Feature tabs"
		>
			{
				FEATURE_TABS.map((tab, i) => (
					<button
						type="button"
						role="tab"
						id={`tab-${tab.id}`}
						aria-controls={`panel-${tab.id}`}
						aria-selected={i === 0 ? "true" : "false"}
						class="rounded-full px-4 py-3 text-xs whitespace-nowrap text-[#0D091E]/30 transition-colors aria-selected:border aria-selected:border-brand-primary aria-selected:bg-surface-pill aria-selected:font-medium aria-selected:text-white lg:px-[22px] lg:py-[20px]"
					>
						{tab.label}
					</button>
				))
			}
		</div>

		<div class="rounded-[28px] bg-white/10 px-6 pt-20 pb-10 backdrop-blur-[2px] lg:min-h-[670px] lg:px-[107px] lg:pt-[120px] lg:pb-[60px]">
			<div class="flex flex-col gap-12 lg:flex-row lg:items-start lg:gap-16">
				<div class="lg:max-w-[700px] lg:shrink-0 lg:basis-[47%]">
					<h3 class="text-5xl capitalize leading-[normal] text-white max-md:text-2xl lg:text-[55px]">
						{FEATURE_TABS_PANEL.heading}
					</h3>
					<ul class="mt-12 flex flex-col gap-9">
						{
							FEATURE_TABS_PANEL.points.map((point) => (
								<li class="max-w-[444px] border-l border-white pl-5 text-xs leading-[26px] text-white">
									{point}
								</li>
							))
						}
					</ul>
					<a
						href="#"
						class="mt-14 inline-flex items-center justify-center rounded-full border border-white px-[30px] py-[17px] text-xs leading-none text-white transition-colors hover:bg-white/10"
					>
						{FEATURE_TABS_PANEL.buttonLabel}
					</a>
				</div>

				<div class="relative flex-1 rounded-[20px] bg-white/20 p-5 lg:-mt-10 lg:min-h-[630px]">
					<!-- Discover & Analyze -->
					<div id="panel-discover" role="tabpanel" aria-labelledby="tab-discover">
						<div class="relative z-10 -mt-12 flex justify-center lg:-mt-16">
							<Image src={bubblesTrio} alt="" class="w-[372px] max-w-full" loading="lazy" />
						</div>
						<img src={handleChip.src} alt="@hamidbarkzi07" class="absolute top-[100px] right-6 hidden w-[200px] lg:block" loading="lazy" />
						<div class="mt-6 flex flex-wrap items-start justify-center gap-5">
							<div class="flex w-[338px] max-w-full flex-col gap-4">
								<img src={accountStats.src} alt="Account stats" class="w-full" loading="lazy" />
								<img src={likesGraph.src} alt="Average likes growth graph" class="w-full" loading="lazy" />
							</div>
							<Image src={filtersPanel} alt="Creator filters panel" class="w-[284px] max-w-full" loading="lazy" />
						</div>
					</div>
					<!-- My Lists -->
					<div id="panel-lists" role="tabpanel" aria-labelledby="tab-lists" hidden class="items-center justify-center lg:flex lg:h-full">
						<Image src={zamnaList} alt="Campaign creator list" class="w-full rounded-[12px]" loading="lazy" />
					</div>
					<!-- Share -->
					<div id="panel-share" role="tabpanel" aria-labelledby="tab-share" hidden class="items-center justify-center lg:flex lg:h-full">
						<Image src={sharePopup} alt="Share via email popup" class="w-full max-w-[560px] rounded-[12px]" loading="lazy" />
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('[role="tab"][id^="tab-"]');
	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			tabs.forEach((t) => {
				t.setAttribute("aria-selected", String(t === tab));
				const panel = document.getElementById(t.getAttribute("aria-controls")!);
				if (panel) panel.hidden = t !== tab;
			});
		});
	});
</script>
