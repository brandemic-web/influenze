---
/**
 * "How Influenze Compares" — comparison grid against three competitors.
 *
 * Built as one CSS grid so every column stays aligned: five tracks sized off the
 * design (label 398, Influenze 262, competitors 250 each, within a 1455 frame).
 * The raised Influenze column is a grid item spanning every row in column 2,
 * with negative block margins so it overhangs the table card the way the design
 * draws it.
 *
 * Below `lg` the grid keeps its shape and scrolls sideways: every track is sized
 * to `(100vw - 3rem) / 2.5`, so two and a half columns sit in view at any phone
 * width and the half-column signals there is more to scroll to.
 */
import { Image } from "astro:assets";
import logo from "../../assets/images/common/logos_and_icons/influenze_logo_nav.svg";
import glowBand from "../../assets/images/home_page/compare_table/glow_band.svg";
import {
	COMPARISON_HEADING,
	COMPARISON_SUBCOPY,
	COMPARISON_COMPETITORS,
	COMPARISON_ROWS,
} from "../../data/comparison";

const rowCount = COMPARISON_ROWS.length;
---

<section
	class="relative overflow-hidden pt-5 pb-15 lg:pt-0 lg:pb-40"
	aria-labelledby="comparison-heading"
>
	<!--
		Blurred purple band from the design, centred on the section's vertical axis
		and clipped by its `overflow-hidden`. The SVG is 1728×744, i.e. the design
		canvas width, so `w-full` keeps its proportions at every viewport.
	-->
	<img
		src={glowBand.src}
		alt=""
		class="pointer-events-none absolute inset-x-0 top-1/2 hidden h-[58%] w-full -translate-y-1/2 object-cover opacity-80 lg:block"
		loading="lazy"
	/>

	<div class="relative z-2 flex flex-col items-center px-6 text-center">
		<h2
			id="comparison-heading"
			class="text-[1.875rem] capitalize leading-[1.15] text-white lg:text-[4rem]"
		>
			{COMPARISON_HEADING.lead}<span class="text-brand-primary"
				>{COMPARISON_HEADING.accent}</span
			>
		</h2>
		<p
			class="mt-5 max-w-105 text-[0.75rem] leading-4.5 text-tertiary lg:mt-7 lg:text-[1.125rem] lg:leading-6.5"
		>
			{COMPARISON_SUBCOPY}
		</p>
	</div>

	<!--
		Sideways scroll below lg; centred and full-width from lg up.

		`overflow-x: auto` also clips the block axis (CSS computes the other axis'
		`visible` to `auto`), which would cut the raised Influenze column's
		overhang. So the scroller carries `py-8` to hold the overhang and cancels
		it again with `-mb-8` plus a reduced `mt`, leaving the outer spacing as it
		was. From lg up the scroller is `overflow-visible`, so none of that applies.
	-->
	<div class="relative z-2 mt-6 overflow-x-auto overscroll-x-contain px-6 py-8 -mb-8 lg:mt-20 lg:mb-0 lg:overflow-visible lg:py-0">
		<div
			class="mx-auto grid w-max max-w-363.75 grid-cols-[repeat(5,calc((100vw-3rem)/2.5))] items-stretch rounded-[1.25rem] border border-[#ffffff52] bg-white/2 lg:w-auto lg:grid-cols-[1.59fr_1.05fr_1fr_1fr_1fr]"
			role="table"
			aria-label="Influenze compared with Qoruz, Upfluence and Culture X"
		>
			<!--
				Raised Influenze column. Spans header + every row, and sits behind the
				cells so their text stays legible.
			-->
			<div
				class="col-start-2 row-start-1 -my-6 rounded-[1.25rem] border border-[#ffffff52] bg-[linear-gradient(180deg,rgba(10,7,24,0.3)_0%,rgba(10,7,24,0.06)_100%)] backdrop-blur-md shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_24px_60px_-20px_rgba(0,0,0,0.6)] lg:-my-8"
				style={`grid-row-end: ${rowCount + 2}`}
				aria-hidden="true"
			>
			</div>

			<!-- ── Header row ─────────────────────────────────────────── -->
			<div class="col-start-1 row-start-1"></div>

			<div
				class="relative z-2 col-start-2 row-start-1 flex items-center justify-center px-4 py-8 lg:py-10"
			>
				<Image src={logo} alt="influenze.ai" class="h-6 w-auto lg:h-12" loading="lazy" />
			</div>

			{
				COMPARISON_COMPETITORS.map((name, i) => (
					<div
						class="relative z-2 flex items-center justify-center px-4 py-8 lg:py-10"
						style={`grid-column: ${i + 3}; grid-row: 1`}
						role="columnheader"
					>
						<span class="text-[1.125rem] text-white lg:text-md">{name}</span>
					</div>
				))
			}

			<!-- ── Rows ───────────────────────────────────────────────── -->
			{
				COMPARISON_ROWS.map((row, r) => {
					const line = "border-t border-[#ffffff52]";
					return (
						<>
							<div
								class:list={[
									"relative z-2 flex items-center px-4 py-5 text-left lg:px-13.5 lg:py-6",
									line,
								]}
								style={`grid-column: 1; grid-row: ${r + 2}`}
								role="rowheader"
							>
								<span class="text-[0.75rem] capitalize leading-4.5 text-white lg:text-[1.125rem] lg:leading-6.5">
									{row.label}
								</span>
							</div>

							<div
								class="relative z-2 flex flex-col items-center justify-center gap-2.5 px-3 py-5 text-center lg:px-5 lg:py-6"
								style={`grid-column: 2; grid-row: ${r + 2}`}
								role="cell"
							>
								{row.influenze.mark && (
									<svg
										class="size-6 shrink-0 text-brand-primary"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-label="Included"
										role="img"
									>
										<circle cx="12" cy="12" r="10" />
										<path d="m9 12 2 2 4-4" />
									</svg>
								)}
								{(row.influenze.accent || row.influenze.text) && (
									<span class="text-[0.75rem] capitalize leading-4.5 text-white lg:text-[1.125rem] lg:leading-6.5">
										{row.influenze.accent && (
											<span class="text-brand-primary">{row.influenze.accent} </span>
										)}
										{row.influenze.text}
									</span>
								)}
							</div>

							{row.others.map((cell, c) => (
								<div
									class:list={[
										"relative z-2 flex flex-col items-center justify-center gap-2.5 px-3 py-5 text-center lg:px-5 lg:py-6",
										line,
									]}
									style={`grid-column: ${c + 3}; grid-row: ${r + 2}`}
									role="cell"
								>
									{cell.mark && (
										<svg
											class="size-6 shrink-0 text-white/35"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											aria-label="Not included"
											role="img"
										>
											<path d="M5 12h14" />
										</svg>
									)}
									{cell.text && (
										// A caption under a dash explains what they do instead, so it is
										// dimmed; a plain value stands at full strength.
										<span
											class:list={[
												"text-[0.75rem] capitalize leading-4 text-white lg:text-[1rem] lg:leading-6",
												cell.mark && "opacity-60",
											]}
										>
											{cell.text}
										</span>
									)}
								</div>
							))}
						</>
					);
				})
			}
		</div>
	</div>
</section>
