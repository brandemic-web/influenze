---
import { APP_URL } from "../../data/site";
import { HERO_WORDS } from "../../data/heroWords";
import Button from "../common/Button.astro";
import WorkflowMockup from "../app/WorkflowMockup.astro";
import backgroundArcs from "../../assets/images/home_page/hero/bg_svg_lines_hero.svg";
import darkLayerSide from "../../assets/images/home_page/hero/dark_layer_side.svg";
import darkLayerCenter from "../../assets/images/home_page/hero/dark_layer_center.svg";
---

<section class="relative h-auto mb-2 lg:mb-auto lg:h-344 overflow-x-hidden lg:overflow-visible">
	{/* gradient backdrop*/}
	<div
		class="pointer-events-none absolute h-full inset-x-0 top-0 lg:h-full bg-[linear-gradient(179.95deg,#11092B_0%,#6838FF_5.85%,#010101_99.94%)]"
		aria-hidden="true"
	>
	</div>

	{/* decorative concentric arcs, centered on the 1728 design canvas */}
	<div
		class="pointer-events-none absolute top-18 left-1/2 w-full -translate-x-1/2 lg:block lg:top-36"
		aria-hidden="true"
	>
		{/*
			zoomed/cropped on mobile so the arcs read at small widths, natural width from lg up

			Decorative, but it measures as the page's LCP element on mobile — it covers
			more of the viewport than any single block of hero text. It's ~1KB, so the
			priority hint costs nothing and stops it queueing behind the collage images.
		*/}
		<img
			src={backgroundArcs.src}
			alt=""
			class="absolute left-1/2 w-[120%] max-w-none -translate-x-1/2 lg:left-0 lg:w-full lg:max-w-full lg:translate-x-0 z-0 "
			loading="eager"
			fetchpriority="high"
			width={backgroundArcs.width}
			height={backgroundArcs.height}
		/>
	</div>

	{/* `isolate` keeps the glows' negative z-index inside this block — without it they'd paint behind the gradient backdrop. */}
	<div
		class="relative isolate flex flex-col items-center px-6 pt-25 lg:px-0 lg:pt-61"
		data-reveal
		data-reveal-stagger="0.12"
	>
		<div class="contents lg:relative lg:flex lg:w-full lg:flex-col lg:items-center">
			<img
				src={darkLayerSide.src}
				alt=""
				class="pointer-events-none h-[50%] absolute top-0 left-0 -z-10 translate-y-0 -translate-x-1/2 lg:top-1/2 lg:-translate-y-1/2 lg:max-w-none lg:h-auto"
			/>
			<img
				src={darkLayerSide.src}
				alt=""
				class="pointer-events-none h-[50%] absolute top-0 right-0 -z-10 translate-y-0 translate-x-1/2 lg:top-1/2 lg:-translate-y-1/2 lg:max-w-none lg:h-auto"
			/>
			<img
				src={darkLayerCenter.src}
				alt=""
				class="pointer-events-none absolute top-8 left-1/2 -z-10 translate-y-0 -translate-x-1/2 lg:top-1/2 lg:-translate-y-1/2 lg:max-w-none"
			/>

			<h1
				class="flex flex-col text-center leading-[1.05] tracking-[-0.165rem] [text-box:trim-both_cap_alphabetic] lg:block lg:leading-34"
				data-reveal-item
			>
				<span
					class="font-light text-[2.75rem] text-brand-primary max-lg:[text-box:trim-both_cap_alphabetic] lg:text-[5.5rem]"
					>Find The Right</span
				><br class="max-lg:hidden" />
				<span
					class="inline-block font-normal text-[clamp(2rem,calc((100vw-3rem)/8.4),3.625rem)] leading-1 whitespace-nowrap text-white uppercase max-lg:mt-[0.5em] max-lg:[text-box:trim-both_cap_alphabetic] lg:text-[8.25rem]"
					data-hero-word>{HERO_WORDS[0]}</span
				>
			</h1>

			{/* glass copy card */}
			<div
				class="order-3 lg:order-2 mt-4 w-full max-w-77 lg:max-w-113.5 rounded-sm border border-white bg-[linear-gradient(180deg,rgba(255,255,255,0.2)_0%,rgba(100,77,173,0.2)_100%)] px-3 py-5 lg:mt-8.25 lg:w-113.25 lg:px-10 lg:py-8"
				data-reveal-item
			>
				<p class="text-center text-[0.875rem] leading-4 text-white [text-box:trim-both_cap_alphabetic] lg:text-sm lg:leading-7.25">
					Get access to the world's largest database of <span class="font-semibold text-brand-primary">450M+ creators</span> across Instagram, Youtube, TikTok &amp; LinkedIn
				</p>
			</div>

			<div class="order-4 lg:order-3 -mt-2 lg:mt-3.75" data-reveal-item>
				<Button href={APP_URL} newTab>Free Trial</Button>
			</div>
		</div>

		{/* product mockup: real markup so GSAP can play the workflow through it */}
		<div class="order-2 lg:order-4 relative mt-6 w-full max-w-7xl px-0 lg:mt-14.75 lg:w-7xl lg:px-0">
			<WorkflowMockup />
		</div>
	</div>
</section>

<script>
	import "../../scripts/reveals";
	import "../../scripts/hero-words";
</script>
