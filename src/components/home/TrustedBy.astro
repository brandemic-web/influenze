---
import hammerhead from "../../assets/images/home_page/trusted_by/hammerhead_logo.svg";
import brandemic from "../../assets/images/home_page/trusted_by/brandemic_logo.svg";
import hyper from "../../assets/images/home_page/trusted_by/hyper_logo.svg";
import owled from "../../assets/images/home_page/trusted_by/owled_logo.svg";
import iplixMedia from "../../assets/images/home_page/trusted_by/iplix_media_logo.svg";
import circuit from "../../assets/images/home_page/trusted_by/circuit_logo.png";
/**
 * Every logo shares one box on mobile; from `lg:` up they are sized
 * individually. `size` and `class` are therefore lg-only — mobile keeps the
 * uniform MOBILE_SIZE below.
 *
 * `size` replaces DESKTOP_SIZE rather than adding to it: two width utilities on
 * one element collide, and which one wins depends on the order Tailwind emits
 * them, not the order written here.
 */
const MOBILE_SIZE = "w-25 h-8";
const DESKTOP_SIZE = "lg:w-64 lg:h-17";

const logos = [
	{ src: brandemic, alt: "Brandemic", w: 191, h: 42, class: "lg:pl-8" },
	{ src: hyper, alt: "Hyper", w: 97, h: 56, size: "lg:w-24 lg:h-14" },
	{
		src: iplixMedia,
		alt: "Iplix Media",
		w: 86,
		h: 53,
		// 86×53 is the artwork's own size, so it renders undistorted.
		size: "lg:w-21.5 lg:h-13.25",
	},
	{ src: circuit, alt: "Circuit", mobileSize: "w-22 h-5", size: "lg:w-40 lg:h-9" },
	{ src: owled, alt: "Owled", w: 93, h: 64, size: "lg:w-19 lg:h-13" },
	{ src: hammerhead, alt: "Hammerhead Global", w: 245, h: 68 },
];
---

<section class="relative z-2 pt-15 pb-5 lg:pb-20 lg:pt-36.5 overflow-hidden" aria-label="Trusted by">
	<h2 class="text-center text-[1.875rem] lg:text-2xl capitalize leading-[normal] text-white [text-box:trim-both_cap_alphabetic]">Trusted By</h2>
	<!-- Mobile: GSAP ticker (logos rendered twice so the loop stays gapless on tablets). Desktop: static centered row. -->
	<div class="mt-10 overflow-x-auto overscroll-x-contain lg:overflow-visible" data-marquee>
		<ul
			class="mx-auto flex w-max items-center gap-x-10 px-6 flex-nowrap lg:w-auto lg:max-w-7xl lg:justify-between lg:gap-x-8"
			data-marquee-track
		>
			{
				[...logos, ...logos].map((logo, i) => (
					<li
						class:list={["shrink-0", i >= logos.length && "hidden"]}
						data-marquee-clone={i >= logos.length ? "" : undefined}
						aria-hidden={i >= logos.length ? "true" : undefined}
					>
						<img
							src={logo.src.src}
							alt={i >= logos.length ? "" : logo.alt}
							width={logo.w}
							height={logo.h}
							class:list={[logo.mobileSize ?? MOBILE_SIZE, logo.size ?? DESKTOP_SIZE, logo.class]}
							loading="lazy"
						/>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	import "../../scripts/home-page/marquee";
</script>
