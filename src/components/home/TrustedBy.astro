---
import {
	TRUSTED_BY_HEADING,
	TRUSTED_BY_LOGOS,
	TRUSTED_BY_MOBILE_BOX,
	TRUSTED_BY_DESKTOP_BOX,
	type TrustedByBox,
	type TrustedByLogo,
} from "../../data/trustedBy";
import { getHomePage } from "../../sanity/lib/queries";
import { getPerspectiveCookie } from "../../lib/draft-mode";
import { urlFor } from "../../sanity/lib/image";

const { data: home } = await getHomePage(getPerspectiveCookie(Astro.cookies));
const trusted = home?.trustedBy;
const heading = trusted?.heading || TRUSTED_BY_HEADING;

/** Design px → rem, so the desktop row scales on the 1728px grid (see global.css). */
const rem = (px: number) => `${px / 16}rem`;
/** A padding/margin shorthand; any side left blank is 0. */
const spacing = (box?: TrustedByBox) =>
	box && (box.top || box.right || box.bottom || box.left)
		? [box.top, box.right, box.bottom, box.left].map((side) => rem(side ?? 0)).join(" ")
		: undefined;

/**
 * Sizes and spacing come through as CSS custom properties rather than classes:
 * they are per-logo numbers from Studio, and the <style> block below is what
 * gives each one its mobile value and its `lg` override without two width
 * utilities colliding on one element.
 */
type Logo = { src: string; alt: string; w?: number; h?: number; style: string };

const cssVars = (logo: Pick<TrustedByLogo, "mobile" | "desktop" | "padding" | "margin">) =>
	Object.entries({
		"--logo-w": rem(logo.mobile?.width ?? TRUSTED_BY_MOBILE_BOX.width),
		"--logo-h": rem(logo.mobile?.height ?? TRUSTED_BY_MOBILE_BOX.height),
		"--logo-w-lg": rem(logo.desktop?.width ?? TRUSTED_BY_DESKTOP_BOX.width),
		"--logo-h-lg": rem(logo.desktop?.height ?? TRUSTED_BY_DESKTOP_BOX.height),
		"--logo-padding": spacing(logo.padding),
		"--logo-margin": spacing(logo.margin),
	})
		.filter(([, value]) => value)
		.map(([name, value]) => `${name}:${value}`)
		.join(";");

// Studio logos append to the local set rather than replacing it. A logo is
// only usable with both an image and an alt, so an entry still missing one in
// Studio is skipped on its own instead of dropping the rest of the row.
const localLogos: Logo[] = TRUSTED_BY_LOGOS.map((logo) => ({
	src: logo.src.src,
	alt: logo.alt,
	w: logo.w,
	h: logo.h,
	style: cssVars(logo),
}));

const sanityLogos: Logo[] = (trusted?.logos ?? [])
	.filter((logo) => logo.image?.asset && logo.alt)
	.map((logo) => ({
		// 2x the widest box any logo draws at, and PNG/JPG uploads come back
		// as-is when the source is an SVG.
		src: urlFor(logo.image as never).width(640).url(),
		alt: logo.alt!,
		w: logo.intrinsic?.width,
		h: logo.intrinsic?.height,
		style: cssVars(logo),
	}));

const logos: Logo[] = [...localLogos, ...sanityLogos];
---

<section class="relative z-2 pt-15 pb-5 lg:pb-20 lg:pt-36.5 overflow-hidden" aria-label={heading}>
	<h2 class="text-center text-md lg:text-2xl capitalize leading-[normal] text-white [text-box:trim-both_cap_alphabetic]">{heading}</h2>
	{/* GSAP ticker at every width (logos rendered twice so the loop stays gapless). */}
	<div class="mt-8 overflow-x-auto overscroll-x-contain" data-marquee="always">
		<ul
			class="mx-auto flex w-max items-center justify-center gap-x-10 px-6 flex-nowrap opacity-60 grayscale-100 lg:gap-x-28"
			data-marquee-track
		>
			{
				[...logos, ...logos].map((logo, i) => (
					<li
						class:list={["shrink-0", i >= logos.length && "hidden"]}
						data-marquee-clone={i >= logos.length ? "" : undefined}
						aria-hidden={i >= logos.length ? "true" : undefined}
					>
						<img
							src={logo.src}
							alt={i >= logos.length ? "" : logo.alt}
							width={logo.w}
							height={logo.h}
							class="trusted-logo"
							style={logo.style}
							loading="lazy"
						/>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* The vars are set per logo above; the fallbacks here never fire, but keep
	   the rule readable on its own. */
	.trusted-logo {
		width: var(--logo-w, 6.25rem);
		height: var(--logo-h, 2rem);
	}

	/* `lg` — kept in sync with scripts/breakpoints.ts. Padding and margin land
	   here only: the mobile row is a uniform ticker, and per-logo spacing in it
	   would squeeze one logo inside the shared box. */
	@media (min-width: 64rem) {
		.trusted-logo {
			width: var(--logo-w-lg, 16rem);
			height: var(--logo-h-lg, 4.25rem);
			padding: var(--logo-padding, 0);
			margin: var(--logo-margin, 0);
		}
	}
</style>

<script>
	import "../../scripts/home-page/marquee";
</script>
