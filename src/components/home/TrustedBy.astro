---
import hopscotch from "../../assets/images/home_page/trusted_by/hopscotch_logo.svg";
import hammerhead from "../../assets/images/home_page/trusted_by/hammerhead_logo.svg";
import brandemic from "../../assets/images/home_page/trusted_by/brandemic_logo.svg";
import hyper from "../../assets/images/home_page/trusted_by/hyper_logo.svg";
import owled from "../../assets/images/home_page/trusted_by/owled_logo.svg";

const logos = [
	{ src: hopscotch, alt: "Hopscotch" },
	{ src: hammerhead, alt: "Hammerhead" },
	{ src: brandemic, alt: "Brandemic" },
	{ src: hyper, alt: "Hyper" },
	{ src: owled, alt: "Owled" },
];
---

<section class="bg-background-primary py-16 lg:py-20" aria-label="Trusted by">
	<h2 class="text-center text-sm capitalize text-white">Trusted By</h2>
	<ul class="mx-auto mt-[50px] flex max-w-[1160px] flex-wrap items-center justify-center gap-x-16 gap-y-8 px-6 lg:justify-between">
		{
			logos.map((logo) => (
				<li>
					<img src={logo.src.src} alt={logo.alt} class="h-10 w-auto lg:h-[50px]" loading="lazy" />
				</li>
			))
		}
	</ul>
</section>
