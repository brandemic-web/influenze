---
import { USE_CASES_SPLIT } from "../../data/useCasesSplit";
import swoosh from "../../assets/images/home_page/use_cases/swoosh.svg";
import circleCheck from "../../assets/images/home_page/use_cases/circle_check.svg";
---

<section class="relative" aria-labelledby="use-cases-split-heading">
	<!-- decorative swoosh painted over the cards, per design z-order -->
	<img
	src={swoosh.src}
	alt=""
	class="pointer-events-none absolute w-full object-cover"
	loading="lazy"/>

	<div class="relative mx-auto flex max-w-393 flex-col items-center px-6 pt-20 pb-16 lg:px-0 lg:py-40">
		<h2
			id="use-cases-split-heading"
			class="max-w-204 text-center text-[32px] capitalize leading-[1.1] text-white lg:text-[55px] [text-box:trim-both_cap_alphabetic]"
		>
			Use cases for <br class="max-lg:hidden" /><span class="text-brand-primary">brands and agencies</span>
		</h2>

		<div
			class="relative mt-10 flex w-full flex-col items-center justify-center gap-8.5 lg:mt-16.25 lg:flex-row"
			data-reveal
			data-reveal-stagger="0.15"
		>
			{
				USE_CASES_SPLIT.map((column) => (
					<article
						class="flex h-auto w-full max-w-2xl flex-col justify-center gap-7.5 rounded-md bg-[rgba(246,246,244,0.1)] px-8 py-10 lg:px-14 lg:py-13"
						data-reveal-item
					>
						<h3 class="text-[40px] capitalize leading-[normal] text-[#F6F6F4] lg:text-[64px] [text-box:trim-both_cap_alphabetic]">{column.title}</h3>
						<div class="h-px w-full max-w-103.75 bg-white/40"></div>
						<ul class="flex flex-col gap-3">
							{column.points.map((point) => (
								<li class="flex items-center gap-3.75">
									<img src={circleCheck.src} alt="" class="h-6 w-6 shrink-0" loading="lazy" />
									<span class="text-[18px] leading-9.5 text-white">{point}</span>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	import "../../scripts/reveals";
</script>
