---
import { Image } from "astro:assets";
import bolt from "../../assets/images/common/decor/green_bolt.png";
import avatar from "../../assets/images/home_page/testimonial/testimonial_profile_image.png";
import { TESTIMONIALS, TESTIMONIALS_HEADING, TESTIMONIALS_BAND } from "../../data/testimonials";

const cardPositions = [
	{ left: 291, top: 234 },
	{ left: 896, top: 349 },
	{ left: 462, top: 554 },
	{ left: 921, top: 681 },
	{ left: 320, top: 866 },
].map(({ left, top }) => ({ left: left / 16, top: top / 16 }));

const cards = [...TESTIMONIALS, ...TESTIMONIALS];
---

<section class="relative flex flex-col items-center gap-4 overflow-hidden pb-15 lg:h-317.25 lg:gap-0 lg:overflow-visible lg:py-0 lg:w-full lg:max-w-full" aria-labelledby="testimonials-heading">
	<div class="relative flex items-center justify-center gap-0 px-6 lg:block lg:px-0">
		<h2
			id="testimonials-heading"
			class="max-w-55 text-center text-md capitalize leading-[1.1] text-brand-primary lg:w-82.5 lg:max-w-none lg:text-[2.25rem] lg:leading-[normal] [text-box:trim-both_cap_alphabetic]"
		>
			{TESTIMONIALS_HEADING}
		</h2>
		<Image
			src={bolt}
			alt=""
			class="-ml-6 w-20 lg:absolute lg:ml-0 lg:top-0 lg:bottom-0 lg:my-auto lg:-right-22 lg:h-58.5 lg:w-32"
			widths={[128, 256]}
			sizes="128px"
			loading="lazy"
		/>
	</div>

	{/* watermark band (design z-order: behind ticker on mobile, between card groups on desktop) */}
	<p
		class="pointer-events-none absolute bottom-5 left-0 w-full whitespace-nowrap text-center font-['Open_Sauce_One'] text-6xl font-bold text-[#252525] [text-box:trim-both_cap_alphabetic] lg:top-149.5 lg:left-[-115.8125rem] lg:-translate-y-1/2 lg:bottom-auto lg:text-left lg:text-[13.225rem]"
		aria-hidden="true"
	>
		{TESTIMONIALS_BAND}<span class="hidden lg:inline"> {TESTIMONIALS_BAND}</span>
	</p>

	<!-- Cards: mobile renders as a GSAP marquee track (duplicated for a gapless loop), -->
	<!-- desktop escapes both wrappers via lg:contents and positions absolutely against the section. -->
	<div
		class="relative w-full overflow-x-auto overscroll-x-contain lg:contents"
		data-marquee
	>
		<div class="flex w-max gap-4 px-6 lg:contents" data-marquee-track>
			{
				cards.map((testimonial, i) => {
					const idx = i % TESTIMONIALS.length;
					const pos = cardPositions[idx];
					const isDuplicate = i >= TESTIMONIALS.length;
					return (
						<figure
							class={`w-85 shrink-0 rounded-sm bg-[linear-gradient(85.56deg,#A78EF6_19.24%,#8C69FD_36.03%)] px-2.75 py-4 lg:h-63.75 lg:w-123 lg:shrink-0 lg:rounded-[1.25rem] lg:px-0 lg:py-0 lg:absolute ${isDuplicate ? "hidden" : ""}`}
							style={`left:${pos.left}rem; top:${pos.top}rem; z-index:${idx < 2 ? 0 : 1}`}
							data-marquee-clone={isDuplicate ? "" : undefined}
							aria-hidden={isDuplicate ? "true" : undefined}
						>
							<div class="flex items-center gap-3 lg:contents">
								<Image
									src={avatar}
									alt=""
									class="h-11.5 w-11.5 rounded-full object-cover lg:absolute lg:top-7.25 lg:left-7.25 lg:h-21.5 lg:w-21.5"
									widths={[21.5, 43]}
									sizes="21.5px"
									loading="lazy"
								/>
								<figcaption class="lg:contents">
									<p class="text-[1.025rem] font-medium capitalize text-white lg:absolute lg:top-14.5 lg:left-61.25 lg:-translate-x-1/2 lg:-translate-y-1/2 lg:whitespace-nowrap lg:text-[2.25rem] lg:[text-box:trim-both_cap_alphabetic]">
										{testimonial.name}
									</p>
									<p class="mt-1 text-xs uppercase text-black lg:absolute lg:top-22.5 lg:left-38.75 lg:mt-0 lg:-translate-x-1/2 lg:-translate-y-1/2 lg:whitespace-nowrap lg:text-[1rem] lg:leading-[normal] lg:[text-box:trim-both_cap_alphabetic]">
										{testimonial.company}
									</p>
								</figcaption>
							</div>
							<blockquote class="mt-4 ml-13 lg:absolute lg:top-42.25 lg:left-34 lg:mt-0 lg:ml-0 lg:w-77.25 lg:-translate-y-1/2">
								<p class="text-[0.875rem] leading-normal text-white/80 lg:text-[1rem]">{testimonial.quote}</p>
							</blockquote>
						</figure>
					);
				})
			}
		</div>
	</div>
</section>

<script>
	import "../../scripts/marquee";
</script>
