---
import { Image } from "astro:assets";
import bolt from "../../assets/images/common/decor/green_bolt.png";
import avatar from "../../assets/images/home_page/testimonial/testimonial_profile_image.png";
import { TESTIMONIALS, TESTIMONIALS_HEADING, TESTIMONIALS_BAND } from "../../data/testimonials";

const cardPositions = [
	{ left: 291, top: 234 },
	{ left: 896, top: 349 },
	{ left: 462, top: 554 },
	{ left: 921, top: 681 },
	{ left: 320, top: 866 },
];
---

<section class="relative lg:h-317.25" aria-labelledby="testimonials-heading">
	<div class="relative flex-col items-center mx-auto hidden h-full w-full max-w-full lg:flex">
		<div class="relative">
			<h2
				id="testimonials-heading"
				class="w-82.5 text-center text-[36px] capitalize leading-[normal] text-brand-primary [text-box:trim-both_cap_alphabetic]"
			>
				{TESTIMONIALS_HEADING}
			</h2>
			<Image src={bolt} alt="" class="absolute top-0 bottom-0 my-auto -right-22 h-58.5 w-32" widths={[128, 256]} sizes="128px" loading="lazy" />
		</div>

		{/* watermark band between the first two and last three cards (design z-order) */}
		<div class="pointer-events-none absolute top-101.5 left-0 h-95.5 w-full overflow-hidden" aria-hidden="true">
			<p
				class="absolute top-48.5 left-[-1853px] -translate-y-1/2 font-['Open_Sauce_One'] text-[211.6px] leading-[normal] font-bold whitespace-nowrap text-[#252525] [text-box:trim-both_cap_alphabetic]"
			>
				{TESTIMONIALS_BAND} {TESTIMONIALS_BAND}
			</p>
		</div>

		{
			TESTIMONIALS.map((testimonial, i) => (
				<figure
					class="absolute h-63.75 w-123 rounded-[20px] bg-[linear-gradient(85.56deg,#A78EF6_19.24%,#8C69FD_36.03%)]"
					style={`left:${cardPositions[i].left}px; top:${cardPositions[i].top}px; z-index:${i < 2 ? 0 : 1}`}
				>
					<Image src={avatar} alt="" class="absolute top-7.25 left-7.25 h-21.5 w-21.5 rounded-full object-cover" widths={[21.5, 43]} sizes="21.5px" loading="lazy" />
					<figcaption>
						<p class="absolute top-14.5 left-61.25 -translate-x-1/2 -translate-y-1/2 text-[36px] font-medium capitalize whitespace-nowrap text-white [text-box:trim-both_cap_alphabetic]">
							{testimonial.name}
						</p>
						<p class="absolute top-22.5 left-38.75 -translate-x-1/2 -translate-y-1/2 text-[16px] uppercase leading-[normal] text-black [text-box:trim-both_cap_alphabetic]">
							{testimonial.company}
						</p>
					</figcaption>
					<blockquote class="absolute top-42.25 left-34 w-77.25 -translate-y-1/2">
						<p class="text-[16px] leading-[normal] text-white/80">{testimonial.quote}</p>
					</blockquote>
				</figure>
			))
		}
	</div>

	<!-- mobile / tablet fallback -->
	<div class="flex flex-col items-center gap-8 px-6 py-16 lg:hidden">
		<div class="flex items-start justify-center gap-3">
			<h2 class="max-w-82.5 text-center text-2xl capitalize leading-[1.1] text-brand-primary">
				{TESTIMONIALS_HEADING}
			</h2>
			<Image src={bolt} alt="" class="-mt-2 w-12" loading="lazy" />
		</div>
		{
			TESTIMONIALS.map((testimonial) => (
				<figure class="w-full max-w-123 rounded-sm bg-[linear-gradient(85.56deg,#A78EF6_19.24%,#8C69FD_36.03%)] p-7.25">
					<div class="flex items-center gap-6">
						<Image src={avatar} alt="" class="h-16.5 w-16.5 rounded-full object-cover" loading="lazy" />
						<figcaption>
							<p class="text-md font-medium capitalize text-white">{testimonial.name}</p>
							<p class="mt-1 text-xs uppercase text-black">{testimonial.company}</p>
						</figcaption>
					</div>
					<blockquote class="mt-4">
						<p class="text-[16px] leading-normal text-white/80">{testimonial.quote}</p>
					</blockquote>
				</figure>
			))
		}
	</div>
</section>
