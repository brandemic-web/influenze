---
/**
 * Profile card in a results or list table
 *
 * `buildAnalyzeLayout` is a single row; `buildListLayout` adds a rule and a
 * location/gender/language line underneath. The Design frames show the list
 * variant on the Analyze screen, which is wrong — hence the `variant` prop.
 *
 * `shortlist` is the list layout with the app's own two differences: Enquire is
 * gated on `isMediakitUnlocked`, so it is absent until someone pays to open the
 * creator, and the Media Kit cell beside it is empty for the same reason.
 */
import CreatorAvatar from "./CreatorAvatar.astro";
import Icon from "./Icon.astro";
import MediaKitStatusLabel from "./MediaKitStatusLabel.astro";
import PlatformIcon from "./PlatformIcon.astro";
import ProfileCardColumns from "./ProfileCardColumns.astro";
import VerifiedBadge from "./VerifiedBadge.astro";
import type { Creator, EngagementLevel, MediaKitState } from "../../../data/workflowMockup";

interface Props {
	creator: Creator;
	variant?: "analyze" | "list" | "shortlist";
	/** Omitted is the app's locked cell — nothing rendered, not a placeholder. */
	mediaKit?: MediaKitState;
}

const { creator, variant = "analyze", mediaKit } = Astro.props;
const isShortlist = variant === "shortlist";
/** Both saved-creator screens share `buildListLayout`; only their actions differ. */
const isList = variant === "list" || isShortlist;

/**
 * `checked` marks the rows the story has selected — the three it shortlists out of
 * the results, and the pair it compares inside a list.
 */
const ticked = creator.checked === true;

/** Enquire is `showEnquireButton: isMediakitUnlocked` on a shortlist row. */
const showEnquire = !isShortlist || (mediaKit !== undefined && mediaKit.status !== "locked");

/**
 * Engagement quality colours — `InfluenzeColors`' *Er tokens. HIGH and LOW keep
 * the dimmer values the Figma frames were signed off with; the middle bands are
 * the app's own (`aboveAverageEr`, `averageEr`, `belowAverageEr`).
 */
const LEVEL_COLOUR: Record<EngagementLevel, string> = {
	HIGH: "#3fbd71",
	"ABOVE AVERAGE": "#9edb57",
	AVERAGE: "#f2994a",
	"BELOW AVERAGE": "#ff7350",
	LOW: "#8f4242",
};
---

<article
	class:list={[
		"rounded-sm border border-[#2c2c3d] bg-wf-surface px-3.5 pt-4 pb-4",
		isList && "flex items-start",
	]}
	data-wf-creator={creator.handle}
>
	{
		isList && (
			<>
				<div class="w-21 shrink-0">
					<span class="flex items-center">
						<span
							class:list={[
								"grid size-3 shrink-0 place-items-center rounded-[0.1875rem] border",
								ticked ? "border-wf-violet-bright bg-wf-violet-bright" : "border-wf-table-label",
							]}
							data-wf-check
						>
							<Icon
								name="check"
								size="0.625rem"
								class={ticked ? "text-white" : "text-white opacity-0"}
							/>
						</span>
						<span class="w-3 shrink-0" />
						<CreatorAvatar size="3.75rem" handle={creator.handle} />
					</span>
				</div>
				{/* `leadingGap` — 12, not the 20 this table used before IZ-147. */}
				<div class="w-3 shrink-0" />
			</>
		)
	}

	<div class:list={[isList && "min-w-0 flex-1"]}>
		<ProfileCardColumns withLeading={!isList}>
			{
				!isList && (
					<span slot="leading" class="flex items-center">
						<span
							class:list={[
								"grid size-3 shrink-0 place-items-center rounded-[0.1875rem] border",
								ticked ? "border-wf-violet-bright bg-wf-violet-bright" : "border-wf-table-label",
							]}
							data-wf-check
						>
							<Icon
								name="check"
								size="0.625rem"
								class={ticked ? "text-white" : "text-white opacity-0"}
							/>
						</span>
						<span class="w-3 shrink-0" />
						<CreatorAvatar size="3.75rem" handle={creator.handle} />
					</span>
				)
			}

			<div slot="identity" class="flex flex-col gap-1">
				<span class="flex items-center gap-1">
					<span class="whitespace-nowrap text-[1rem] text-wf-text">{creator.name}</span>
					{creator.verified && <VerifiedBadge size="0.75rem" />}
				</span>
				<span class="flex items-center" style={`gap:${isList ? "0.25rem" : "0.5rem"}`}>
					<span class="flex min-w-0 items-center gap-1">
						<PlatformIcon platform="instagram" tile="0.75rem" glyph="0.4375rem" radius="0.1875rem" />
						<span class="whitespace-nowrap text-[0.625rem] font-medium text-[#ac91ff]">{creator.handle}</span>
						<Icon name="redirect" size="0.75rem" class="text-[#ac91ff]" />
					</span>
					<span class="rounded-[0.625rem] bg-wf-tier-pill px-1.5 py-1 text-[0.5rem] whitespace-nowrap text-[#d5caee]">
						{creator.tierLabel}
					</span>
				</span>
			</div>

			<span slot="followers" class="text-[0.875rem] text-wf-text">{creator.followers}</span>
			<span slot="likes" class="text-[0.875rem] text-wf-text">{creator.avgLikes}</span>
			<span slot="engagement" class="flex items-end gap-1">
				<span class="text-[0.875rem] text-wf-text">{creator.engagement}</span>
				<span class="text-[0.5rem] whitespace-nowrap" style={`color:${LEVEL_COLOUR[creator.engagementLevel]}`}
					>{creator.engagementLevel}</span
				>
			</span>

			{mediaKit && <MediaKitStatusLabel slot="mediaKit" state={mediaKit} />}

			<span slot="actions" class="flex items-center gap-2">
				{
					showEnquire && (
						/*
						 * `EnquireButton(compact: true)` — a table row gets the glyph alone, in a
						 * circle. The label and chevron belong to the `compact: false` form, which
						 * is what the creator detail's identity column draws. Getting this wrong
						 * is what used to crowd the Media Kit column off the row: the pill is
						 * 92 canvas px against this button's 36, and the column only has 136.
						 *
						 * `padding h12 v8` around a 12px glyph gives a 36x28 box, and a circular
						 * `BoxDecoration` paints to the shortest side — so a 28px circle with
						 * 4px of air either side, not a 36px one.
						 */
						<span class="grid h-7 w-9 shrink-0 place-items-center">
							<span class="grid size-7 place-items-center rounded-full border border-wf-green-mid bg-mkit-tile">
								<Icon name="messageCircle" size="0.75rem" class="text-wf-green-mid" />
							</span>
						</span>
					)
				}
				{
					isList ? (
						/*
						 * `ProfileCardMoreActionsButton` — a 30px circle over `blue` with a
						 * lavender29 hairline, holding Material's `more_horiz` at 16. It stands
						 * in for the separate add and remove controls the rows used to carry.
						 */
						<span class="grid size-7.5 place-items-center rounded-full border border-wf-chip bg-wf-surface">
							<svg
								class="size-4 text-wf-more-icon"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<circle cx="6" cy="12" r="2" />
								<circle cx="12" cy="12" r="2" />
								<circle cx="18" cy="12" r="2" />
							</svg>
						</span>
					) : (
						/* `AddToListButton(compact: true)` — 30px circle, 10px glyph. */
						<span class="grid size-7.5 shrink-0 place-items-center rounded-full border border-wf-menu-border bg-wf-menu">
							<Icon name="addToList" size="0.625rem" class="text-[#bfabff]" />
						</span>
					)
				}
			</span>
		</ProfileCardColumns>

		{
			isList && (
				<>
					<span class="my-[0.84375rem] block h-px w-full bg-wf-rule" />
					<div class="flex">
						<div class="flex min-w-0 flex-[5_1_0%] items-center text-[0.625rem] text-wf-meta">
							<Icon name="mapPin" size="0.625rem" />
							<span class="ml-1 whitespace-nowrap">{creator.location}</span>
							{creator.gender && <span class="ml-4 whitespace-nowrap">{creator.gender}</span>}
							<span class="ml-4 whitespace-nowrap">{creator.language}</span>
						</div>
						<div class="w-40.75 shrink-0" />
					</div>
				</>
			)
		}
	</div>
</article>
