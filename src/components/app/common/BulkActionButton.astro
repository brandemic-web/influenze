---
/**
 * Selection action — `bulk_action_button.dart`: `px12 py8`, radius 6, icon · 8 ·
 * label · 8 · count. `min-w-16 h-9` is Material's 64x36 minimum, which wins over
 * the padding. The count is dropped entirely at 0, not rendered as a zero.
 *
 * Each call site in the app passes its own palette, so `tone` carries the three
 * the mockup needs rather than this file deciding.
 */
import Icon from "./Icon.astro";
import type { WorkflowIconName } from "../../../data/workflowIcons";

interface Props {
	label: string;
	icon: WorkflowIconName;
	/** Rendered bare, without parentheses, unlike the Compare button's count. */
	count: number;
	/** Glyph size differs per call site: `delete` is 12, `remove_from_list` is 10. */
	iconSize?: string;
	/** `danger` = remove; `violet` = Analyze's bulk Add; `action` = Add to list. */
	tone?: "danger" | "violet" | "action";
	/**
	 * The app's disabled state — `Opacity(0.5)` with no count, which is how Analyze's
	 * Add sits before anything is ticked (it passes `hideWhenEmpty: false`, so unlike
	 * every other call site it stays on screen). The count is still rendered, held
	 * hidden, so a beat has something to fade in when the selection lands.
	 */
	pending?: boolean;
	class?: string;
}

const {
	label,
	icon,
	count,
	iconSize = "0.75rem",
	tone = "danger",
	pending = false,
	class: className = "",
} = Astro.props;

const TONE = {
	danger: { bg: "bg-wf-danger-bg", icon: "text-white", label: "text-wf-danger", count: "text-wf-danger-text" },
	violet: { bg: "bg-wf-violet", icon: "text-white", label: "text-white", count: "text-wf-bulk-count" },
	action: { bg: "bg-wf-action", icon: "text-white", label: "text-white", count: "text-wf-bulk-count-soft" },
} as const;

const look = TONE[tone];
---

<span
	class:list={[
		"flex h-9 min-w-16 items-center gap-2 rounded-[0.375rem] px-3 text-[0.625rem] whitespace-nowrap",
		look.bg,
		pending && "opacity-50",
		className,
	]}
	data-wf-bulk-action
>
	<Icon name={icon} size={iconSize} class={look.icon} />
	<span class:list={["font-medium", look.label]}>{label}</span>
	{
		count > 0 && (
			<span class:list={[look.count, pending && "opacity-0"]} data-wf-bulk-count>
				{count}
			</span>
		)
	}
</span>
