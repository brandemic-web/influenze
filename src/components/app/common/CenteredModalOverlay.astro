---
/**
 * Dialog layer — the app presents these over a manually drawn scrim:
 * `BackdropFilter(blur 6)` under `rgba(0,0,0,0.08)`, with a transparent
 * Material barrier. The card is centred and content-driven in height.
 */
interface Props {
	width: string;
	/** Fixed-height dialogs only — the add-to dialog is content-driven. */
	height?: string;
	/** Card fill, radius and border differ between the dialogs. */
	background?: string;
	radius?: string;
	border?: string;
}

const { width, height, background = "#181823", radius = "1.5rem", border = "#3b3b62" } = Astro.props;
---

{/*
	The blur is a `filter` on the backdrop copy, not `backdrop-filter` on an
	overlay: the latter samples the un-transformed backdrop inside the scaled
	stage, so it lands offset.
*/}
<div class="absolute inset-0 blur-[0.375rem]" data-wf-modal-backdrop>
	<slot name="backdrop" />
</div>
<div class="absolute inset-0 bg-black/8" data-wf-modal-scrim></div>

<div
	class="absolute top-1/2 left-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col"
	style={`width:${width};${height ? `height:${height};` : ""}background:${background};border-radius:${radius};border:1px solid ${border}`}
	data-wf-modal-card
>
	<slot />
</div>
