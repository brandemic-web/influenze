---
/**
 * A creator/user photo.
 *
 * Given a `handle` it renders that creator's portrait (see
 * src/data/creatorPortraits.ts); without one — or before a creator has a photo —
 * it stays the gradient placeholder it always was. Every instance keeps its
 * `data-wf-avatar` tag either way.
 *
 * One 340px variant is emitted per creator and reused at every size on the page:
 * that is 2x the largest avatar the mockup draws (the 10.625rem detail portrait),
 * and the sources are square so the crop is a straight fill.
 *
 * Deferred by default. These used to load eagerly so a portrait could not pop in
 * part-way through a beat, but the mockup sits in the hero and every portrait is
 * on step 3 or later, so eager loading put ~90KB of off-screen images ahead of the
 * hero's own paint. Pass `loading="eager"` for anything visible on first paint —
 * the nav avatar does. If a beat is seen to pop, that is the knob to turn.
 */
import { Image } from "astro:assets";
import { portraitFor } from "../../../data/creatorPortraits";

interface Props {
	size?: string;
	/** `full` for people, a rem value for the rounded tiles in list cards. */
	radius?: string;
	class?: string;
	/** Creator handle, matched to a file in profile_images. */
	handle?: string;
	/** `eager` for portraits painted on the first story step. */
	loading?: "eager" | "lazy";
}

const {
	size = "2rem",
	radius = "9999px",
	class: className = "",
	handle,
	loading = "lazy",
} = Astro.props;

const portrait = handle ? portraitFor(handle) : undefined;
---

<div
	data-wf-avatar
	class={`shrink-0 overflow-hidden bg-[linear-gradient(140deg,#3b3560_0%,#221d38_60%,#2c2745_100%)] ${className}`}
	style={`width:${size};height:${size};border-radius:${radius}`}
	aria-hidden="true"
>
	{portrait && <Image src={portrait} alt="" width={340} class="size-full object-cover" loading={loading} />}
</div>
