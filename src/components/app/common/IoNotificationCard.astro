---
/**
 * The header's import/export popover — `common/widgets/io_notification_button.dart`.
 *
 * It is not a toast: the button holds the last five jobs, and a job finishing
 * **auto-opens** the popover with that job expanded. So this is the completed
 * state of one card, which is the only state the story reaches.
 */
import Icon from "./Icon.astro";
import { EXPORT_JOB } from "../../../data/workflowMockup";
---

{/* `width 300`, radius 16, `popupMenuBg` under a `popupMenuBorder` hairline, 8 below the button. */}
<div
	class="absolute top-22 right-16.5 z-10 w-75 rounded-[1rem] border border-wf-dialog-border bg-wf-panel px-6 py-5.5"
	data-wf-export-note
>
	<span class="flex items-center gap-1">
		<Icon name="circleCheck" size="0.75rem" class="mt-0.5 text-mkit-green" />
		<span class="text-[0.625rem] whitespace-nowrap text-mkit-green">Exported</span>
	</span>

	<span class="mt-2 flex items-center justify-between gap-2">
		<span class="whitespace-nowrap text-[1rem] text-wf-text">{EXPORT_JOB.title}</span>
		<span class="grid size-3 shrink-0 place-items-center rounded-full bg-wf-note-close">
			<Icon name="cross" size="0.5rem" class="text-white" />
		</span>
	</span>

	<span class="mt-1.5 block text-[0.625rem] text-wf-meta">{EXPORT_JOB.at}</span>

	{/* Success chip — `px10 py6`, radius 6, green2 under green1. */}
	<span
		class="mt-3 flex w-fit items-center gap-2 rounded-[0.375rem] border border-wf-credit-border bg-wf-credit-to px-2.5 py-1.5"
	>
		<Icon name="circleCheck" size="0.75rem" class="text-white" />
		<span class="text-[0.625rem] whitespace-nowrap">
			<span class="font-medium text-wf-green">{EXPORT_JOB.rows} Rows</span>
			<span class="text-wf-text"> exported</span>
		</span>
	</span>
</div>
