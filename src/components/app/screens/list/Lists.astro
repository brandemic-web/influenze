---
/**
 * My Lists. Frame is `padding 50` → panel → `padding 40`, giving 1228 of content at
 * 1440, with a `clamp(floor(w / 240), 1, 4)` grid and `cardHeight = cardWidth + 94`.
 *
 * One screen serves both tabs, as `lists.dart` does — the type swaps the word and
 * the accent and nothing else. The app has no centred "My Lists" title any more:
 * the tabs head the panel, and a second rule closes the toolbar under them.
 */
import AppShell from "../../common/AppShell.astro";
import CreatorAvatar from "../../common/CreatorAvatar.astro";
import Icon from "../../common/Icon.astro";
import PlatformIcon from "../../common/PlatformIcon.astro";
import MyListsTabsHeader from "./widgets/MyListsTabsHeader.astro";
import ToolbarAction from "./widgets/ToolbarAction.astro";
import {
	CREATOR_LISTS,
	CREATOR_SHORTLISTS,
	CREDITS,
	JUST_UPDATED,
	LIST_CREATORS,
	SHORTLIST_HANDLES,
	STORY_LIST,
	STORY_SHORTLIST,
	type ListType,
} from "../../../../data/workflowMockup";

interface Props {
	/**
	 * Which tab is live when the screen arrives. **The My Lists nav link always
	 * lands on Lists** (`NavTab.lists` routes to `AppRoutes.lists`), so this
	 * defaults there and the story clicks across when it wants the other one.
	 */
	type?: ListType;
	/**
	 * Which tab holds the card the story opens next. Both panes are rendered so the
	 * click has somewhere to go, but only this one carries `data-wf-list-target` —
	 * otherwise `openShortlist` and `listDetail` would find two and take the wrong
	 * card. It also dates the screen: the shortlist is visited before the story
	 * opens anybody and the list after, which is what makes the avoided spend visible.
	 */
	target?: ListType;
}

const { type = "list", target = type } = Astro.props;
const credits = target === "shortlist" ? CREDITS.afterSearch : CREDITS.afterProfile;

/**
 * Who each card shows. Both are `AvatarGrid`, which always keeps its full 2x2.
 *
 * The **stage** decides, not the tab. The story's promote into the list happens
 * between this screen's two visits, so the Lists tab is passed through twice: on
 * the way to the shortlist it must still show the list as it was — Poorav and
 * Justin, the card's own preview — and only the second visit has Selwyn in it.
 * Reading `LIST_CREATORS` both times put him in the grid before the story had
 * added him.
 */
const addedToList = target === "list";
const PANES = (["shortlist", "list"] as const).map((pane) => {
	const shortlist = pane === "shortlist";
	const cards = shortlist ? CREATOR_SHORTLISTS : CREATOR_LISTS;
	return {
		pane,
		shortlist,
		cards,
		members: (shortlist
			? SHORTLIST_HANDLES
			: addedToList
				? LIST_CREATORS.map((creator) => creator.handle)
				: cards[0].preview) as readonly string[],
		storyName: shortlist ? STORY_SHORTLIST : STORY_LIST,
		live: pane === target,
	};
});

/** Squircle tiles: the app clips a custom path; 32% is the closest CSS match. */
const tileClass = "block size-[7.40625rem] border border-[#463c60] bg-wf-chip";
const tileStyle = "border-radius:32%";
---

<AppShell active="lists" credits={credits}>
	<div
		class="absolute top-32.5 left-16.5 h-176 w-327 overflow-hidden rounded-md bg-wf-panel"
		data-wf-lists-tabs={type}
	>
		<div class="flex h-full flex-col p-10">
			<MyListsTabsHeader active={type} />

			<div class="mt-5 flex items-center">
				{/* `width * 0.21 - 7` = 295 at 1440; radius 6, `padding h24 v16`, 14px glyph. */}
				<div
					class="flex h-[3.0625rem] shrink-0 items-center gap-1.5 rounded-[0.375rem] bg-wf-search px-6"
					style="width:18.4625rem"
				>
					<Icon name="search" size="0.875rem" class="shrink-0 text-wf-text-muted" />
					<span class="text-[0.875rem] font-medium whitespace-nowrap">
						<span class="text-wf-text-muted">Search&nbsp;&nbsp;</span>{PANES.map((p) => (
							<span
								class={p.shortlist ? "text-wf-shortlist" : "text-wf-green-bright"}
								data-wf-lists-pane={p.pane}
							>
								{p.shortlist ? "ShortLists" : "Lists"}
							</span>
						))}
					</span>
				</div>

				{/* `PlatformDropdown`: `padding 5`, radius 6; tile 40 radius 8, gap 4, chevron 12. */}
				<div class="ml-4.25 flex shrink-0 items-center gap-1 rounded-[0.375rem] bg-wf-search p-[0.3125rem]">
					<PlatformIcon platform="instagram" tile="2.5rem" glyph="1.5rem" radius="0.5rem" />
					<Icon name="arrowIcon" size="0.75rem" class="text-wf-text-soft" />
				</div>

				{/*
					Import ends the row. Its separator, Cancel and Delete are one widget in
					the app — `MyListsSelectionBar` — and it collapses to nothing while
					nothing is selected, which is how both of these frames sit.
				*/}
				<ToolbarAction label="Import" icon="import" class="ml-auto" />
			</div>

			{/* `SizedBox(20)` · `Divider(lavender11)` · `SizedBox(20)` closes the toolbar. */}
			<span class="mt-5 block h-px w-full shrink-0 bg-wf-rule"></span>

			{PANES.map((p) => (
			<div class="mt-5 flex min-h-0 flex-1 gap-4 overflow-hidden" data-wf-lists-pane={p.pane}>
				{
					p.cards.map((card) => (
						<article
							class="flex h-97.25 w-73.75 shrink-0 flex-col rounded-[1.5rem] border border-[#2a2634] bg-wf-surface p-4"
							data-wf-list-target={p.live && card.name === p.storyName ? "" : undefined}
						>
							{/*
								The grid is always its full 2x2 — an unfilled slot keeps the tile
								and just has no portrait in it, the way the app's own card holds
								its shape. The last slot is the overflow count only when there is
								an overflow to report.
							*/}
							<div class="grid size-65.75 shrink-0 grid-cols-2 gap-2.5 p-2">
								{[0, 1, 2].map((slot) =>
									p.members[slot] ? (
										<CreatorAvatar
											size="7.40625rem"
											radius="32%"
											handle={p.members[slot]}
											class="border border-[#463c60] bg-wf-chip"
										/>
									) : (
										<span class={tileClass} style={tileStyle} />
									)
								)}
								<span class={`${tileClass} grid place-items-center`} style={tileStyle}>
									{p.members.length > 3 && (
										<span class="text-md font-medium text-[#6c5ba1]">+{p.members.length - 3}</span>
									)}
								</span>
							</div>

							<p class="mt-3.5 px-1.5 py-3 text-[1rem] font-medium whitespace-nowrap text-wf-text">
								{card.name}
							</p>
							<div class="mt-1 flex items-end justify-between px-1.5">
								{/*
									The story has just added to its own card, so that one reads "just
									now" wherever it is shown; every other card keeps its authored age.
								*/}
								<span class="text-[0.625rem] whitespace-nowrap text-wf-meta">
									{p.live && card.name === p.storyName ? JUST_UPDATED : card.updated}
								</span>
								{/* `SelectionIndicator` unselected: transparent, a lavender14 border, no mark. */}
								<span class="size-4 rounded-xs border-[0.083rem] border-wf-control-border" />
							</div>
						</article>
					))
				}
			</div>
			))}
		</div>
	</div>
</AppShell>
