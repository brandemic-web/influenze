---
/**
 * Frame shared by list detail and compare — `ListDetailShell` in
 * list/list_details.dart: the panel fills the card's 50px inset, and the content
 * sits in a centred column of `0.642 × viewport` (925 at 1440) with `padding-top 42`.
 */
import Icon from "../../../common/Icon.astro";

interface Props {
	title: string;
	/**
	 * `InlineEditableText`'s `idleSuffix` — the singular type label the app shows
	 * beside the name when the field is not being edited, `List` / `ShortList`
	 * (`ListType.detailTypeLabel`). Compare mode has no name to suffix.
	 */
	typeLabel?: string;
	/**
	 * Which accent the label takes — `ListType.accentColor`, the same pairing that
	 * distinguishes the My Lists tabs: green for a list, lavender for a shortlist.
	 */
	typeAccent?: string;
	/** Compare mode centres the title and hides the share control. */
	compare?: boolean;
	/**
	 * Shortlists have no share control at all — sharing a list is a view of unlocked
	 * media kits, and a shortlist holds none. `shortlist_details.dart` simply never
	 * builds the button, rather than disabling it.
	 */
	share?: boolean;
	/**
	 * Blur the panel's contents, for the share modal's `CenteredModalOverlay`.
	 * Applied as `filter` on the content rather than `backdrop-filter` on an
	 * overlay: the latter samples the un-transformed backdrop inside the scaled
	 * stage, so the blur lands offset.
	 */
	blurred?: boolean;
}

const { title, typeLabel, typeAccent = "text-wf-green-bright", compare = false, share = true, blurred = false } = Astro.props;
---

<div class="absolute top-32.5 left-16.5 h-176 w-327 overflow-hidden rounded-md bg-wf-panel">
	<div
		class:list={[
			"absolute top-10.5 left-1/2 flex h-165.5 w-231.25 -translate-x-1/2 flex-col",
			blurred && "blur-md",
		]}
		data-wf-panel-body
	>
		<header class="flex shrink-0 items-center">
			<span
				class:list={[
					"flex-1 py-3 text-md whitespace-nowrap text-wf-text",
					compare ? "pl-7 text-center" : "pl-6",
				]}
				>{title}{
					typeLabel && (
						/*
						 * `Text.rich`: a 4px `WidgetSpan` then a string with its own leading
						 * space, so the gap is both together — about 8px at this size. Baseline
						 * aligned, and `searchLabelText` 14/500 in the type's accent.
						 */
						<span class:list={["ml-2 text-[0.875rem] font-medium", typeAccent]}>{typeLabel}</span>
					)
				}</span
			>
			{/*
				`Share` is a text link, not a button: `share.svg` 14 tinted lavender47, gap 4,
				then `shareLabelText` 12/400 white — and it sits **before** Back. The 28x28
				violet square this used to draw belongs to an older design.
			*/}
			{!compare && share && <span class="ml-3 flex shrink-0 items-center gap-1" data-wf-share>
				<Icon name="share" size="0.875rem" class="text-wf-shortlist" />
				<span class="text-[0.75rem] whitespace-nowrap text-wf-text">Share</span>
			</span>}
			<span class="ml-4 text-[0.875rem] font-medium whitespace-nowrap text-wf-back" data-wf-back>Back</span>
		</header>

		<span class="mt-3 block h-px shrink-0 bg-wf-rule"></span>

		<slot />
	</div>
</div>
