---
/**
 * Handle/URL lookup field above the filter rail — mirrors
 * analyze_search_bar.dart.
 *
 * FIND is a Material button in the app, so it carries a 36px minimum height;
 * that plus the 16px vertical padding is what makes the bar 4.5rem tall.
 */
import Icon from "../../../common/Icon.astro";

interface Props {
	/** A typed query turns the border green and enables FIND. */
	query?: string;
}

const { query } = Astro.props;
const filled = Boolean(query);
---

<div
	class:list={[
		"absolute top-32.5 left-16.5 flex h-18 w-90 items-center rounded-[0.625rem] border-2 bg-wf-input pt-4 pr-4 pb-4 pl-6",
		filled ? "border-wf-input-filled" : "border-wf-input-border",
	]}
	data-wf-searchbar
>
	<Icon name="search" size="1rem" class="text-wf-text-muted" />

	{
		filled ? (
			<p class="ml-1.5 text-[0.875rem] whitespace-nowrap text-wf-text">{query}</p>
		) : (
			<p class="ml-1.5 text-[0.875rem] font-medium whitespace-nowrap text-wf-text-muted">
				Enter <span class="text-wf-green">username</span> / <span class="text-wf-green">@handle</span> /{" "}
				<span class="text-wf-green">URL</span>
			</p>
		)
	}

	<span
		class:list={[
			"ml-auto grid h-9 min-w-16 place-items-center rounded-[0.375rem] px-2.5 text-[0.625rem] font-medium",
			filled ? "bg-wf-action text-wf-text" : "bg-wf-action-off text-white/50",
		]}>FIND</span
	>
</div>
