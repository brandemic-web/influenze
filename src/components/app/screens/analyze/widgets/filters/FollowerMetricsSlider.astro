---
/**
 * The engagement-benchmark slider inside a selected follower tier —
 * `EngagementStepSlider`
 *
 * Hand-built in the app too (no Material `Slider`): a 4px edge-to-edge track in
 * a 16px-tall box, grey to the left of the thumb and green to the right, with a
 * plain white 16px thumb. Six snap stops: an "all ranges" stop, then five evenly
 * spaced across the remainder. Dragging right raises the minimum benchmark, so
 * stop 0 — thumb hard left, track all green — is "accept every range".
 *
 * The thumb and the grey fill are both placed from one `--wf-slider-at` custom
 * property, so the workflow timeline can drag the handle by animating a single
 * number while the geometry stays here. `data-wf-slider-stops` publishes the
 * snap offsets, `data-wf-slider-stop` the authored one and `data-wf-slider-from`
 * the one the story's drag starts at, so the timeline never has to restate any
 * of them.
 */
interface Props {
	/** Stop index 0–5, where 0 is the "all ranges" position. */
	stop?: number;
	/** Stop the story's drag pulls away from. Defaults to the authored one. */
	from?: number;
}

const { stop = 3, from = stop } = Astro.props;

/**
 * Stop offsets as a percentage of the usable travel. The app reserves a 5px gap
 * between the "all ranges" stop and the first real one; at the rail's width that
 * is ~1.6% of travel, close enough to express proportionally.
 */
const stops = [0, 1.6, 26.2, 50.8, 75.4, 100];
const at = stops[Math.min(Math.max(stop, 0), 5)];

const captions = ["min", "poor", "average", "good", "max"];
/**
 * The slider sets a *minimum*, so the lit labels are the ones from the thumb
 * rightward — the range being accepted. `engagementQualityLabel` in
 * follower_metrics_filter.dart, where stop 0's "all ranges" lights all five.
 */
const litFrom = stop - 1;
---

<div
	data-wf-slider
	data-wf-slider-stops={stops.join(",")}
	data-wf-slider-stop={stop}
	data-wf-slider-from={from}
	style={`--wf-slider-at:${at / 100}`}
>
	<div class="relative h-4 w-full">
		<!-- Track sits under the thumb's full travel, hence the 8px inset on the fill. -->
		<div class="absolute inset-x-0 top-1.5 flex h-1">
			<span class="h-full bg-wf-track" style="width:calc(0.5rem + (100% - 1rem) * var(--wf-slider-at))"></span>
			<span class="h-full flex-1 bg-wf-green-mid"></span>
		</div>
		<span
			class="absolute top-0 block size-4 rounded-full bg-white"
			style="left:calc((100% - 1rem) * var(--wf-slider-at))"
			data-wf-slider-thumb></span>
	</div>

	<div class="flex items-center justify-between pt-2">
		{
			captions.map((caption, index) => (
				<span
					class:list={["text-[0.75rem]", index >= litFrom ? "text-wf-text-quiet" : "text-wf-text-muted"]}
					data-wf-slider-caption
				>
					{caption}
				</span>
			))
		}
	</div>
</div>
