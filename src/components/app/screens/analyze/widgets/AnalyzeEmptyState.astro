---
/** Results surface before a search has run — mirrors analyze_empty_state.dart. */
import Icon from "../../../common/Icon.astro";
---

<div class="absolute inset-0 flex flex-col items-center justify-center gap-3" data-wf-empty>
	<Icon name="userRoundCog" size="1.5rem" class="text-wf-text" />
	<p class="text-[1.125rem] text-wf-text">Start your search</p>
	<p class="text-center text-[0.75rem] leading-[1.45] text-wf-text-dim">
		Results will populate based on your<br />search input
	</p>
</div>
