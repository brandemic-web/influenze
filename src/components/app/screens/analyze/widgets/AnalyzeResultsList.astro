---
/**
 * The ranked results table — `analyze_results_list.dart`: `padding h24 v20`, then
 * header / rule / applied filters / rule / column header / list.
 *
 * `data-wf-results-part` tags each block so beat 2 can stagger them in as the
 * search lands; `data-wf-results-scroll` is the column the cursor wheels.
 */
import BulkActionButton from "../../../common/BulkActionButton.astro";
import Icon from "../../../common/Icon.astro";
import ProfileCard from "../../../common/ProfileCard.astro";
import ProfileCardColumns from "../../../common/ProfileCardColumns.astro";
import {
	ANALYZED_COUNT,
	RESULT_CREATORS,
	RESULT_FILTERS,
	SHORTLIST_HANDLES,
} from "../../../../../data/workflowMockup";

interface Props {
	/** Story rows already ticked and the bulk Add live — see Analyze's `selected`. */
	selected?: boolean;
}

const { selected = false } = Astro.props;

/** Ticking is what turns the Add pill from its held 50% into a live control. */
const shortlisted = new Set<string>(SHORTLIST_HANDLES);
---

{/* buildHeader: fromLTRB(18, 20, 0, 20) */}
<div class="flex shrink-0 items-center pt-5 pr-6 pb-5 pl-4.5" data-wf-results-part>
	<span class="flex items-center gap-1 text-md whitespace-nowrap text-wf-text">
		Analyzed <span class="text-wf-green-mid">{ANALYZED_COUNT}</span>
		<span class="w-2"></span>
		Total Results <span class="text-wf-green-mid">1248</span>
	</span>
	{/*
		Analyze is the one `BulkActionButton` that passes `hideWhenEmpty: false`, so
		it holds its place at 50% while nothing is ticked rather than collapsing. This
		is where the shortlist story starts: ticking rows here and adding them costs
		nothing, because nobody has been opened.
	*/}
	<span class="ml-auto" data-wf-results-add>
		<BulkActionButton
			label="Add"
			icon="plus"
			count={SHORTLIST_HANDLES.length}
			iconSize="0.5rem"
			tone="violet"
			pending={!selected}
		/>
	</span>
</div>

<span class="block h-px shrink-0 bg-wf-rule" data-wf-results-part></span>

{/* AnalyzeAppliedFiltersBar: fromLTRB(18, 20, 24, 20), groups spaced 24 */}
<div class="shrink-0 pt-5 pr-6 pb-5 pl-4.5" data-wf-results-part>
	<div
		class="flex items-center gap-6 overflow-hidden mask-[linear-gradient(to_right,#000_94%,transparent_100%)]"
	>
		{
			RESULT_FILTERS.map((filter) => (
				<span class="flex shrink-0 items-center gap-2.5">
					<span class="text-[0.75rem] font-medium whitespace-nowrap text-wf-text-soft">{filter.label}</span>
					<span class="rounded-[0.25rem] bg-wf-chip-on px-2 pt-1 pb-1.25 text-[0.75rem] whitespace-nowrap text-wf-text">
						{filter.value}
					</span>
				</span>
			))
		}
	</div>
</div>

<span class="block h-px shrink-0 bg-wf-rule" data-wf-results-part></span>

{/* HeaderRow: padding l14 r14 b8, inside a pt-16/pb-8 wrapper */}
<div class="shrink-0 pt-4 pb-2" data-wf-results-part>
	<ProfileCardColumns class="px-3.5 pb-2">
		<span slot="leading" class="flex items-center gap-2">
			<span class="size-3 shrink-0 rounded-[0.1875rem] border border-wf-table-label"></span>
			<span class="text-[0.75rem] whitespace-nowrap text-wf-table-label">Select all</span>
		</span>
		<span slot="identity" class="text-[0.75rem] whitespace-nowrap text-wf-table-label">Name</span>
		<span slot="followers" class="text-[0.75rem] whitespace-nowrap text-wf-table-label">Followers</span>
		<span slot="likes" class="text-[0.75rem] whitespace-nowrap text-wf-table-label">Avg. Likes</span>
		<span slot="engagement" class="flex items-center gap-1 text-[0.75rem] whitespace-nowrap text-wf-table-label">
			Engagement Rate
			<Icon name="arrowDown" size="0.875rem" class="text-wf-table-label" />
		</span>
		{/* Headed even here, where every cell is empty: nothing in a fresh search is bought yet. */}
		<span slot="mediaKit" class="text-[0.75rem] whitespace-nowrap text-wf-table-label">Media Kit</span>
	</ProfileCardColumns>
</div>

{/* The inner column holds the rows so it can be scrolled as one; it keeps its
     natural height and overflows the clipped parent rather than shrinking. */}
<div class="flex min-h-0 flex-1 flex-col overflow-hidden pt-2" data-wf-results-part>
	<div class="flex shrink-0 flex-col gap-2" data-wf-results-scroll>
		{
			RESULT_CREATORS.map((creator) => (
				<ProfileCard creator={{ ...creator, checked: selected && shortlisted.has(creator.handle) }} />
			))
		}
	</div>
</div>
