---
/**
 * Share modal.
 *
 * Note this modal is presented by `CenteredModalOverlay`, not the dialog route
 * `AddToListDialog` uses, so it differs on every axis: the overlay is **clipped to the host panel** (radius 12), draws a
 * **blur only with no dim scrim**, and ramps `blur(0 → 12)` over 260ms.
 */
import Icon from "../../common/Icon.astro";
import ListDetails from "../list/ListDetails.astro";

/** The card is centred in the host panel, not the viewport. */
const panel = "absolute top-[8.125rem] left-[4.125rem] h-176 w-[81.75rem]";
---

<ListDetails blurred />

<div class={`${panel} grid place-items-center`}>
	<div class="relative w-123.5 rounded-[1.5rem] border border-wf-dialog-border bg-wf-surface" data-wf-share-card>
		<span class="absolute top-4.5 right-4.5 flex" data-wf-share-close>
			<Icon name="cross" size="0.875rem" class="text-wf-text-muted" />
		</span>

		<div class="flex flex-col px-8.5 pb-8">
			<p class="pt-8 text-center text-[1.375rem] text-wf-text">Share to email</p>

			<div class="mt-4.5 flex items-center rounded-[0.375rem] bg-[#37375a] px-4 py-3" data-wf-email-field>
				<Icon name="mail" size="1rem" class="text-[#986cff]" />
				<span class="ml-2.5 flex-1 text-[0.875rem] leading-none font-medium">
					<span class="wf-untrimmed text-wf-text-muted" data-wf-email-hint>Enter email address</span>
					<span class="wf-untrimmed hidden text-wf-text" data-wf-email-value>kabir@brandemic.in</span>
					<!-- Inside the flex-1 box, so it trails the text instead of the space. -->
					<span class="ml-px hidden h-3.5 w-px align-middle bg-wf-text" data-wf-caret></span>
				</span>
				<span class="ml-3 text-[0.625rem] whitespace-nowrap text-wf-meta">expires on</span>
				<!-- 15-day range picker; the pill shows `d MMM` of today + 7. -->
				<span class="ml-2 flex items-center gap-1.5 rounded-sm bg-white px-2.5 py-1.5">
					<span class="text-[0.75rem] font-medium whitespace-nowrap text-black">7 Aug</span>
					<Icon name="arrowIcon" size="0.75rem" class="text-black" />
				</span>
			</div>
		</div>

		<span class="block h-px w-full bg-wf-dialog-border"></span>

		<div class="flex flex-col px-20.5 pt-4 pb-8.5">
			<span
				class="flex w-full items-center justify-center gap-2 rounded-[0.625rem] bg-wf-violet py-4 text-[1rem] font-semibold text-wf-text"
				data-wf-send
			>
				<span class="wf-untrimmed" data-wf-send-label="idle">Send</span>
				<span class="wf-untrimmed hidden" data-wf-send-label="done">Sent</span>
				<Icon name="externalLink" size="1rem" />
			</span>
			<span class="mt-3 text-center text-[0.875rem] font-medium text-[#a589ff] underline">Manage Shared Links</span>
		</div>
	</div>
</div>
