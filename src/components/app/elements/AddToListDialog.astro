---
import Icon from "../common/Icon.astro";
import CreatorAvatar from "../common/CreatorAvatar.astro";

/**
 * Add to list — the dialog for adding creators to a campaign list.
 */
interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;

/**
 * `preview` handles resolve to portraits through `data/creatorPortraits` — the
 * same lookup the hero mockup's list cards use. A handle with no file falls back
 * to the avatar's gradient.
 */
const lists = [
	{
		name: "Vox Pop",
		creators: "12 Creators",
		preview: ["kawalofficial", "salonipatelofficiall", "hyperfitx", "vjgaelyn"],
	},
	{
		name: "Fruti Campaign",
		creators: "7 Creators",
		preview: [
			"kevinalmasifar",
			"hamidbarkzi07",
			"theraghudixitproject",
			"nikhilchinapa",
		],
	},
];
---

<div
	class:list={[
		"w-99.25 max-w-full overflow-hidden rounded-[1rem] border border-wf-dialog-border bg-wf-surface font-sans text-white",
		className,
	]}
>
	<div class="relative px-5 pt-5 pb-4">
		<h3 class="text-center text-[1.25rem] font-medium">
			Add to List <span class="text-wf-count-muted">{"{1}"}</span>
		</h3>
		<button
			type="button"
			aria-label="Close"
			class="absolute top-4 right-4 inline-flex cursor-pointer p-0.5 text-wf-text-muted hover:text-white"
		>
			<Icon name="cross" size="0.875rem" />
		</button>
	</div>

	<ul class="flex list-none flex-col gap-3 px-4 pb-4">
		{
			lists.map((list) => (
				<li class="flex items-center gap-3 rounded-md border border-wf-dialog-border bg-wf-list-row p-3">
					{/* The app's `AvatarGrid` — four 26px tiles on the empty-slot fill. */}
					<span class="grid flex-none grid-cols-2 gap-1">
						{list.preview.map((handle) => (
							<CreatorAvatar
								size="1.625rem"
								radius="0.3125rem"
								handle={handle}
								class="block bg-wf-surface"
							/>
						))}
					</span>

					<span class="flex-auto">
						<span class="block text-[0.9375rem] font-semibold">{list.name}</span>
						<span class="mt-0.5 block text-[0.75rem] text-wf-meta">
							{list.creators}
						</span>
					</span>

					<button
						type="button"
						class="flex-none cursor-pointer rounded-full bg-wf-action px-5 py-1.5 text-[0.75rem] font-semibold text-white"
					>
						Add
					</button>
				</li>
			))
		}
	</ul>

	<div class="border-t border-wf-text-idle px-5 pt-4 pb-5 text-center">
		<button
			type="button"
			class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-wf-action px-5 py-2.5 text-[0.8125rem] font-semibold text-white"
		>
			<svg class="size-4 flex-none" viewBox="0 0 16 16" aria-hidden="true">
				<path
					d="M2.5 4h8m-8 3.5h5m-5 3.5h5m4-3v5m-2.5-2.5h5"
					fill="none"
					stroke="currentColor"
					stroke-width="1.4"
					stroke-linecap="round"></path>
			</svg>
			Create New List
		</button>
	</div>
</div>
