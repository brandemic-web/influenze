---
/**
 * Interactive product-workflow mockup for the hero.
 *
 * The app's screens rendered as real markup (not a flat image) so GSAP can drive
 * them as a narrative: search -> filter -> results -> profile -> list -> share.
 * The whole thing is authored on the app's native 1440x900 canvas and scaled to
 * whatever width the hero gives it — see `.wf-stage` in styles/app-tokens.css.
 *
 * The `StoryStep` list below is the one place the story's step numbers are written
 * down. Several steps are the *same* app screen in a different state, so they
 * share a component and differ only by props — which is how the app has it, and
 * why the folders under screens/ are named after app screens, not after steps.
 *
 * The numbers themselves stay: the beats in scripts/home-page/workflow address
 * layers by `data-wf-screen`, and workflowCards.ts times cards off the same index.
 *
 * Step 2 is absent on purpose. It was the Analyze rail already filled in, and beat
 * 1 animates step 1 into exactly that state in place rather than cutting to it, so
 * no beat ever addressed the layer — it only ever shipped as a hidden duplicate of
 * step 1. `<Analyze results />` is that state, reached as step 3.
 */
import Analyze from "./screens/analyze/Analyze.astro";
import AnalyzedCreator from "./screens/analyze/AnalyzedCreator.astro";
import AddToListDialog from "./screens/analyze/AddToListDialog.astro";
import Lists from "./screens/list/Lists.astro";
import ListDetails from "./screens/list/ListDetails.astro";
import ShareModal from "./screens/share-management/ShareModal.astro";
import StoryStep from "./story/StoryStep.astro";
import WorkflowPointer from "./story/WorkflowPointer.astro";
import WorkflowCard from "./story/WorkflowCard.astro";
import { WORKFLOW_CARDS } from "../../data/workflowCards";

interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["wf-mockup w-full", className]} data-workflow>
	{/* `.wf-stage` positions itself — see the note on the layers in workflow.css. */}
	<div class="wf-stage overflow-hidden rounded-[1.75rem] bg-wf-page">
		<StoryStep step={1} active><Analyze /></StoryStep>
		<StoryStep step={3}><Analyze results /></StoryStep>
		<StoryStep step={4}><AnalyzedCreator tab="about" /></StoryStep>
		<StoryStep step={5}><AnalyzedCreator tab="mediaKit" /></StoryStep>
		<StoryStep step={6}><AddToListDialog /></StoryStep>
		<StoryStep step={7}><Lists /></StoryStep>
		<StoryStep step={8}><ListDetails /></StoryStep>
		<StoryStep step={9}><ListDetails compare /></StoryStep>
		<StoryStep step={10}><ShareModal /></StoryStep>

		<WorkflowPointer />
	</div>

	{/*
		The explainer cards sit outside the stage, not in it. Figma hangs them past
		the app frame's right edge, and the stage clips — it has to, or the screens
		would spill past its rounded corners. So they get their own unclipped layer
		that carries the same canvas geometry. See `.wf-card-layer`.
	*/}
	<div class="wf-card-layer">
		{WORKFLOW_CARDS.map((card) => <WorkflowCard card={card} />)}
	</div>
</div>

<script>
	import "../../scripts/home-page/workflow";
</script>
