---
/**
 * Renders one legal document: preamble, then every section.
 *
 * Numbering is derived here rather than stored, so inserting a clause in
 * data/terms.ts or data/privacy.ts renumbers everything below it. Sections count
 * 1…n (skipping any marked `unnumbered`), clauses count `section.clause`, and
 * sub-points letter (a), (b), (c)…
 */
import type { LegalSection } from "../../data/legal";
import LegalText from "./LegalText.astro";

interface Props {
	preamble: string[];
	sections: (LegalSection & { number: number | null })[];
}

const { preamble, sections } = Astro.props;

const letter = (i: number) => String.fromCharCode(97 + i);

const body = "block text-[0.875rem] leading-[1.8] text-white/65 lg:text-[1rem]";
---

<div class="min-w-0 max-w-185">
	<div class="flex flex-col gap-5 border-b border-white/10 pb-10 lg:gap-6 lg:pb-14">
		{preamble.map((text) => <LegalText text={text} class={body} />)}
	</div>

	{
		sections.map((section) => (
			<section class="pt-10 lg:pt-14" aria-labelledby={section.id}>
				<h2
					id={section.id}
					class="scroll-mt-32 text-[1.125rem] leading-[1.3] font-semibold text-white lg:text-[1.5rem]"
				>
					{section.number !== null && (
						<span class="mr-2.5 tabular-nums text-brand-primary">{section.number}.</span>
					)}
					{section.title}
				</h2>

				{section.intro && (
					<div class="mt-5 flex flex-col gap-4 lg:mt-6">
						{section.intro.map((text) => (
							<LegalText text={text} class={body} />
						))}
					</div>
				)}

				{section.bullets && (
					<ul class="mt-5 flex flex-col gap-4 lg:mt-6">
						{section.bullets.map((text) => (
							<li class="flex gap-3">
								<span
									class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-brand-primary"
									aria-hidden="true"
								/>
								<LegalText text={text} class={body} />
							</li>
						))}
					</ul>
				)}

				{section.clauses && (
					<ol class="mt-5 flex flex-col gap-5 lg:mt-6 lg:gap-6">
						{section.clauses.map((clause, i) => (
							<li class="flex gap-3 lg:gap-4">
								<span class="shrink-0 text-[0.875rem] leading-[1.8] tabular-nums text-brand-primary lg:text-[1rem]">
									{section.number}.{i + 1}
								</span>
								<div class="min-w-0 flex-1">
									<LegalText text={clause.text} class={body} />

									{clause.items && (
										<ol class="mt-3.5 flex flex-col gap-3 lg:mt-4">
											{clause.items.map((item, j) => (
												<li class="flex gap-3">
													<span class="w-6 shrink-0 text-[0.875rem] leading-[1.8] text-ui-muted lg:text-[1rem]">
														({letter(j)})
													</span>
													<LegalText text={item} class={body} />
												</li>
											))}
										</ol>
									)}
								</div>
							</li>
						))}
					</ol>
				)}

				{section.contact && (
					<dl class="mt-6 grid gap-x-6 gap-y-3 rounded-md border border-white/10 bg-surface-dark p-5 sm:grid-cols-[8rem_1fr] lg:mt-7 lg:p-7">
						{section.contact.map((row) => (
							<>
								<dt class="text-[0.8125rem] leading-[1.8] text-white/40 lg:text-[0.9375rem]">
									{row.label}
								</dt>
								<dd class="text-[0.875rem] leading-[1.8] text-white/80 max-sm:-mt-2.5 lg:text-[1rem]">
									{row.href ? (
										<a
											href={row.href}
											class="text-brand-primary underline-offset-4 hover:underline"
										>
											{row.value}
										</a>
									) : (
										row.value
									)}
								</dd>
							</>
						))}
					</dl>
				)}
			</section>
		))
	}
</div>
