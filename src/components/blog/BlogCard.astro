---
/**
 * One post card; the whole card is the link. `data-blog-card` / `data-category` are read by
 * scripts/blog-page/blogFilter.ts, and the featured post gets a card too so its filter isn't empty.
 */
import BlogImage from "./BlogImage.astro";
import type { BlogEntry } from "../../lib/blog-source";
import { formatPublished } from "../../data/blog";

interface Props {
	post: BlogEntry;
}

const { post } = Astro.props;
const published = formatPublished(post.publishedIso);
---

<a
	href={`/blog/${post.slug}`}
	class="group relative flex h-full flex-col rounded-[1.25rem] border border-white/10 bg-white/[0.03] p-5 transition-colors duration-300 hover:border-brand-primary/40 hover:bg-white/[0.06] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary lg:p-7"
	data-blog-card
	data-category={post.category.id}
>
	{/* Same crop as the hero cards so art reads the same everywhere; lazy, below the fold. */}
	<BlogImage
		image={post.hero}
		widths={[400, 600, 800]}
		sizes="(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 92vw"
		ratio={{ width: 1792, height: 1344 }}
		class="aspect-[1792/1344] w-full rounded-[0.625rem] object-cover"
		loading="lazy"
	/>

	<h3
		class="mt-5 text-[1.125rem] leading-[1.3] text-white transition-colors duration-300 group-hover:text-brand-primary lg:mt-6 lg:text-[1.5rem]"
	>
		{post.title}
	</h3>

	<p class="mt-3 line-clamp-3 text-[0.875rem] leading-[1.6] text-white/50 lg:text-[1rem]">
		{post.excerpt}
	</p>

	{/* Pushed to the card's foot so cards of different copy lengths line up. */}
	<span
		class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-6 text-[0.75rem] leading-none text-white/40 lg:pt-8 lg:text-[0.8125rem]"
	>
		<time datetime={post.publishedIso}>{published}</time>
		<span class="h-1 w-1 rounded-full bg-white/25" aria-hidden="true"></span>
		<span>{post.readMinutes} min read</span>
	</span>
</a>
