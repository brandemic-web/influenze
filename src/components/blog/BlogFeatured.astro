---
/**
 * Listing opener: page heading over the featured post in a glass card (`.glass-rim` needs
 * `border-transparent`). Layout mirrors BlogHero.astro so both pages open on the same image shape.
 */
import BlogImage from "./BlogImage.astro";
import BlogAvatar from "./BlogAvatar.astro";
import BlogMeta from "./BlogMeta.astro";
import type { BlogEntry, BlogIndexCopy } from "../../lib/blog-source";

interface Props {
	post: BlogEntry;
	copy: BlogIndexCopy;
}

const { post, copy } = Astro.props;
---

<section class="relative" aria-labelledby="blog-index-title">
	{/* Same wash the post hero and the legal pages open with. */}
	<div
		class="pointer-events-none absolute inset-0 bg-[linear-gradient(179.95deg,#11092B_0%,#6838FF_5.85%,#010101_99.94%)]"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-410.75 px-4 pt-26 pb-10 sm:px-6 lg:px-25 lg:pt-50 lg:pb-16">
		<h1
			id="blog-index-title"
			class="text-center text-[2rem] capitalize leading-[1.1] text-white lg:text-9xl"
		>
			{copy.title}
		</h1>
		<p
			class="mx-auto mt-4 max-w-160 text-center text-[0.875rem] leading-[1.6] text-white/55 lg:mt-5 lg:text-[1.125rem]"
		>
			{copy.sub}
		</p>

		{/* The whole card is the link; `group` lets the title pick up the hover colour. */}
		<a
			href={`/blog/${post.slug}`}
			class="glass-rim group relative mt-10 rounded-[1.25rem] border border-transparent bg-[#0a071885] px-5 py-8 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),inset_0_-1px_0_0_rgba(255,255,255,0.04),0_24px_70px_-12px_rgba(0,0,0,0.55)] backdrop-blur-md backdrop-saturate-150 transition-colors duration-300 hover:bg-[#0a0718b5] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-primary flex flex-col sm:px-8 lg:mt-14 lg:grid lg:grid-cols-[2fr_3fr] lg:items-center lg:gap-10 lg:px-12 lg:py-14"
			data-reveal
			data-reveal-stagger="0.1"
		>
			{/* The 40 column — copy, as on a post page. `contents` below `lg`. */}
			<div class="contents lg:block lg:min-w-0">
				<div class="order-2 flex flex-wrap items-center gap-3">
					<span
						class="rounded-full border border-brand-primary/40 bg-surface-header px-4 py-2 text-[0.6rem] leading-none tracking-[0.12em] uppercase text-brand-primary backdrop-blur-md lg:text-[0.65rem]"
					>
						{post.category.label}
					</span>
				</div>



				<h2
					class="order-3 mt-6 text-[1.875rem] leading-[1.2] text-white transition-colors duration-300 group-hover:text-brand-primary lg:mt-8 lg:text-[2.25rem]"
				>
					{post.title}
				</h2>

				<p
					class="order-5 mt-4 hidden text-[0.875rem] leading-[1.6] text-white/55 lg:order-none lg:mt-6 lg:block lg:text-[1.125rem]"
				>
					{post.excerpt}
				</p>

				{/* Byline and meta — same two rows as the post hero. */}
				<div
					class="order-6 mt-8 border-t border-white/10 pt-6 lg:order-none lg:mt-12 lg:block lg:pr-10"
				>
					<div class="flex items-center gap-3">
						<BlogAvatar
							author={post.author}
							size={48}
							class="h-10 w-10 text-[0.8125rem] lg:h-12 lg:w-12 lg:text-[0.9375rem]"
						/>

						<span class="flex flex-col gap-3">
							<span class="text-[1rem] leading-none font-semibold text-white lg:text-[1.25rem]"
								>{post.author.name}</span
							>
							<span class="text-[0.75rem] leading-none text-white/45 lg:text-[0.875rem]"
								>{post.author.role}</span
							>
						</span>
					</div>

					<BlogMeta
						publishedIso={post.publishedIso}
						updatedIso={post.updatedIso}
						readMinutes={post.readMinutes}
						variant="labelled"
						class="mt-6"
					/>
				</div>
			</div>
			{/* The 60 column — 784×457 on the 1728px grid, like the post hero. */}
			<BlogImage
				image={post.hero}
				widths={[600, 784, 1792]}
				sizes="(min-width: 1024px) 46vw, 92vw"
				class="order-1 mb-6 w-full rounded-[0.875rem] object-cover lg:order-none lg:mb-0"
				loading="eager"
			/>
		</a>
	</div>
</section>

<style>
	/* Masked 1px ring, identical to the pricing panel's rim. Needs `border-transparent`. */
	.glass-rim {
		position: relative;
	}

	.glass-rim::before {
		content: "";
		position: absolute;
		inset: 0;
		padding: 1px;
		border-radius: inherit;
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.55) 0%,
			rgba(255, 255, 255, 0.3) 25%,
			rgba(255, 255, 255, 0.2) 50%,
			rgba(255, 255, 255, 0.3) 75%,
			rgba(255, 255, 255, 0.45) 100%
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		pointer-events: none;
	}
</style>

<script>
	import "../../scripts/reveals";
</script>
