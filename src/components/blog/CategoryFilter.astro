---
/**
 * Category pills. Progressive enhancement: with no JS every card stays
 * visible, so these read as inert labels rather than a broken control.
 */
interface Props {
	categories: readonly string[];
	class?: string;
}

const { categories, class: className = "" } = Astro.props;

const PILL =
	"shrink-0 cursor-pointer rounded-[100px] border px-4 py-2.5 text-[0.75rem] whitespace-nowrap transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary lg:text-[0.875rem]";
const INACTIVE = "border-white/10 bg-surface-card text-white/70 hover:text-white";
const ACTIVE = "border-transparent bg-button-primary text-button-text";
---

{/* -mx-6 px-6 lets the row bleed to the screen edge while scrolling on mobile. */}
<div
	class:list={["-mx-6 flex gap-2.5 overflow-x-auto px-6 lg:mx-0 lg:flex-wrap lg:px-0", className]}
	role="group"
	aria-label="Filter posts by category"
	data-blog-filter
>
	<button type="button" class:list={[PILL, ACTIVE]} data-filter="all" aria-pressed="true">
		All
	</button>
	{
		categories.map((category) => (
			<button
				type="button"
				class:list={[PILL, INACTIVE]}
				data-filter={category}
				aria-pressed="false"
			>
				{category}
			</button>
		))
	}
</div>

<script>
	import "../../scripts/blog-filter";
</script>
