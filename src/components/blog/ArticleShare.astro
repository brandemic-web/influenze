---
/**
 * Share row: copy-link (JS-enhanced; a bare button with no fallback beyond
 * being inert without JS, same precedent as the category filter buttons) plus
 * real share-intent links for LinkedIn, X and Facebook, which work with no JS
 * at all since the prefilled destination lives entirely in the href.
 */
import PlatformBadge from "./PlatformBadge.astro";
import linkedin from "../../assets/icons/common/LinkedIn.svg";
import x from "../../assets/icons/common/X.svg";
import facebook from "../../assets/icons/common/Facebook.svg";
import copyLink from "../../assets/icons/common/copyLink.svg";

interface Props {
	url: string;
	title: string;
	class?: string;
}

const { url, title, class: className = "" } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const LINKS = [
	{
		name: "LinkedIn",
		icon: linkedin,
		href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
	},
	{
		name: "X",
		icon: x,
		href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
	},
	{
		name: "Facebook",
		icon: facebook,
		href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
	},
];

const iconBtn =
	"flex h-11 w-11 items-center justify-center rounded-md border border-white/10 bg-surface-pill transition-colors duration-300 hover:border-brand-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary lg:h-12 lg:w-12";

const badge = "h-5 w-5 lg:h-6 lg:w-6";
---

<div
	class:list={["rounded-md border border-white/10 bg-surface-dark p-5 lg:p-6", className]}
	data-share
>
	<p class="text-[0.875rem] text-white/70 lg:text-[0.9375rem]">Share this read</p>

	<div class="mt-4 flex flex-wrap gap-2.5">
		<button
			type="button"
			class={iconBtn}
			data-copy-link
			data-copy-url={url}
			aria-label="Copy link"
		>
			<PlatformBadge src={copyLink} class={badge} />
		</button>

		{
			LINKS.map((link) => (
				<a
					href={link.href}
					target="_blank"
					rel="noopener noreferrer"
					class={iconBtn}
					aria-label={`Share on ${link.name}`}
				>
					<PlatformBadge src={link.icon} class={badge} />
				</a>
			))
		}
	</div>

	<p
		class="mt-3 text-[0.75rem] text-brand-primary lg:text-[0.8125rem]"
		data-copy-status
		hidden
		aria-live="polite"
	>
		Link copied
	</p>
</div>

<script>
	import "../../scripts/article-share";
</script>
