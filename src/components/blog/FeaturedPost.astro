---
/**
 * The lead post: same content as a card, given a wide two-column treatment.
 * Stacks below `lg`, where it is visually just a slightly larger card.
 */
import { Image } from "astro:assets";
import AuthorByline from "./AuthorByline.astro";
import type { BlogPost } from "../../data/blog";
import { readMinutes } from "../../data/blog";

interface Props {
	post: BlogPost;
}

const { post } = Astro.props;
---

{/* Tagged like a grid card so the category filter hides it too — otherwise it
    would stay put while the grid below it filtered out from under it. */}
<div
	class="rounded-sm bg-linear-to-r from-[#19123A] via-[#19123A] to-[#575757] p-px"
	data-blog-card
	data-category={post.categories.join("|")}
>
	<a
		href={`/blog/${post.slug}`}
		class="group grid gap-5 rounded-sm bg-background-primary p-4 transition-colors duration-300 hover:bg-surface-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary lg:grid-cols-2 lg:items-center lg:gap-10 lg:p-6"
	>
		<Image
			src={post.cover}
			alt={post.coverAlt}
			widths={[600, 1000, 1600]}
			sizes="(min-width: 1024px) 46vw, 92vw"
			class="aspect-16/10 w-full rounded-sm object-cover"
			loading="eager"
		/>

		<div class="flex flex-col lg:pr-6">
			<div class="flex items-center gap-2">
				<p class="w-fit rounded-[100px] bg-button-primary px-3 py-1.5 text-[0.6875rem] text-button-text lg:text-[0.75rem]">
					Featured
				</p>
				<p class="w-fit rounded-[100px] border border-white/10 bg-surface-card px-3 py-1.5 text-[0.6875rem] text-brand-primary lg:text-[0.75rem]">
					{post.categories[0]}
				</p>
			</div>

			<h2
				class="mt-4 text-[1.375rem] leading-[1.2] text-white transition-colors duration-300 group-hover:text-brand-primary lg:mt-6 lg:text-[2.25rem]"
			>
				{post.title}
			</h2>

			<p class="mt-3 text-[0.875rem] leading-6.5 text-[#CECECE]/70 lg:mt-5 lg:text-[1.125rem]">
				{post.excerpt}
			</p>

			<AuthorByline
				author={post.author}
				publishedAt={post.publishedAt}
				readMinutes={readMinutes(post)}
				class="mt-6 lg:mt-9"
			/>
		</div>
	</a>
</div>
