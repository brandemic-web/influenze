---
/**
 * One post card, used in the index grid and the related-posts row. Whole
 * card is a single anchor. Outer card is Pricing's panel look (glass-rim);
 * the category tag is its mid purple panel — see PricingPlans.astro. No
 * `capitalize` on the title — post headlines are sentence-case.
 *
 * `post` is structural (not `BlogPost`) and `readMinutes` is passed in,
 * rather than read off `data/blog.ts`, so this same card works for the
 * index's local posts and the article page's live Sanity posts.
 */
import type { ImageMetadata } from "astro";
import type { Image as SanityImage } from "sanity";
import BlogImage from "./BlogImage.astro";
import AuthorByline from "./AuthorByline.astro";

interface CardPost {
	slug: string;
	title: string;
	cover: ImageMetadata | SanityImage;
	coverAlt?: string;
	categories: string[];
	publishedAt: string;
	author: { name: string; role?: string; avatar: ImageMetadata | SanityImage };
}

interface Props {
	post: CardPost;
	readMinutes: number;
	/** For the featured post's grid twin: stays hidden under "All" (the banner already covers it), only appears once its own category is picked. */
	hideOnAll?: boolean;
}

const { post, readMinutes, hideOnAll = false } = Astro.props;
---

{/* data-category lets the filter script show/hide without re-rendering. */}
<li
	class="rounded-md border border-white/15 bg-[rgba(246,246,244,0.1)]  shadow-[0_8px_32px_rgba(0,0,0,0.18),inset_0_1px_0_rgba(255,255,255,0.18)] backdrop-blur-md backdrop-saturate-150"
	data-blog-card
	data-category={post.categories.join("|")}
	data-hide-on-all={hideOnAll ? "true" : undefined}
	data-reveal-item
	hidden={hideOnAll}
>
	<a
		href={`/blog/${post.slug}`}
		class="group flex h-full flex-col rounded-[1.25rem] p-4 transition-colors duration-300 hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary lg:p-5"
	>
		<div class="aspect-video w-full overflow-hidden rounded-sm">
			<BlogImage
				src={post.cover}
				alt={post.coverAlt ?? ""}
				widths={[400, 800, 1200]}
				sizes="(min-width: 1024px) 30vw, 92vw"
				class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
			/>
		</div>

		<p class="mt-6 w-fit rounded-[1.25rem] border border-white/12 bg-[rgba(73,40,179,0.22)] px-3 py-1.5 text-[0.6875rem] text-white shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),0_12px_40px_-12px_rgba(0,0,0,0.45)] lg:text-[0.75rem]">
			{post.categories[0]}
		</p>

		<AuthorByline
			author={post.author}
			publishedAt={post.publishedAt}
			readMinutes={readMinutes}
			metaOnly
			class="mt-5"
		/>

		<h3 class="mt-4 mb-4 text-[1.25rem] leading-[1.3] text-white transition-colors duration-300 group-hover:text-brand-primary lg:text-[1.625rem]">
			{post.title}
		</h3>
	</a>
</li>
