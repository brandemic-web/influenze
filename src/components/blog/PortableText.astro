---
/**
 * Renders a Sanity post body. Walks blocks itself (no serializer) so the CTA is the real BlogCta.astro,
 * with blank fields falling back to BLOG_CTA; heading ids come from lib/portable-text.ts, as in the rail.
 */
import BlogCta from "./BlogCta.astro";
import { BLOG_CTA } from "../../data/blog-cta";
import type { PortableBlock, PortableCtaBlock, PortableImageBlock } from "../../lib/portable-text";
import { groupBlocks, headingSections, inlineHtml, isTextBlock } from "../../lib/portable-text";

interface Props {
	blocks: PortableBlock[];
}

const { blocks } = Astro.props;

const groups = groupBlocks(blocks);

// Built from the same list the contents rail is built from — same function,
// same order — then read by key as the H2s come past, so the two can't drift.
const sections = headingSections(blocks);
const headingIds = new Map(
	blocks
		.filter((block) => isTextBlock(block) && block.style === "h2")
		.map((block, i) => [block._key ?? `h-${i}`, sections[i]?.id ?? `section-${i}`]),
);

const proseP =
	"mt-5 text-[0.9375rem] leading-[1.8] text-[#CECECE]/70 lg:mt-6 lg:text-[1.0625rem] lg:leading-[1.9]";
const listItem =
	"flex gap-3 text-[0.9375rem] leading-[1.75] text-[#CECECE]/70 lg:gap-4 lg:text-[1.0625rem]";

/** An author who leaves the CTA blank gets the blog's standard one. */
const ctaFrom = (block: PortableCtaBlock) => ({
	heading: block.heading || BLOG_CTA.heading,
	body: block.body || BLOG_CTA.body,
	label: block.label || BLOG_CTA.label,
	href: block.href || BLOG_CTA.href,
	newTab: block.href ? (block.newTab ?? false) : BLOG_CTA.newTab,
});
---

<div class="blog-prose">
	{
		groups.map((group) => {
			if (group.kind === "list") {
				return group.ordered ? (
					<ol class="mt-5 flex list-none flex-col gap-3 lg:mt-7 lg:gap-4">
						{group.items.map((item, i) => (
							<li class={listItem}>
								<span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-purple-ink/50 text-[0.75rem] leading-none font-semibold text-white tabular-nums lg:h-7 lg:w-7 lg:text-[0.8125rem]">
									{i + 1}
								</span>
								<span set:html={inlineHtml(item)} />
							</li>
						))}
					</ol>
				) : (
					<ul class="mt-5 flex list-none flex-col gap-3 lg:mt-7 lg:gap-3.5">
						{group.items.map((item) => (
							<li class={listItem}>
								<span
									class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-primary"
									aria-hidden="true"
								/>
								<span set:html={inlineHtml(item)} />
							</li>
						))}
					</ul>
				);
			}

			const block = group.block;

			if (block._type === "blogCta") {
				return <BlogCta cta={ctaFrom(block as PortableCtaBlock)} />;
			}

			if (block._type === "image") {
				const image = block as PortableImageBlock;
				return (
					image.url && (
						<figure class="my-8 lg:my-14">
							<img
								src={`${image.url}?w=1568&fit=max&auto=format`}
								alt={image.alt ?? ""}
								width={image.dimensions?.width}
								height={image.dimensions?.height}
								class="w-full rounded-md"
								loading="lazy"
								decoding="async"
							/>
							{image.caption && (
								<figcaption class="mt-3 text-[0.75rem] leading-[1.5] text-white/35 lg:text-[0.8125rem]">
									{image.caption}
								</figcaption>
							)}
						</figure>
					)
				);
			}

			if (!isTextBlock(block)) return null;

			// An empty paragraph is how a stray Enter shows up; it would render as
			// a gap nobody asked for.
			const html = inlineHtml(block);
			if (!html.trim()) return null;

			switch (block.style) {
				case "h2":
					return (
						<h2
							id={headingIds.get(block._key ?? "")}
							class="mt-14 scroll-mt-32 text-[1.25rem] leading-[1.2] text-white first:mt-0 lg:mt-20 lg:text-[2.25rem]"
							set:html={html}
						/>
					);

				case "h3":
					return (
						<h3
							class="mt-9 text-[1.125rem] leading-[1.3] font-semibold text-white lg:mt-12 lg:text-md"
							set:html={html}
						/>
					);

				case "blockquote":
					return (
						<figure class="my-9 border-l-2 border-brand-primary pl-5 lg:my-14 lg:pl-8">
							<blockquote
								class="text-[1.0625rem] leading-[1.6] text-white lg:text-[1.5rem] lg:leading-[1.5]"
								set:html={html}
							/>
						</figure>
					);

				default:
					return <p class={proseP} set:html={html} />;
			}
		})
	}
</div>

<style is:global>
	/* Links inside the prose. Scoped to .blog-prose so it can't reach the CTA's
	   own button, which sits in the same stream. */
	.blog-prose p a,
	.blog-prose li a {
		color: var(--color-brand-primary);
		text-underline-offset: 4px;
	}

	.blog-prose p a:hover,
	.blog-prose li a:hover {
		text-decoration: underline;
	}

	/* The inline marks. */
	.blog-prose strong {
		color: #fff;
		font-weight: var(--font-weight-semibold);
	}

	.blog-prose em {
		color: rgb(255 255 255 / 0.85);
	}
</style>
