---
/**
 * Avatar + name/role, and the date · read-time meta line. Used by the article
 * header and the featured-post card. `metaOnly` drops the avatar and name
 * entirely, leaving just the date · read time line — the post cards show only
 * that, not the author. `hideMeta` is the opposite: avatar and name, no date
 * · read time — the featured card shows that line separately, up near its tags.
 * `stacked` (only meaningful with `metaOnly`) breaks date and read time onto
 * two right-aligned lines instead of joining them with " · " — used by the
 * article header's right-hand byline instance.
 */
import type { ImageMetadata } from "astro";
import type { Image as SanityImage } from "sanity";
import BlogImage from "./BlogImage.astro";

interface Props {
	author: { name: string; role?: string; avatar: ImageMetadata | SanityImage };
	/** ISO 8601 — rendered through <time datetime> so it stays machine-readable. */
	publishedAt: string;
	readMinutes: number;
	metaOnly?: boolean;
	hideMeta?: boolean;
	stacked?: boolean;
	class?: string;
}

const {
	author,
	publishedAt,
	readMinutes,
	metaOnly = false,
	hideMeta = false,
	stacked = false,
	class: className = "",
} = Astro.props;

const readable = new Date(publishedAt).toLocaleDateString("en-GB", {
	day: "numeric",
	month: "short",
	year: "numeric",
});
---

{
	metaOnly ? (
		stacked ? (
			<div class:list={["flex flex-col items-end text-right text-[0.75rem] text-white/50 lg:text-[0.875rem]", className]}>
				<time datetime={publishedAt}>{readable}</time>
				<span>{readMinutes} min read</span>
			</div>
		) : (
			<p class:list={["text-[0.75rem] text-white/50 lg:text-[0.875rem]", className]}>
				<time datetime={publishedAt}>{readable}</time>
				<span aria-hidden="true"> · </span>{readMinutes} min read
			</p>
		)
	) : (
		<div class:list={["flex items-center gap-3", className]}>
			<BlogImage
				src={author.avatar}
				alt={author.name}
				width={96}
				height={96}
				class="h-11 w-11 shrink-0 rounded-full object-cover lg:h-13 lg:w-13"
			/>
			<div class="min-w-0">
				<p class="truncate text-[0.9375rem] text-white lg:text-[1.0625rem]">{author.name}</p>
				<p class="truncate text-[0.8125rem] text-white/40 lg:text-[0.9375rem]">{author.role}</p>
				{!hideMeta && (
					<p class="text-[0.75rem] text-white/50 lg:text-[0.875rem]">
						<time datetime={publishedAt}>{readable}</time>
						<span aria-hidden="true"> · </span>{readMinutes} min read
					</p>
				)}
			</div>
		</div>
	)
}