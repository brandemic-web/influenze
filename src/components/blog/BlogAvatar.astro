---
/** The byline disc: the Studio portrait when there is one, the initials otherwise. Sized by `class`. */
import type { BlogAuthor } from "../../data/blog";

interface Props {
	author: BlogAuthor;
	/** Rendered pixel size at its largest, so the CDN crop is sharp on 2× screens. */
	size: number;
	class?: string;
}

const { author, size, class: className = "" } = Astro.props;

// Square crop from the portrait's hotspot; `auto=format` serves WebP/AVIF where taken.
const px = size * 2;
const src = author.avatarUrl && `${author.avatarUrl}?w=${px}&h=${px}&fit=crop&crop=focalpoint&auto=format`;
---

{
	src ? (
		<img
			src={src}
			alt=""
			width={size}
			height={size}
			class={`shrink-0 rounded-full object-cover ${className}`}
			loading="lazy"
			decoding="async"
		/>
	) : (
		<span
			class={`flex shrink-0 items-center justify-center rounded-full bg-purple-soft font-semibold text-surface-dark ${className}`}
			aria-hidden="true"
		>
			{author.initials}
		</span>
	)
}
