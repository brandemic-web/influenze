---
/**
 * One image for a Sanity CDN URL, resized via query params so the srcset lives in one place.
 * `fit=crop` ignores the Studio hotspot, so heroes crop from the centre.
 */
import type { BlogHeroImage } from "../../lib/blog-source";

interface Props {
	image: BlogHeroImage;
	/** Widths to offer the browser. The largest doubles as the fallback `src`. */
	widths: number[];
	sizes: string;
	/** The rendered aspect ratio the crop is cut to. */
	ratio: { width: number; height: number };
	class?: string;
	loading?: "eager" | "lazy";
}

const { image, widths, sizes, ratio, class: className = "", loading = "lazy" } = Astro.props;

const heightFor = (width: number) => Math.round((width * ratio.height) / ratio.width);

// `auto=format` lets the CDN serve WebP/AVIF to browsers that take it.
const resizedUrl = (width: number) =>
	`${image.url}?w=${width}&h=${heightFor(width)}&fit=crop&auto=format`;

const largest = widths.at(-1) ?? 784;
---

{
	image.url && (
		<img
			src={resizedUrl(largest)}
			srcset={widths.map((width) => `${resizedUrl(width)} ${width}w`).join(", ")}
			sizes={sizes}
			alt={image.alt}
			width={largest}
			height={heightFor(largest)}
			class={className}
			loading={loading}
			decoding={loading === "eager" ? "sync" : "async"}
		/>
	)
}
