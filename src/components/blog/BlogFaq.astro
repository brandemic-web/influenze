---
/**
 * Post FAQ: the homepage section's layout, driven by scripts/faq.ts via `data-faq-*` (one list per page).
 * `align="page"` must match the container in pages/blog/[slug].astro; "section" is Faq.astro's gutter;
 * "wide" is the landing pages' 116px design inset, with their 64px section gap on phones. `size="section"` sets the homepage's 55px heading,
 * and `transparent` drops the black fill so a background behind the section shows through.
 */
import type { BlogFaqItem } from "../../data/blog";

interface Props {
	heading: string;
	subcopy: string;
	faqs: BlogFaqItem[];
	align?: "section" | "page" | "wide";
	size?: "post" | "section";
	transparent?: boolean;
	/** The template landing pages set h3; blog posts keep h2. */
	headingTag?: "h2" | "h3";
}

const { heading, subcopy, faqs, align = "section", size = "post", transparent = false, headingTag: Heading = "h2" } = Astro.props;
const CONTAINER = {
	section: "px-6 lg:px-14",
	page: "max-w-410.75 px-6 lg:px-25",
	wide: "px-6 lg:px-29",
};
---

<section
	class:list={["pb-20.5 max-lg:pb-8", align === "wide" ? "max-lg:pt-16" : "max-lg:pt-11", !transparent && "bg-background-primary"]}
	aria-labelledby="blog-faq-heading"
>
	<div
		class:list={[
			"mx-auto flex flex-col gap-5 lg:relative lg:flex-row lg:justify-between lg:gap-10",
			CONTAINER[align],
		]}
	>
		{/* The inset here is the homepage's; on `page` the container already supplies it. */}
		<div
			class:list={[
				"h-fit max-w-full lg:sticky lg:top-38 lg:max-w-120",
				align === "section" ? "px-3" : "",
			]}
		>
			<Heading
				id="blog-faq-heading"
				class:list={[
					"max-w-54 text-md leading-[1.2] capitalize text-white lg:max-w-full",
					size === "section" ? "lg:text-[3.4375rem] lg:leading-16.25" : "lg:text-[2.25rem] lg:leading-[1.2]",
				]}
			>
				{heading}
			</Heading>
			<p class="mt-2 max-w-109 text-[0.875rem] leading-[1.4] text-white/50 lg:mt-3.5 lg:text-[1rem]">
				{subcopy}
			</p>
		</div>

		<div class="flex w-full max-w-196.5 flex-col gap-2.5" data-faq-list>
			{
				faqs.map((faq, i) => (
					<details class="group rounded-sm" open={i === 0} data-faq>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-2.5 rounded-sm bg-[#131212] p-4 lg:p-7.5 [&::-webkit-details-marker]:hidden">
							<span class="text-[0.875rem] leading-[normal] font-semibold text-white [text-box:trim-both_cap_alphabetic] lg:text-[1.125rem]">
								{faq.question}
							</span>
							<svg
								class="h-1.5 w-3 shrink-0 text-white transition-transform group-open:rotate-180"
								viewBox="0 0 12 6"
								fill="none"
								aria-hidden="true"
								data-faq-chevron
							>
								<path d="M1 1l5 4 5-4" stroke="currentColor" stroke-width="1.5" />
							</svg>
						</summary>
						{/* Wrapper so the panel has a height to tween — see scripts/faq.ts. */}
						<div class="overflow-hidden" data-faq-body>
							<p class="p-5 text-[0.875rem] leading-7 text-[#CECECE]/70 lg:p-7.5 lg:text-[1rem]">
								{faq.answer}
							</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<script>
	import "../../scripts/faq";
</script>
