---
/**
 * Contents rail: sections card plus a standing CTA card in one sticky column; below `lg` the same
 * links sit in a fixed bottom bar (blogToc.ts). `data-legal-toc` / `data-toc-link` are read by scripts/legal-toc.ts.
 */
import Button from "../common/Button.astro";
import type { BlogCta } from "../../data/blog";

interface Props {
	sections: { id: string; text: string }[];
	label: string;
	/** The blog's one CTA — see data/blog-cta.ts. */
	cta: BlogCta;
}

const { sections, label, cta } = Astro.props;

// Flex rather than a plain block so a title that wraps hangs under itself
// rather than under its number.
const linkClass =
	"flex gap-2 border-l border-white/10 py-1.5 pl-4 text-[0.9375rem] leading-6 text-white/45 transition-colors hover:border-brand-primary hover:text-white data-active:border-brand-primary data-active:text-brand-primary lg:text-[1rem]";

const cardClass =
	"glass-rim relative rounded-[1.25rem] border border-transparent bg-[#0a071885] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),inset_0_-1px_0_0_rgba(255,255,255,0.04),0_24px_70px_-12px_rgba(0,0,0,0.55)] backdrop-blur-md backdrop-saturate-150";
---

{/* Mobile: the list grows above the button and animates via grid rows, so no measured height. */}
<div class="fixed inset-x-4 bottom-4 z-40 lg:hidden" data-blog-toc>
	<div class={`${cardClass} flex flex-col overflow-hidden`}>
		<div
			id="blog-toc-panel"
			class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out motion-reduce:transition-none in-data-open:grid-rows-[1fr]"
			data-blog-toc-panel
		>
			<nav aria-label={label} class="min-h-0 overflow-hidden">
				<ol class="toc-rail flex max-h-[55vh] flex-col overflow-y-auto px-5 pt-5 pr-4">
					{
						sections.map((section, i) => (
							<li>
								<a href={`#${section.id}`} class={linkClass}>
									<span class="w-4 shrink-0 tabular-nums text-white/30">{i + 1}.</span>
									<span>{section.text}</span>
								</a>
							</li>
						))
					}
				</ol>
			</nav>
		</div>
		<button
			type="button"
			class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-primary"
			aria-expanded="false"
			aria-controls="blog-toc-panel"
			data-blog-toc-toggle
		>
			<span class="text-[1rem] font-semibold text-white">Contents</span>
			<svg
				class="h-1.5 w-3 shrink-0 text-white transition-transform in-data-open:rotate-180"
				viewBox="0 0 12 6"
				fill="none"
				aria-hidden="true"
			>
				<path d="M1 1l5 4 5-4" stroke="currentColor" stroke-width="1.5"></path>
			</svg>
		</button>
	</div>
</div>

{/* Desktop: sticky column. Top offset clears the fixed header. */}
<div class="sticky top-32 hidden h-fit shrink-0 lg:block lg:w-78">
	<nav aria-label={label} class={`${cardClass} p-6`} data-legal-toc>
		<h2 class="mb-4 text-[0.875rem] tracking-[0.14em] uppercase text-white/40">On this page</h2>
		<ol class="toc-rail flex max-h-[calc(100vh-32rem)] flex-col overflow-y-auto pr-1">
			{
				sections.map((section, i) => (
					<li>
						<a href={`#${section.id}`} class={linkClass} data-toc-link={section.id}>
							<span class="w-4 shrink-0 tabular-nums text-white/30">{i + 1}.</span>
							<span>{section.text}</span>
						</a>
					</li>
				))
			}
		</ol>
	</nav>

	<div class={`${cardClass} mt-5 p-6`}>
		<p class="text-[1.25rem] leading-[1.3] font-semibold text-white">{cta.heading}</p>
		<p class="mt-2 text-[1rem] leading-[1.6] text-white/55">{cta.body}</p>
		<Button href={cta.href} newTab={cta.newTab} class="mt-5 w-full">{cta.label}</Button>
	</div>
</div>

<style>
	/* Masked 1px ring, identical to the pricing panel's rim. Needs `border-transparent`. */
	.glass-rim {
		position: relative;
	}

	.glass-rim::before {
		content: "";
		position: absolute;
		inset: 0;
		padding: 1px;
		border-radius: inherit;
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.55) 0%,
			rgba(255, 255, 255, 0.3) 25%,
			rgba(255, 255, 255, 0.2) 50%,
			rgba(255, 255, 255, 0.3) 75%,
			rgba(255, 255, 255, 0.45) 100%
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		pointer-events: none;
	}

	/* The default scrollbar is a light widget on a dark column; px so it doesn't scale with the 1728 grid. */
	.toc-rail {
		scrollbar-width: thin; /* Firefox */
		scrollbar-color: rgb(255 255 255 / 0.14) transparent;
	}

	.toc-rail::-webkit-scrollbar {
		width: 4px;
	}

	.toc-rail::-webkit-scrollbar-track {
		background: transparent;
	}

	.toc-rail::-webkit-scrollbar-thumb {
		background: rgb(255 255 255 / 0.14);
		border-radius: 9999px;
	}

	.toc-rail:hover {
		scrollbar-color: rgb(255 255 255 / 0.3) transparent;
	}

	.toc-rail:hover::-webkit-scrollbar-thumb {
		background: rgb(255 255 255 / 0.3);
	}
</style>

<script>
	import "../../scripts/legal-toc";
	import "../../scripts/blog-page/blogToc";
</script>
