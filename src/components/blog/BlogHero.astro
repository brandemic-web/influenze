---
/**
 * Post header, wrapped in the same glass card the pricing panel uses — the
 * `.glass-rim` masked gradient ring needs `border-transparent` on the element
 * it sits on, so the two travel together.
 *
 * Below `lg` the order is category, date, title, image, excerpt, byline. The copy
 * column goes `display: contents` there, so its children become items of the
 * card's own flex column and the image can sit between the title and the
 * excerpt without being moved in the DOM. `order-*` sets that sequence and
 * `lg:order-none` hands it back to the grid.
 *
 * From `lg` the card is a 40/60 split: copy left, hero image right. The numbers
 * are load-bearing on the 1728px grid — content width 1443px, less the card's
 * `lg:px-12` (96px) and the `lg:gap-10` between the columns (40px), leaves
 * 1307px, so the 60 column renders at exactly 784×457. Change the padding or the
 * gap and the image stops being the size the design asks for. Below `lg` the two
 * stack and the image goes full width.
 *
 * The wash behind it matches the legal hero so a post opens the same way every
 * other interior page does.
 */
import BlogImage from "./BlogImage.astro";
import type { BlogAuthor } from "../../data/blog";
import type { BlogHeroImage } from "../../lib/blog-source";

interface Props {
	category: string;
	title: string;
	excerpt: string;
	author: BlogAuthor;
	readMinutes: number;
	/** ISO 8601, for the `<time>` machine value. */
	publishedIso: string;
	/** The same date, already formatted for reading. */
	published: string;
	hero: BlogHeroImage;
}

const { category, title, excerpt, author, readMinutes, publishedIso, published, hero } =
	Astro.props;
---

<section class="relative" aria-labelledby="blog-title">
	<div
		class="pointer-events-none absolute inset-0 bg-[linear-gradient(179.95deg,#11092B_0%,#6838FF_5.85%,#010101_99.94%)]"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-410.75 px-4 pt-26 pb-10 sm:px-6 lg:px-25 lg:pt-50 lg:pb-16">
		<div
			class="glass-rim relative rounded-[1.25rem] border border-transparent bg-[#0a071885] px-5 py-8 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),inset_0_-1px_0_0_rgba(255,255,255,0.04),0_24px_70px_-12px_rgba(0,0,0,0.55)] backdrop-blur-md backdrop-saturate-150 flex flex-col sm:px-8 lg:grid lg:grid-cols-[2fr_3fr] lg:items-center lg:gap-10 lg:px-12 lg:py-14"
			data-reveal
			data-reveal-stagger="0.1"
		>
			{/*
				The 40 column. `contents` below `lg` — see the note above; `min-w-0`
				from `lg` so a long title wraps instead of widening the column.
			*/}
			<div class="contents lg:block lg:min-w-0">
				<span
					class="order-1 w-fit rounded-full border border-brand-primary/40 bg-surface-header px-4 py-2 text-[0.75rem] leading-none tracking-[0.14em] uppercase text-brand-primary backdrop-blur-md lg:text-[0.875rem]"
				>
					{category}
				</span>

				{/* Mobile only — on desktop the date stays in the byline row. */}
				<time
					datetime={publishedIso}
					class="order-2 mt-4 text-[0.75rem] leading-none text-white/45 lg:hidden"
				>
					{published}
				</time>

				<h1
					id="blog-title"
					class="order-3 mt-6 text-3xl leading-[1.1] text-white lg:order-none lg:mt-8 lg:text-4xl"
				>
					{title}
				</h1>

				<p
					class="order-5 mt-4 text-[0.875rem] leading-[1.6] text-white/55 lg:order-none lg:mt-6 lg:text-[1.125rem]"
				>
					{excerpt}
				</p>

				{/* Byline: author, then read time and date as separated meta. */}
				<div
				class="order-6 mt-8 flex flex-wrap items-center gap-x-4 gap-y-4 border-t border-white/10 pt-6 lg:order-none lg:mt-12 lg:gap-x-3 lg:pt-5 lg:pr-10 lg:gap-y-6"
				>
					<span
						class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-purple-soft text-[0.8125rem] font-semibold text-surface-dark lg:h-12 lg:w-12 lg:text-[0.9375rem]"
						aria-hidden="true"
					>
						{author.initials}
					</span>

					<span class="flex flex-col gap-3">
						<span class="text-[0.875rem] leading-none font-semibold text-white lg:text-[1rem]"
							>{author.name}</span
						>
						<span class="text-[0.75rem] leading-none text-white/45 lg:text-[0.875rem]"
							>{author.role}</span
						>
					</span>

					<span
						class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.75rem] leading-none text-white/45 lg:gap-x-4 lg:text-[0.875rem]"
					>
						{/*
							The date is hidden below `lg`, where it sits above the title
							instead — otherwise it renders twice on a phone. The read time
							stays here at every size, so the dot goes with the date.
						*/}
						<time datetime={publishedIso} class="hidden lg:inline">{published}</time>
						<span class="hidden h-1 w-1 rounded-full bg-white/25 lg:block" aria-hidden="true"></span>
						<span>{readMinutes} min read</span>
					</span>
				</div>
			</div>

			{/*
				The 60 column — 784×457 on the 1728px grid (see the note above). `alt` is
				empty while these are placeholder gradients: decorative art adds nothing to
				a screen reader. Give it a real description when real art lands.
			*/}
			<BlogImage
				image={hero}
				widths={[600, 784, 1568]}
				sizes="(min-width: 1024px) 46vw, 92vw"
				ratio={{ width: 784, height: 457 }}
				class="order-4 mt-8 aspect-[784/457] w-full rounded-[0.875rem] object-cover lg:order-none lg:mt-0"
				loading="eager"
			/>
		</div>
	</div>
</section>

<style>
	/* Masked 1px gradient ring — the pricing panel's rim, kept identical so the
	   two cards read as the same material. Needs `border-transparent`. */
	.glass-rim {
		position: relative;
	}

	.glass-rim::before {
		content: "";
		position: absolute;
		inset: 0;
		padding: 1px;
		border-radius: inherit;
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.55) 0%,
			rgba(255, 255, 255, 0.3) 25%,
			rgba(255, 255, 255, 0.2) 50%,
			rgba(255, 255, 255, 0.3) 75%,
			rgba(255, 255, 255, 0.45) 100%
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		pointer-events: none;
	}
</style>

<script>
	import "../../scripts/reveals";
</script>
