---
/**
 * Post header in a glass card. Below `lg` the copy column is `display: contents` so `order-*` can
 * put the image first; from `lg` the 40/60 grid, padding and gap are sized for a 784×457 image.
 */
import BlogImage from "./BlogImage.astro";
import type { BlogAuthor } from "../../data/blog";
import type { BlogHeroImage } from "../../lib/blog-source";

interface Props {
	category: string;
	title: string;
	excerpt: string;
	author: BlogAuthor;
	readMinutes: number;
	/** ISO 8601, for the `<time>` machine value. */
	publishedIso: string;
	/** The same date, already formatted for reading. */
	published: string;
	hero: BlogHeroImage;
}

const { category, title, excerpt, author, readMinutes, publishedIso, published, hero } =
	Astro.props;
---

<section class="relative" aria-labelledby="blog-title">
	<div
		class="pointer-events-none absolute inset-0 bg-[linear-gradient(179.95deg,#11092B_0%,#6838FF_5.85%,#010101_99.94%)]"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-410.75 px-4 pt-26 pb-10 sm:px-6 lg:px-25 lg:pt-50 lg:pb-16">
		<div
			class="glass-rim relative rounded-[1.25rem] border border-transparent bg-[#0a071885] px-5 py-8 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),inset_0_-1px_0_0_rgba(255,255,255,0.04),0_24px_70px_-12px_rgba(0,0,0,0.55)] backdrop-blur-md backdrop-saturate-150 flex flex-col sm:px-8 lg:grid lg:grid-cols-[2fr_3fr] lg:items-center lg:gap-10 lg:px-12 lg:py-14"
			data-reveal
			data-reveal-stagger="0.1"
		>
			{/* Copy column: `min-w-0` from `lg` so a long title wraps instead of widening it. */}
			<div class="contents lg:block lg:min-w-0">
				<span
					class="order-2 w-fit rounded-full border border-brand-primary/40 bg-surface-header px-4 py-2 text-[0.75rem] leading-none tracking-[0.14em] uppercase text-brand-primary backdrop-blur-md lg:text-[0.65rem]"
				>
					{category}
				</span>

				{/* Mobile only — image, category, title, then this line; the excerpt and byline are hidden. */}
				<p class="order-4 mt-4 text-[0.75rem] leading-none text-white/45 lg:hidden">
					<time datetime={publishedIso}>{published}</time>
					<span class="mx-2 inline-block h-1 w-1 rounded-full bg-white/25 align-middle" aria-hidden="true"></span>
					<span>{readMinutes} min read</span>
				</p>

				<h1
					id="blog-title"
					class="order-3 mt-6 text-[1.875rem] leading-[1.1] text-white lg:order-none lg:mt-8 lg:text-7xl"
				>
					{title}
				</h1>

				<p
					class="order-5 mt-4 hidden text-[0.875rem] leading-[1.6] text-white/55 lg:order-none lg:mt-6 lg:block lg:text-[1.125rem]"
				>
					{excerpt}
				</p>

				{/* Byline: author, then read time and date as separated meta. */}
				<div
					class="order-6 mt-8 hidden flex-wrap items-center gap-x-4 gap-y-4 border-t border-white/10 pt-6 lg:order-none lg:mt-12 lg:gap-x-3 lg:pt-5 lg:pr-10 lg:gap-y-6 lg:flex"
				>
					<span
						class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-purple-soft text-[0.8125rem] font-semibold text-surface-dark lg:h-12 lg:w-12 lg:text-[0.9375rem]"
						aria-hidden="true"
					>
						{author.initials}
					</span>

					<span class="flex flex-col gap-3">
						<span class="text-[0.875rem] leading-none font-semibold text-white lg:text-[1rem]"
							>{author.name}</span
						>
						<span class="text-[0.75rem] leading-none text-white/45 lg:text-[0.875rem]"
							>{author.role}</span
						>
					</span>

					<span
						class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.75rem] leading-none text-white/45 lg:gap-x-4 lg:text-[0.875rem]"
					>
						{/* Date and dot hide below `lg`, where the date sits above the title instead. */}
						<time datetime={publishedIso} class="hidden lg:inline">{published}</time>
						<span class="hidden h-1 w-1 rounded-full bg-white/25 lg:block" aria-hidden="true"></span>
						<span>{readMinutes} min read</span>
					</span>
				</div>
			</div>

			{/* `alt` comes from the Studio's hero image field. */}
			<BlogImage
				image={hero}
				widths={[600, 784, 1568]}
				sizes="(min-width: 1024px) 46vw, 92vw"
				ratio={{ width: 1792, height: 1344 }}
				class="order-1 mb-6 aspect-1792/1344 w-full rounded-[0.875rem] object-cover lg:order-none lg:mb-0"
				loading="eager"
			/>
		</div>
	</div>
</section>

<style>
	/* Masked 1px ring, identical to the pricing panel's rim. Needs `border-transparent`. */
	.glass-rim {
		position: relative;
	}

	.glass-rim::before {
		content: "";
		position: absolute;
		inset: 0;
		padding: 1px;
		border-radius: inherit;
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.55) 0%,
			rgba(255, 255, 255, 0.3) 25%,
			rgba(255, 255, 255, 0.2) 50%,
			rgba(255, 255, 255, 0.3) 75%,
			rgba(255, 255, 255, 0.45) 100%
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		pointer-events: none;
	}
</style>

<script>
	import "../../scripts/reveals";
</script>
