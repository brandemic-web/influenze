---
/**
 * Post header in a glass card. Below `lg` the copy column is `display: contents` so `order-*` can
 * put the image first; from `lg` the 40/60 grid, padding and gap are sized for a 784×457 image.
 */
import BlogImage from "./BlogImage.astro";
import BlogAvatar from "./BlogAvatar.astro";
import BlogMeta from "./BlogMeta.astro";
import { authorHref, type BlogAuthor } from "../../data/blog";
import type { BlogHeroImage } from "../../lib/blog-source";

interface Props {
	category: string;
	title: string;
	excerpt: string;
	author: BlogAuthor;
	readMinutes: number;
	/** ISO 8601. */
	publishedIso: string;
	/** ISO 8601; only passed when later than `publishedIso`. */
	updatedIso?: string;
	hero: BlogHeroImage;
}

const { category, title, excerpt, author, readMinutes, publishedIso, updatedIso, hero } =
	Astro.props;
---

<section class="relative" aria-labelledby="blog-title">
	<div
		class="pointer-events-none absolute inset-0 bg-[linear-gradient(179.95deg,#11092B_0%,#6838FF_5.85%,#010101_99.94%)]"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-410.75 px-4 pt-26 pb-10 sm:px-6 lg:px-25 lg:pt-50 lg:pb-16">
		<div
			class="glass-rim relative rounded-[1.25rem] border border-transparent bg-[#0a071885] px-5 py-8 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),inset_0_-1px_0_0_rgba(255,255,255,0.04),0_24px_70px_-12px_rgba(0,0,0,0.55)] backdrop-blur-md backdrop-saturate-150 flex flex-col sm:px-8 lg:grid lg:grid-cols-[2fr_3fr] lg:items-center lg:gap-10 lg:px-12 lg:py-14"
			data-reveal
			data-reveal-stagger="0.1"
		>
			{/* Copy column: `min-w-0` from `lg` so a long title wraps instead of widening it. */}
			<div class="contents lg:block lg:min-w-0">
				<span
					class="order-2 w-fit rounded-full border border-brand-primary/40 bg-surface-header px-4 py-2 text-[0.6rem] leading-none tracking-[0.14em] uppercase text-brand-primary backdrop-blur-md lg:text-[0.65rem]"
				>
					{category}
				</span>

				

				<h1
					id="blog-title"
					class="order-3 mt-6 text-[1.875rem] leading-[1.1] text-white lg:order-none lg:mt-8 lg:text-7xl"
				>
					{title}
				</h1>

				<p
					class="order-5 mt-4 hidden text-[0.875rem] leading-[1.6] text-white/55 lg:order-none lg:mt-6 lg:block lg:text-[1.125rem]"
				>
					{excerpt}
				</p>

				{/* Byline: author on one row, the labelled dates and read time on the next. */}
				<div
					class="order-6 mt-8 border-t border-white/10 pt-6 lg:order-none lg:mt-12 lg:block lg:pr-10"
				>
					<div class="flex items-center gap-3">
						<BlogAvatar
							author={author}
							size={48}
							class="h-10 w-10 text-[0.8125rem] lg:h-12 lg:w-12 lg:text-[0.9375rem]"
						/>

						<span class="flex flex-col gap-3">
							{
								author.slug ? (
									<a
										href={authorHref(author.slug)}
										class="text-[0.875rem] leading-none font-semibold text-white transition-colors duration-300 hover:text-brand-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary lg:text-[1rem]"
									>
										{author.name}
									</a>
								) : (
									<span class="text-[1rem] leading-none font-semibold text-white lg:text-[1.25rem]">
										{author.name}
									</span>
								)
							}
							<span class="text-[0.75rem] leading-none text-white/45 lg:text-[0.875rem]"
								>{author.role}</span
							>
						</span>
					</div>

					<BlogMeta
						publishedIso={publishedIso}
						updatedIso={updatedIso}
						readMinutes={readMinutes}
						variant="labelled"
						class="mt-6"
					/>
				</div>
			</div>

			{/* `alt` comes from the Studio's hero image field. */}
			<BlogImage
				image={hero}
				widths={[600, 784, 1568]}
				sizes="(min-width: 1024px) 46vw, 92vw"
				class="order-1 mb-6 w-full rounded-[0.875rem] object-cover lg:order-none lg:mb-0"
				loading="eager"
			/>
		</div>
	</div>
</section>

<style>
	/* Masked 1px ring, identical to the pricing panel's rim. Needs `border-transparent`. */
	.glass-rim {
		position: relative;
	}

	.glass-rim::before {
		content: "";
		position: absolute;
		inset: 0;
		padding: 1px;
		border-radius: inherit;
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.55) 0%,
			rgba(255, 255, 255, 0.3) 25%,
			rgba(255, 255, 255, 0.2) 50%,
			rgba(255, 255, 255, 0.3) 75%,
			rgba(255, 255, 255, 0.45) 100%
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		pointer-events: none;
	}
</style>

<script>
	import "../../scripts/reveals";
</script>
