---
/**
 * One H2 per metric, as the playbook asks, so each question is quotable on its own: what it
 * means, both positions (the competitor's beside its source), who benefits, and a check.
 */
import LandingIcon from "./LandingIcon.astro";
import AppVignette from "./AppVignette.astro";
import Icon from "../app/common/Icon.astro";
import { SECTION_ICONS } from "../../data/landing";
import { iconOf, vignetteOf } from "../../lib/landing-source";
import type { LandingPageDoc } from "../../sanity/lib/landingQueries";

interface Props {
	items: NonNullable<LandingPageDoc["deepDives"]>;
	competitorName: string;
	heading: string;
	labels: { meaning: string; ours: string; whoBenefits: string; check: string };
}

const { items, competitorName, heading, labels } = Astro.props;
---

<section id="deep-dives" class="scroll-mt-32 py-10 lg:py-16" aria-label={heading}>
	<div class="mx-auto flex max-w-410.75 flex-col gap-4 px-6 lg:gap-6 lg:px-25">
		{
			items.map((item, i) => {
				if (!item.metric) return null;
				const icon = iconOf(item, SECTION_ICONS.deepDives);
				const visual = vignetteOf(item, icon, true);
				return (
					<article
						class:list={[
							"rounded-[1.25rem] border border-white/10 bg-[#0a071885] p-5 lg:p-10",
							visual && "lg:grid lg:grid-cols-[3fr_2fr] lg:items-center lg:gap-12",
						]}
						data-reveal
					>
						<div class="min-w-0">
						<div class="flex items-center gap-4">
							<LandingIcon icon={icon} />
							<h2 id={`metric-${i + 1}`} class="scroll-mt-32 text-[1.25rem] leading-[1.25] text-white lg:text-[1.875rem]">
								{item.metric}
							</h2>
						</div>
						{item.meaning && (
							<p class="mt-3 max-w-240 text-[0.9375rem] leading-[1.6] text-white/60 lg:text-[1.0625rem]">
								<span class="sr-only">{labels.meaning}: </span>
								{item.meaning}
							</p>
						)}
						<dl class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-6">
							{item.ours && (
								<div class="rounded-md border border-brand-primary/30 bg-brand-primary/6 p-4 lg:p-6">
									<dt class="text-[0.75rem] font-semibold tracking-[0.1em] uppercase text-brand-primary lg:text-[0.8125rem]">{labels.ours}</dt>
									<dd class="mt-2 text-[0.875rem] leading-[1.6] text-white/80 lg:text-[1rem]">{item.ours}</dd>
								</div>
							)}
							{item.theirs && (
								<div class="rounded-md border border-white/10 bg-white/4 p-4 lg:p-6">
									<dt class="text-[0.75rem] font-semibold tracking-[0.1em] uppercase text-white/60 lg:text-[0.8125rem]">{competitorName}</dt>
									<dd class="mt-2 text-[0.875rem] leading-[1.6] text-white/80 lg:text-[1rem]">
										{item.theirs}
										{item.source && (
											<>
												{" "}
												<a href={item.source} target="_blank" rel="noopener noreferrer nofollow" class="text-white/50 underline underline-offset-4 hover:text-brand-primary">
													(source)
												</a>
											</>
										)}
									</dd>
								</div>
							)}
						</dl>
						{(item.whoBenefits || item.check) && (
							<dl class="mt-5 flex flex-col gap-3 border-t border-white/10 pt-5 text-[0.875rem] leading-[1.6] lg:text-[1rem]">
								{item.whoBenefits && (
									<div class="flex gap-2.5">
										<Icon name="usersRound" size="1.125rem" class="mt-0.5 text-ui-lilac" />
										<span>
											<dt class="inline font-semibold text-white">{labels.whoBenefits}: </dt>
											<dd class="inline text-white/65">{item.whoBenefits}</dd>
										</span>
									</div>
								)}
								{item.check && (
									<div class="flex gap-2.5">
										<Icon name="circleCheck" size="1.125rem" class="mt-0.5 text-brand-primary" />
										<span>
											<dt class="inline font-semibold text-brand-primary">{labels.check}: </dt>
											<dd class="inline text-white/65">{item.check}</dd>
										</span>
									</div>
								)}
							</dl>
						)}
						</div>
						{visual && <AppVignette kind={visual} class="mt-6 lg:mt-0" />}
					</article>
				);
			})
		}
	</div>
</section>

<script>
	import "../../scripts/reveals";
</script>
