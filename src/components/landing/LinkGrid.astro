---
/** Internal links as cards — the playbook's cross-linking block. */
import LandingIcon from "./LandingIcon.astro";
import type { LandingLinkItem } from "../../lib/landing-source";

interface Props {
	links: LandingLinkItem[];
}

const { links } = Astro.props;
---

<ul class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3 lg:gap-5">
	{
		links.map((link) => (
			<li data-reveal-item>
				<a
					href={link.href}
					class="group flex h-full flex-col rounded-[1.25rem] border border-white/10 bg-[#0a071885] p-5 transition-colors duration-300 hover:border-brand-primary/50 lg:p-7"
				>
					{link.icon && <LandingIcon icon={{ name: link.icon }} size="sm" class="mb-4" />}
					<span class="text-[1rem] leading-[1.35] font-semibold text-white group-hover:text-brand-primary lg:text-[1.1875rem]">
						{link.label} <span aria-hidden="true">→</span>
					</span>
					{link.description && (
						<span class="mt-2 line-clamp-3 text-[0.8125rem] leading-[1.55] text-white/50 lg:text-[0.9375rem]">
							{link.description}
						</span>
					)}
				</a>
			</li>
		))
	}
</ul>
