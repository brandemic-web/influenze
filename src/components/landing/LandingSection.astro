---
/**
 * The frame every landing section sits in: the blog's page gutters, an H2 and an optional
 * intro. `id` doubles as the anchor the hero's secondary button jumps to.
 */
interface Props {
	id: string;
	heading?: string;
	intro?: string;
	/** For sections whose children carry their own H2s (the comparison deep dives). */
	headingLevel?: "h2" | "h3";
	class?: string;
}

const { id, heading, intro, headingLevel: Tag = "h2", class: className = "" } = Astro.props;
---

<section
	id={id}
	class:list={["scroll-mt-32 py-10 lg:py-16", className]}
	aria-labelledby={heading ? `${id}-heading` : undefined}
	data-reveal
	data-reveal-stagger="0.08"
>
	<div class="mx-auto max-w-410.75 px-6 lg:px-25">
		{
			heading && (
				<Tag id={`${id}-heading`} class="max-w-240 text-[1.5rem] leading-[1.2] text-white lg:text-[2.25rem]">
					{heading}
				</Tag>
			)
		}
		{
			intro && (
				<p class="mt-3 max-w-200 text-[0.9375rem] leading-[1.6] text-white/55 lg:mt-4 lg:text-[1.0625rem]">
					{intro}
				</p>
			)
		}
		<div class:list={[heading || intro ? "mt-6 lg:mt-10" : ""]}>
			<slot />
		</div>
	</div>
</section>

<script>
	import "../../scripts/reveals";
</script>
