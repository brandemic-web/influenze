---
/**
 * A real HTML table — never an image, so answer engines can read it. The first cell of each
 * row is its header. `highlight` tints one column (Influenze.ai's). Scrolls sideways below `md`.
 */
import Icon from "../app/common/Icon.astro";
import CellGraphic from "./CellGraphic.astro";
import { SOURCE_LABEL, type LandingIconName } from "../../data/landing";

export interface TableRow {
	cells: string[];
	/** Drawn beside the row's label. */
	icon?: LandingIconName;
	/** Drawn under the highlighted column's text. */
	graphic?: "platforms" | "credits" | "database";
	source?: string;
}

interface Props {
	caption: string;
	columns: string[];
	rows: TableRow[];
	highlight?: number;
	note?: string;
}

const { caption, columns, rows, highlight, note } = Astro.props;
const hasSources = rows.some((row) => row.source);
// Two columns fit a phone; three or more keep their width and scroll instead of crushing.
const wide = columns.length + (hasSources ? 1 : 0) > 2;
---

<div class="overflow-x-auto rounded-[1.25rem] border border-white/10 bg-[#0a071885]">
	<table class:list={["w-full border-collapse text-left", wide && "min-w-160"]}>
		<caption class="sr-only">{caption}</caption>
		<thead>
			<tr class="border-b border-white/10">
				{
					columns.map((column, i) => (
						<th
							scope="col"
							class:list={[
								"px-4 py-4 text-[0.8125rem] leading-[1.3] font-semibold lg:px-6 lg:py-5 lg:text-[1rem]",
								i === highlight ? "bg-brand-primary/10 text-brand-primary" : "text-white",
							]}
						>
							{column}
						</th>
					))
				}
				{hasSources && <th scope="col" class="px-4 py-4 text-[0.8125rem] font-semibold text-white/50 lg:px-6 lg:text-[0.875rem]">{SOURCE_LABEL}</th>}
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row) => (
					<tr class="border-b border-white/5 transition-colors duration-300 last:border-b-0 hover:bg-white/3" data-reveal-item>
						{row.cells.map((cell, i) =>
							i === 0 ? (
								<th scope="row" class="px-4 py-4 align-top text-[0.8125rem] leading-[1.45] font-semibold text-white lg:px-6 lg:py-5 lg:text-[1rem]">
									<span class="flex items-start gap-3">
										{row.icon && (
											<span class="grid h-7 w-7 shrink-0 place-items-center rounded-md bg-white/6 text-ui-lilac">
												<Icon name={row.icon} size="0.9375rem" />
											</span>
										)}
										<span class:list={[row.icon && "pt-1"]}>{cell}</span>
									</span>
								</th>
							) : (
								<td
									class:list={[
										"px-4 py-4 align-top text-[0.8125rem] leading-[1.5] lg:px-6 lg:py-5 lg:text-[1rem]",
										i === highlight ? "bg-brand-primary/5 text-white" : "text-white/65",
										row.icon && "lg:pt-6",
									]}
								>
									{i === highlight ? (
										<span class="flex items-start gap-2">
											<Icon name="check" size="1rem" class="mt-0.5 text-brand-primary" />
											<span>
												{cell}
												{row.graphic && <CellGraphic kind={row.graphic} />}
											</span>
										</span>
									) : (
										cell
									)}
								</td>
							),
						)}
						{hasSources && (
							<td class="px-4 py-4 align-top text-[0.75rem] lg:px-6 lg:py-5 lg:text-[0.875rem]">
								{row.source && (
									<a href={row.source} target="_blank" rel="noopener noreferrer nofollow" class="text-white/55 underline underline-offset-4 hover:text-brand-primary">
										{new URL(row.source).hostname.replace(/^www\./, "")}
									</a>
								)}
							</td>
						)}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
{note && <p class="mt-4 text-[0.8125rem] leading-[1.6] text-white/45 lg:text-[0.9375rem]">{note}</p>}
