---
/**
 * Numbered workflow steps as an ordered list. `current` marks the step a feature page is
 * about; `compact` is the one-line strip used above the fold.
 */
import BlogImage from "../blog/BlogImage.astro";
import Icon from "../app/common/Icon.astro";
import type { LandingIconRef } from "../../lib/landing-source";
import type { LandingIconName } from "../../data/landing";

export interface StepItem {
	title: string;
	/** A name for the fixed workflow strip; a resolved ref for editor-built steps. */
	icon?: LandingIconRef | LandingIconName;
	body?: string;
	image?: { url: string; alt: string };
}

interface Props {
	steps: StepItem[];
	current?: string;
	compact?: boolean;
}

const { steps, current, compact = false } = Astro.props;
---

<ol
	class:list={[
		"grid gap-4 lg:gap-6",
		compact ? "grid-cols-2 md:grid-cols-3 lg:grid-flow-col lg:auto-cols-fr" : "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
	]}
>
	{
		steps.map((step, i) => {
			const isCurrent = step.title === current;
			const iconName = typeof step.icon === "string" ? step.icon : step.icon && "name" in step.icon ? step.icon.name : undefined;
			return (
				<li
					class:list={[
						"flex flex-col rounded-[1.25rem] border p-5 lg:p-7",
						isCurrent ? "border-brand-primary/50 bg-brand-primary/8" : "border-white/10 bg-[#0a071885]",
					]}
					aria-current={isCurrent ? "step" : undefined}
					data-reveal-item
				>
					{step.image?.url && (
						<BlogImage
							image={step.image}
							widths={[480, 720, 960]}
							sizes="(min-width: 1024px) 30vw, 90vw"
							class="mb-5 w-full rounded-md object-cover"
						/>
					)}
					<span class="flex items-center gap-3">
						<span class="flex h-8 w-8 items-center justify-center rounded-full bg-purple-ink/60 text-[0.8125rem] leading-none font-semibold text-white tabular-nums lg:h-9 lg:w-9">
							{i + 1}
						</span>
						{iconName && <Icon name={iconName} size="1.25rem" class={isCurrent ? "text-brand-primary" : "text-ui-lilac"} />}
					</span>
					<h3 class="mt-4 text-[1rem] leading-[1.3] font-semibold text-white lg:text-[1.25rem]">{step.title}</h3>
					{step.body && !compact && (
						<p class="mt-2 text-[0.875rem] leading-[1.6] text-white/60 lg:text-[1rem]">{step.body}</p>
					)}
				</li>
			);
		})
	}
</ol>
