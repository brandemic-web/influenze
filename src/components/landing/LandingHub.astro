---
/**
 * A prefix's index page — /compare/, /alternatives/, /for/, /platforms/ — listing every
 * published page of one template, so the breadcrumb's middle step always leads somewhere.
 */
import Layout from "../../layouts/Layout.astro";
import LandingSection from "./LandingSection.astro";
import LinkGrid from "./LinkGrid.astro";
import { LANDING_HUBS, landingHref } from "../../data/landing";
import { getLandingList } from "../../sanity/lib/landingQueries";
import { getPerspectiveCookie } from "../../lib/draft-mode";

interface Props {
	type: "comparisonPage" | "alternativePage" | "icpPage" | "platformPage";
}

const { type } = Astro.props;
const copy = LANDING_HUBS[type];
const { data } = await getLandingList(type, getPerspectiveCookie(Astro.cookies));
const links = (data ?? []).flatMap((page) =>
	page.slug && page.title ? [{ label: page.title, href: landingHref(type, page.slug), description: page.summary }] : [],
);
---

<Layout title={copy.metaTitle} description={copy.sub} ctaButtonLabel="Sign Up">
	<main class="bg-background-primary">
		<section class="relative" aria-labelledby="hub-title">
			<div
				class="pointer-events-none absolute inset-0 bg-[linear-gradient(179.95deg,#11092B_0%,#6838FF_5.85%,#010101_99.94%)]"
				aria-hidden="true"
			>
			</div>
			<div class="relative mx-auto max-w-410.75 px-6 pt-32 pb-6 lg:px-25 lg:pt-50 lg:pb-10">
				<h1 id="hub-title" class="max-w-240 text-[2rem] leading-[1.1] text-white lg:text-8xl">{copy.title}</h1>
				<p class="mt-4 max-w-200 text-[0.9375rem] leading-[1.6] text-white/65 lg:mt-6 lg:text-[1.1875rem]">{copy.sub}</p>
			</div>
		</section>

		<LandingSection id="pages">
			{
				links.length ? (
					<LinkGrid links={links} />
				) : (
					<div class="rounded-[1.25rem] border border-white/10 bg-[#0a071885] p-8 lg:p-12">
						<p class="text-[1.125rem] font-semibold text-white lg:text-[1.5rem]">{LANDING_HUBS.empty.title}</p>
						<p class="mt-3 text-[0.9375rem] text-white/55 lg:text-[1.0625rem]">{LANDING_HUBS.empty.body}</p>
					</div>
				)
			}
		</LandingSection>
	</main>
</Layout>
