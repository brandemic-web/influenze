---
/**
 * A responsive grid of cards: title, body, bullets, an optional screenshot and link. `accent`
 * marks the card that speaks for Influenze.ai in a two-way verdict.
 */
import BlogImage from "../blog/BlogImage.astro";
import LandingIcon from "./LandingIcon.astro";
import AppVignette from "./AppVignette.astro";
import type { VignetteKind } from "../../data/landing";
import Icon from "../app/common/Icon.astro";
import type { LandingIconRef } from "../../lib/landing-source";

export interface CardItem {
	title: string;
	icon?: LandingIconRef;
	/** A product graphic drawn above the card's text. */
	visual?: VignetteKind;
	body?: string;
	bullets?: string[];
	linkLabel?: string;
	href?: string;
	image?: { url: string; alt: string };
	/** A small line above the title, e.g. a computed credit total. */
	kicker?: string;
	/** `true` tints the card mint (Influenze.ai's side); `false` draws it as the other side. */
	accent?: boolean;
}

interface Props {
	cards: CardItem[];
	columns?: 2 | 3 | 4;
	/** Number the cards, for steps that read as cards. */
	numbered?: boolean;
}

const { cards, columns = 3, numbered = false } = Astro.props;

const grid = {
	2: "lg:grid-cols-2",
	3: "md:grid-cols-2 lg:grid-cols-3",
	4: "md:grid-cols-2 lg:grid-cols-4",
}[columns];
---

<ul class:list={["grid grid-cols-1 gap-4 lg:gap-6", grid]}>
	{
		cards.map((card, i) => (
			<li
				class:list={[
					"flex flex-col rounded-[1.25rem] border p-5 transition-[transform,border-color] duration-300 hover:-translate-y-1 motion-reduce:hover:translate-y-0 lg:p-8",
					card.accent === true
						? "border-brand-primary/40 bg-[linear-gradient(160deg,rgba(58,255,152,0.08),rgba(10,7,24,0.6))]"
						: "border-white/10 bg-[#0a071885]",
				]}
				data-reveal-item
			>
				{card.image?.url && (
					<BlogImage
						image={card.image}
						widths={[480, 720, 960]}
						sizes="(min-width: 1024px) 30vw, 90vw"
						class="mb-5 w-full rounded-md object-cover"
					/>
				)}
				{card.visual && <AppVignette kind={card.visual} class="mb-5" />}
				{(card.icon || card.kicker || numbered) && (
					<div class="mb-4 flex items-center justify-between gap-3 lg:mb-5">
						{card.icon && <LandingIcon icon={card.icon} tone={card.accent === false ? "muted" : "accent"} />}
						{(card.kicker || numbered) && (
							<span class="text-[0.75rem] leading-none font-semibold tracking-[0.12em] uppercase text-brand-primary lg:text-[0.8125rem]">
								{numbered ? String(i + 1).padStart(2, "0") : card.kicker}
							</span>
						)}
					</div>
				)}
				<h3 class="text-[1.0625rem] leading-[1.3] font-semibold text-white lg:text-[1.375rem]">{card.title}</h3>
				{card.body && (
					<p class="mt-3 text-[0.875rem] leading-[1.6] text-white/60 lg:text-[1rem]">{card.body}</p>
				)}
				{card.bullets?.length ? (
					<ul class="mt-4 flex flex-col gap-2.5">
						{card.bullets.map((bullet) => (
							<li class="flex gap-3 text-[0.875rem] leading-[1.55] text-white/70 lg:text-[1rem]">
								<Icon
									name={card.accent === false ? "info" : "check"}
									size="1rem"
									class:list={["mt-0.5", card.accent === false ? "text-ui-lilac" : "text-brand-primary"]}
								/>
								<span>{bullet}</span>
							</li>
						))}
					</ul>
				) : null}
				{card.href && (
					<a
						href={card.href}
						class="mt-auto pt-5 text-[0.875rem] font-semibold text-brand-primary underline-offset-4 hover:underline lg:text-[1rem]"
					>
						{card.linkLabel || "Learn more"} →
					</a>
				)}
			</li>
		))
	}
</ul>
