---
import wave from "../../assets/images/common/decor/hero_wave.svg";
import { PRICING_HERO } from "../../data/pricing";
---

<section class="relative overflow-hidden bg-background-primary pt-[170px] pb-10 lg:pt-[215px]">
	<img
		src={wave.src}
		alt=""
		class="pointer-events-none absolute inset-x-0 top-[120px] w-full opacity-80"
		loading="eager"
	/>
	<div class="relative mx-auto flex max-w-[770px] flex-col items-center gap-[30px] px-6 text-center">
		<h1 class="text-9xl capitalize leading-[1.1] max-lg:text-6xl max-md:text-3xl">
			<span class="text-brand-primary">{PRICING_HERO.headingAccent}</span><span class="text-white">{PRICING_HERO.headingRest}</span>
		</h1>
		<p class="max-w-[421px] text-[18px] leading-[28px] text-[#696385]">{PRICING_HERO.subcopy}</p>
	</div>
</section>
