---
/**
 * "Use cases for brands and agencies" block — pricing page only.
 *
 * No top padding: the section above already supplies the gap. No decorative
 * swoosh either, since the pricing page has its own background treatment.
 */
import { USE_CASES_SPLIT } from "../../data/useCasesSplit";
import { getPricingPage } from "../../sanity/lib/queries";
import { getPerspectiveCookie } from "../../lib/draft-mode";
import circleCheck from "../../assets/images/home_page/use_cases/circle_check.svg";

const { data: pricing } = await getPricingPage(getPerspectiveCookie(Astro.cookies));
const columns = pricing?.useCasesSplit?.length ? pricing.useCasesSplit : USE_CASES_SPLIT;
---

<section class="relative overflow-hidden lg:overflow-visible" aria-labelledby="use-cases-split-heading">
	<div
		class="relative mx-auto flex max-w-393 flex-col items-center px-6 pb-10 pt-10 lg:px-0 lg:pb-40 lg:pt-0"
	>
		<h2
			id="use-cases-split-heading"
			class="max-w-204 text-center text-md capitalize leading-[1.1] text-white lg:text-[3.4375rem] [text-box:trim-both_cap_alphabetic]"
		>
			Use cases for <br class="max-lg:hidden" /><span class="text-brand-primary block lg:inline">brands and agencies</span>
		</h2>

		<div
			class="relative mt-8 flex w-full flex-col items-center justify-center gap-4 lg:gap-8.5 lg:mt-16.25 lg:flex-row"
			data-reveal
			data-reveal-stagger="0.15"
		>
			{
				columns.map((column) => (
					<article
						class="flex h-auto w-full max-w-2xl flex-col justify-center gap-6 lg:gap-7.5 rounded-md border border-white/15 bg-[rgba(246,246,244,0.1)] shadow-[0_8px_32px_rgba(0,0,0,0.18),inset_0_1px_0_rgba(255,255,255,0.18)] backdrop-blur-md backdrop-saturate-150 px-5 py-7 lg:px-14 lg:py-13"
						data-reveal-item
					>
						<h3 class="text-[1.25rem] capitalize leading-[normal] text-[#F6F6F4] lg:text-[4rem] [text-box:trim-both_cap_alphabetic]">{column.title}</h3>
						<div class="h-px w-full max-w-103.75 bg-white/40"></div>
						<ul class="flex flex-col gap-4">
							{(column.points ?? []).map((point) => (
								<li class="flex items-start lg:items-center gap-3 lg:gap-3.75">
									<img src={circleCheck.src} alt="" class="h-5 w-5 mt-0.5 lg:mt-0 lg:h-6 lg:w-6 shrink-0" loading="lazy" />
									<span class="text-[0.875rem] leading-5.5 lg:text-[1.125rem] lg:leading-9.5 text-white">{point}</span>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	import "../../scripts/reveals";
</script>
