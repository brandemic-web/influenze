---
/**
 * Pricing plan panel — the single interactive section of the pricing page.
 *
 * Layout: a plan stepper (dots + draggable bolt handle on a track) sits above a
 * value box that shows the selected tier's price / credits / add-on, followed by
 * the shared features, "how credits work" table and CTA.
 *
 * Interactivity lives in pricingPlans.ts. Content/config comes from data/pricing.ts.
 * The two are wired purely through `data-*` hooks — keep these in sync with the
 * selectors in pricingPlans.ts if you rename anything:
 *   data-plan-panel   root the script scans for
 *   data-tiers        JSON tier data the value fields are populated from
 *   data-track        stepper rail used to map pointer X → position
 *   data-fill         glowing filled portion of the track
 *   data-handle       draggable/keyboard bolt slider
 *   data-dot          per-tier stop (data-pos = % along track, data-color = notch tint)
 *   data-pointer(-fill) the tent arrow above the value box (tint follows the stop)
 *   data-field        value box element bound to a PricingTier key
 *   data-annual-toggle / data-annual-knob   the annual-billing switch
 */
import { Image } from "astro:assets";
import bolt from "../../assets/images/common/logos_and_icons/footer_logo.svg";
import wave from "../../assets/images/common/decor/wave_bg.svg";
import Button from "../common/Button.astro";
import { SIGNUP_URL } from "../../data/site";
import {
	PRICING_HEADING,
	PRICING_TIERS,
	DEFAULT_TIER_INDEX,
	PLAN_FEATURES,
	CREDIT_COSTS,
	BEST_FOR,
	CREDITS_CARRYOVER,
} from "../../data/pricing";

const initial = PRICING_TIERS[DEFAULT_TIER_INDEX];
const tiersJson = JSON.stringify(PRICING_TIERS);

// Stepper stop positions along the track, matching the Figma spacing
// (first gap is double-width, then even). Kept in sync with PRICING_TIERS order.
const STOPS = [0, 25, 50, 75, 100];

// Fill colour of the pointer notch at each stop, so it matches the panel's
// background gradient at that position. Aligned with STOPS by index.
// (0% reuses the 25% colour — no distinct value was specified for it.)
const POINTER_COLORS = ["#201252", "#201252", "#1a103f", "#1f1150", "#211254"];

// Resting position of the bolt handle on first paint (matches the Figma frame:
// the handle sits between Starter and Growth). Clicking a dot snaps to its stop.
const DEFAULT_POS = 25;
const DEFAULT_POINTER_COLOR = POINTER_COLORS[STOPS.indexOf(DEFAULT_POS)];
---

<section
	class="relative overflow-hidden bg-background-primary pt-[150px] pb-12 lg:pb-52 lg:pt-[200px]"
	aria-labelledby="pricing-heading"
>
	<img
		src={wave.src}
		alt=""
		class="pointer-events-none absolute inset-x-0 inset-y-0 lg:-top-10 top-28 w-full object-cover opacity-80"
		loading="lazy"
	/>

	<h1
		id="pricing-heading"
		class="relative mx-auto max-w-[900px] px-6 text-center text-9xl capitalize leading-[1.1] max-lg:text-6xl max-md:text-4xl"
	>
		<span class="text-white">{PRICING_HEADING.lead}</span><span
			class="text-brand-primary">{PRICING_HEADING.accent}</span
		>
	</h1>

	<div
		class="relative mx-auto mt-12 max-w-[1242px] rounded-[20px] border border-white/15 bg-surface-card px-4 :lg:py-8 py-12 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),inset_0_-1px_0_0_rgba(255,255,255,0.04),0_24px_70px_-12px_rgba(0,0,0,0.55)] backdrop-blur-2xl backdrop-saturate-150 sm:px-6 lg:px-[97px] lg:py-18"
		data-plan-panel
		data-tiers={tiersJson}
	>
		<!-- ── Plan stepper ─────────────────────────────────────────── -->
		<div class="relative" role="radiogroup" aria-label="Choose a plan">
			<!-- rail is inset from both edges so the bolt handle / pointer never
			     overflow the panel at the first (0%) and last (100%) stops -->
			<div class="relative mx-10 h-[44px]" data-track>
				<!-- track base -->
				<span
					class="pointer-events-none absolute inset-x-0 top-1/2 h-[2px] -translate-y-1/2 rounded-full bg-[#000000]"
				></span>
				<!-- filled / glowing portion -->
				<span
					class="pointer-events-none absolute left-0 top-1/2 h-[6px] -translate-y-1/2 rounded-full bg-brand-primary shadow-[0_0_14px_6px_rgba(58,255,152,0.7)] transition-[width] duration-300"
					style={`width:${DEFAULT_POS}%`}
					data-fill></span>

				<!-- dots -->
				{
					STOPS.map((pos, i) => (
						<button
							type="button"
							role="radio"
							aria-checked={
								i === DEFAULT_TIER_INDEX ? "true" : "false"
							}
							aria-label={PRICING_TIERS[i].name}
							class="group absolute top-1/2 z-20 -translate-x-1/2 -translate-y-1/2 rounded-full p-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary"
							style={`left:${pos}%`}
							data-dot
							data-pos={pos}
							data-color={POINTER_COLORS[i]}
						>
							<span class="block size-[19px] rounded-full bg-white" />
						</button>
					))
				}

				<!-- bolt handle -->
				<Image
					src={bolt}
					alt=""
					width="40"
					role="slider"
					aria-label="Drag to choose a plan"
					tabindex="0"
					class="absolute -top-8.75 z-30 w-16.25 -translate-x-1/2 cursor-grab touch-none select-none transition-[left] duration-300 active:cursor-grabbing focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary"
					style={`left:${DEFAULT_POS}%`}
					data-handle
					loading="eager"
					draggable="false"
				/>
			</div>
		</div>

		<!-- ── Value box (with upward pointer to the handle) ────────── -->
		<div
			class="relative mt-12 rounded-[20px] border border-white/15 bg-[rgba(73,40,179,0.18)] px-5 pt-9 pb-8 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),inset_0_-1px_0_0_rgba(255,255,255,0.03),0_12px_40px_-12px_rgba(0,0,0,0.45)] backdrop-blur-2xl backdrop-saturate-150 sm:px-8 lg:pl-14 lg:pr-10"
		>
			<!-- pointer tent aimed at the bolt handle (same rail inset as the
			     stepper track so it tracks the handle at every stop) -->
			<div
				class="pointer-events-none absolute inset-x-10 top-[-15px] z-10"
			>
				<svg
					class="absolute -translate-x-1/2 transition-[left] duration-300"
					style={`left:${DEFAULT_POS}%`}
					width="30"
					height="18"
					viewBox="0 0 30 18"
					fill="none"
					aria-hidden="true"
					data-pointer
				>
					<!-- opaque fill overlaps ~3px into the box to mask the top
					     border segment beneath the arrow; colour is swapped per
					     stop by the script to match the panel gradient -->
					<path
						d="M2 18 L2 15 L15 2 L28 15 L28 18 Z"
						fill={DEFAULT_POINTER_COLOR}
						data-pointer-fill></path>
					<!-- only the two rising edges are stroked, so they read as a
					     continuation of the box border rather than a closed triangle -->
					<path
						d="M2 15 L15 2 L28 15"
						stroke="rgba(255,255,255,0.15)"
						stroke-width="1"
						fill="none"></path>
				</svg>
			</div>

			<!-- Annual toggle (visual only for now) -->
			<div class="flex items-center gap-2">
				<span class="text-[16px] text-white">Annual</span>
				<button
					type="button"
					role="switch"
					aria-checked="false"
					aria-label="Toggle annual billing"
					class="flex h-6 w-10 items-center rounded-full bg-[rgba(144,120,255,0.2)] p-1 transition-colors aria-checked:bg-brand-primary"
					data-annual-toggle
				>
					<span
						class="size-4 rounded-full bg-white shadow-sm transition-transform data-[on=true]:translate-x-4"
						data-annual-knob
						data-on="false"></span>
				</button>
			</div>

			<!-- Three value columns -->
			<div
				class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-0"
			>
				<div class="sm:flex-1 sm:pr-8">
					<p
						class="text-[42px] leading-none text-white sm:text-[58px]"
						data-field="price"
					>
						{initial.price}
					</p>
					<p
						class="mt-4 text-[16px] text-white"
						data-field="priceUnit"
					>
						{initial.priceUnit}
					</p>
				</div>
				<span
					class="hidden w-px self-center bg-[#FFFFFF4D] sm:block sm:h-[82px]"
				></span>
				<div class="sm:flex-1 sm:px-8">
					<p
						class="text-[42px] leading-none text-white sm:text-[58px]"
						data-field="credits"
					>
						{initial.credits}
					</p>
					<p
						class="mt-4 text-[16px] text-brand-primary"
						data-field="creditsBonus"
					>
						{initial.creditsBonus}
					</p>
				</div>
				<span
					class="hidden w-px self-center bg-[#FFFFFF4D] sm:block sm:h-[82px]"
				></span>
				<div class="sm:flex-1 sm:pl-8">
					<p
						class="text-[42px] leading-none text-brand-primary sm:text-[58px]"
						data-field="addOn"
					>
						{initial.addOn}
					</p>
					<p
						class="mt-4 max-w-[223px] text-[16px] text-white"
						data-field="addOnNote"
					>
						{initial.addOnNote}
					</p>
				</div>
			</div>

			<!-- divider between the value row and the features section -->
			<span class="mt-9 block h-px w-full bg-[#FFFFFF4D]"></span>

			<!-- Features + carryover card -->
			<div
				class="mt-9 flex flex-col gap-1 md:flex-row md:items-start md:justify-between"
			>
				<div class="max-w-[600px]">
					<h2 class="text-[18px] text-brand-primary">
						FEATURES ALL PLANS GET
					</h2>
					<ul class="mt-5 flex flex-wrap gap-2">
						{
							PLAN_FEATURES.map((feature) => (
								<li class="rounded-[5px] border border-white/15 bg-[#0A071866] px-5 py-2 text-[18px] capitalize text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.2),0_4px_12px_rgba(0,0,0,0.15)] backdrop-blur-md">
									{feature}
								</li>
							))
						}
					</ul>
				</div>

				<div class="flex items-center -mr-5">
					<Image
						src={bolt}
						alt=""
						width="70"
						class="-mr-14 hidden w-[110px] shrink-0 md:block relative z-3"
						loading="lazy"
					/>
					<div
						class="w-full lg:max-w-[600px] max-w-[300px] rounded-[8px] border border-white/15 bg-[#0A071866] px-4 py-2 text-[18px] capitalize text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.2),0_4px_12px_rgba(0,0,0,0.15)] backdrop-blur-md p-5 lg:px-[28px] lg:py-[34px]"
					>
						<h3 class="text-[15px] font-bold text-white">
							{CREDITS_CARRYOVER.title}
						</h3>
						<p
							class="mt-3 text-[13px] leading-[21px] text-white/60"
						>
							{CREDITS_CARRYOVER.body}
						</p>
					</div>
				</div>
			</div>
		</div>

		<!-- ── How credits work · Best for · CTA ─────────────────────── -->
		<div
			class="mt-10 flex flex-col gap-10 px-1 sm:px-16 md:flex-row md:items-start md:gap-[93px]"
		>
			<!-- Wrapper 1: How credits work -->
			<div class="w-full max-w-[342px]">
				<h2 class="text-[18px] text-brand-primary">HOW CREDITS WORK</h2>
				<ul class="mt-4 flex flex-col gap-[7px]">
					{
						CREDIT_COSTS.map((row) => (
							<li class="flex items-center justify-between gap-4">
								<span class="flex items-center gap-1.5 text-[14.5px] text-[#f4f4ff]">
									{row.label}
									<svg
										class="size-[13px] shrink-0 text-[#BFABFF]"
										viewBox="0 0 24 24"
										fill="none"
										aria-hidden="true"
									>
										<circle
											cx="12"
											cy="12"
											r="10"
											stroke="currentColor"
											stroke-width="2"
										/>
										<path
											d="M12 16v-4M12 8h.01"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
										/>
									</svg>
								</span>
								<span class="shrink-0 rounded-[6px] bg-[#255f3c] px-[8px] py-[3px] text-[14.5px] text-[#a1ffce]">
									{row.cost}
								</span>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Wrapper 2: Best for + CTA -->
			<div class="flex flex-1 flex-col lg:gap-20.25 gap-5 sm:flex-row sm:items-end ">
				<div>
					<h2 class="text-[18px] text-brand-primary">BEST FOR</h2>
					<span
						class="mt-4 inline-block rounded-[5px] border border-white/10 border-t-white/25 bg-gradient-to-b from-white/[0.04] to-black/10 px-[14px] py-2 text-[18px] capitalize text-white shadow-[0_8px_20px_rgba(0,0,0,0.35),inset_0_1px_0_rgba(255,255,255,0.15),inset_0_-1px_0_rgba(0,0,0,0.3)] backdrop-blur-md"
					>
						{BEST_FOR}
					</span>
				</div>

				<div class="md:pb-0">
					<Button href={SIGNUP_URL}>Sign Up</Button>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { initPricingPlans } from "./pricingPlans";

	initPricingPlans();
</script>
