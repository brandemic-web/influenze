---
/**
 * Pricing panel. Tier tabs above a card with a draggable spend slider: dragging picks
 * a monthly spend, and the active tab, price and credits all derive from it. Selecting
 * a tab jumps to that tier's stop; Enterprise has no self-serve price, so it swaps the
 * price row for a "talk to us" block.
 *
 * Interactivity is in pricingPlans.ts, the maths in pricingModel.ts (shared, so first
 * paint and drag agree), content in data/pricing.ts — see the PLACEHOLDER note there.
 *
 * Wired purely through `data-*` hooks; keep these in step with pricingPlans.ts:
 *   data-plan-panel   root the script scans for
 *   data-tiers        JSON tier data the derived values are computed from
 *   data-tab          tier tab (data-index = position in PRICING_TIERS)
 *   data-track        slider rail used to map pointer X → position
 *   data-fill         glowing filled portion of the track
 *   data-handle       draggable/keyboard bolt slider
 *   data-dot          per-tier stop (data-pos = % along track)
 *   data-field        element bound to a derived value (price/credits/…)
 *   data-panel        "price" | "custom" — which body the active tier shows
 *   data-annual-toggle / data-annual-knob   the annual-billing switch
 */
import { Image } from "astro:assets";
import bolt from "../../assets/images/common/logos_and_icons/footer_logo.webp";
import wave from "../../assets/images/common/decor/wave_bg.svg";
import { APP_URL } from "../../data/site";
import {
  PRICING_HEADING,
  PRICING_TIERS,
  DEFAULT_SPEND,
  SLIDER_MIN,
  SLIDER_MAX,
  PLAN_FEATURES,
  CREDIT_COSTS,
  CUSTOM_PLAN,
  PRICE_NOTE,
  ANNUAL_LABEL,
  ANNUAL_BONUS_PCT,
  CREDITS_ROLLOVER,
  SUBSCRIBE_LABEL,
} from "../../data/pricing";
import {
  stopPositions,
  VISIBLE_DOTS,
  CAPTION_STOP,
  posFromSpend,
  tierIndexFromSpend,
  creditsFor,
  bonusLabel,
  formatPrice,
  formatAmount,
} from "../../scripts/pricing-page/pricingModel";

const tiersJson = JSON.stringify(PRICING_TIERS);
const stops = stopPositions();

/** One caption per visible dot, labelling that tier's entry price. */
const railCaptions = stops.slice(0, VISIBLE_DOTS).map((pos, i) => ({
  pos,
  label:
    (i === 0 ? "Rs. " : "Rs. ") +
    formatAmount(PRICING_TIERS[i].minSpend) +
    (i === CAPTION_STOP ? "" : ""),
}));

// First paint derives from DEFAULT_SPEND, so the markup already matches what the
// script would compute and the panel is correct without JS.
const initialIndex = tierIndexFromSpend(DEFAULT_SPEND);
const initialTier = PRICING_TIERS[initialIndex];
const initialPos = posFromSpend(DEFAULT_SPEND);
const initialCredits = creditsFor(DEFAULT_SPEND, initialTier);
---

<section
  class="relative overflow-hidden pt-26 pb-12 lg:pt-50 lg:pb-32"
  aria-labelledby="pricing-heading"
  data-plan-panel
  data-tiers={tiersJson}
  data-default-spend={DEFAULT_SPEND}
>
  <img
    src={wave.src}
    alt=""
    class="pointer-events-none absolute inset-x-0 inset-y-0 top-0 h-[60%] w-full object-cover opacity-80 lg:-top-10 lg:h-auto"
    loading="lazy"
  />

  {/* ── Heading ───────────────────────────────────────────────────── */}
  <h1
    id="pricing-heading"
    class="relative mx-auto max-w-225 px-6 text-center text-9xl capitalize leading-[1.1] max-lg:text-4xl max-md:text-[1.875rem] max-md:leading-[1.2] max-md:tracking-[-0.0375rem] lg:mx-auto"
  >
    <span class="block text-white">{PRICING_HEADING.lead}</span><span
      class="block text-brand-primary">{PRICING_HEADING.accent}</span
    >
  </h1>
  <p
    class="relative mt-1.25 text-center text-[1rem] capitalize text-white lg:text-[1.125rem]"
  >
    {PRICING_HEADING.sub}
  </p>

  {/*
    ── Tier tabs ───────────────────────────────────────────────────
    From `lg` the row is sized to the slider rail below it, so each tab sits over the
    stretch of rail its tier covers. The padding mirrors the rail's width: card border
    + card padding + wrapper margin — keep in step with the card's `px-*` and the
    rail's `mx-*`. Below `lg` the design is one segmented pill instead, so the per-tab
    gradient ring only switches on from `lg` up.
  */}
  <div
    class="relative mx-3 mt-8 grid max-w-6xl grid-cols-4 items-center rounded-full border border-brand-primary bg-surface-pill lg:mx-auto lg:mt-10 lg:gap-3 lg:rounded-none lg:border-none lg:bg-transparent lg:px-30.5"
    role="tablist"
    aria-label="Choose a plan"
  >
    {/*
			From `lg` up these copy Button.astro's "nav" variant — a gradient "border"
			whose padding reveals a ring around a dark inner span. Button.astro can't be
			reused: it renders an <a> with no selected state, and a tablist needs
			<button>s. Keep in sync with that variant. Selected drops the gradient so ring
			and fill match and the pill reads as borderless.

			Below `lg` the ring belongs to the row, not the tab, so the gradient and
			its padding are switched off and only the selected fill remains. The
			inactive span keeps the row's own surface colour, so it reads as bare
			until it is picked. Sizing is the mobile Figma's: full column width,
			py-0.9375rem, 12px text in sentence case.
		*/}
    {
      PRICING_TIERS.map((tier, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === initialIndex ? "true" : "false"}
          class="group inline-flex w-full cursor-pointer rounded-full transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary aria-selected:bg-button-primary lg:bg-linear-to-r lg:from-brand-primary lg:to-[#0F5B33] lg:p-[0.09375rem] lg:transition-[transform,--tw-gradient-from,--tw-gradient-to] lg:hover:from-brand-primary lg:hover:to-brand-primary lg:aria-selected:bg-none"
          data-tab
          data-index={i}
        >
          <span class="inline-flex w-full items-center justify-center rounded-full bg-surface-pill py-3.75 text-[0.75rem] leading-none text-white transition-colors duration-300 group-hover:bg-brand-primary group-hover:text-button-text group-aria-selected:bg-button-primary group-aria-selected:text-button-text lg:px-14 lg:py-4.5 lg:text-xs lg:uppercase">
            {tier.name}
          </span>
        </button>
      ))
    }
  </div>

  {/* ── Panel card ────────────────────────────────────────────────── */}
  <div
    class="glass-rim relative mx-3 mt-4.5 max-w-6xl rounded-[1.25rem] border border-transparent bg-[#0a071885] px-4 pt-5 pb-9 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),inset_0_-1px_0_0_rgba(255,255,255,0.04),0_24px_70px_-12px_rgba(0,0,0,0.55)] sm:px-6 lg:mx-auto lg:mt-11 lg:px-24.25 lg:pt-14 lg:pb-14"
  >
    {/* ── Spend slider ──────────────────────────────────────────── */}
    <div class="relative mx-3 lg:mx-6">
      <div class="relative h-11" data-track>
        {/* track base */}
        <span
          class="pointer-events-none absolute inset-x-0 top-1/2 h-1.25 -translate-y-1/2 rounded-full bg-black/25 lg:h-1.75"
        ></span>
        {/* filled / glowing portion */}
        <span
          class="pointer-events-none absolute left-0 top-1/2 h-1.25 -translate-y-1/2 rounded-full bg-brand-primary shadow-[0_0_14px_6px_rgba(58,255,152,0.5)] transition-[width] duration-300 lg:h-1.75"
          style={`width:${initialPos}%`}
          data-fill></span>

        {/* One dot per tier stop; the rail runs on past the last one. */}
        {
          stops.slice(0, VISIBLE_DOTS).map((pos, i) => (
            <button
              type="button"
              tabindex="-1"
              aria-hidden="true"
              class="absolute top-1/2 z-20 -translate-x-1/2 -translate-y-1/2 cursor-pointer rounded-full p-2"
              style={`left:${pos}%`}
              data-dot
              data-pos={pos}
              data-index={i}
            >
              <span class="block size-3 rounded-full bg-white lg:size-4.75" />
            </button>
          ))
        }

        {/*
          Bolt handle. `alt` is non-empty on purpose: an empty one maps the <img> to
          `role="presentation"`, which cannot be focusable or carry ARIA state. The
          announced name still comes from `aria-label`.
        */}
        <Image
          src={bolt}
          alt="Monthly spend"
          widths={[64, 130]}
          sizes="(min-width: 1024px) 65px, 32px"
          role="slider"
          aria-label="Drag to choose your monthly spend"
          aria-valuemin={SLIDER_MIN}
          aria-valuemax={SLIDER_MAX}
          aria-valuenow={DEFAULT_SPEND}
          aria-valuetext={`${formatPrice(DEFAULT_SPEND)} per month — ${initialTier.name}`}
          tabindex="0"
          class="absolute -top-1.75 z-30 w-8 -translate-x-1/2 cursor-grab touch-none select-none transition-[left] duration-300 active:cursor-grabbing focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary lg:-top-6 lg:w-16.25"
          style={`left:${initialPos}%`}
          data-handle
          loading="eager"
          draggable="false"
        />
      </div>

      {/*
				Rail captions — positioned on each dot's centre rather than spaced. The
				first hugs the left edge, since centring would push it off the rail.
				Four labels across a phone-width rail collide at the desktop text size,
				so they shrink below `lg` instead of dropping the two middle ones.
			*/}
      <div
        class="relative mt-1 h-5 text-[0.5rem] text-brand-primary lg:text-[1.125rem]"
      >
        {
          railCaptions.map((caption, i) => (
            <span
              class:list={[
                "absolute whitespace-nowrap",
                i === 0 ? "left-0" : "-translate-x-1/2",
              ]}
              style={i === 0 ? undefined : `left:${caption.pos}%`}
            >
              {caption.label}+
            </span>
          ))
        }
      </div>
    </div>

    {/*
      ── Plan body ─────────────────────────────────────────────────
      One card, two swappable content states (price/credits vs. the
      Enterprise "talk to us" block)
    */}
    <div
      class="relative mt-7 flex flex-col justify-center rounded-[1.25rem] border border-white/12 bg-[rgba(73,40,179,0.22)] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),0_12px_40px_-12px_rgba(0,0,0,0.45)] lg:mt-9 lg:min-h-86"
    >
      {/* Price / credits (all tiers except Enterprise) */}
      <div
        class="px-6.5 py-6 lg:px-7 lg:pt-10 lg:pb-8"
        data-panel="price"
        hidden={initialTier.custom}
      >
        <div
          class="flex flex-col gap-5.5 lg:flex-row lg:items-start lg:justify-between lg:gap-9"
        >
          {/* price + annual toggle */}
          <div class="pl-0 lg:pl-9.5">
            <p class="flex items-baseline text-white">
              <span
                class="text-[2.5rem] leading-none lg:text-[3.625rem]"
                data-field="price">{formatPrice(DEFAULT_SPEND)}</span
              >
              <span class="ml-1 text-[1.125rem] text-white lg:text-[1rem]"
                >/mo</span
              >
            </p>
            <p class="mt-1 text-[0.875rem] text-white lg:mt-4 lg:text-[1rem]">
              {PRICE_NOTE}
            </p>

            <div class="mt-5 flex items-center gap-2 lg:gap-3 lg:mt-7">
              <button
                type="button"
                role="switch"
                aria-checked="false"
                aria-label="Pay annually"
                class="flex h-6 w-10 shrink-0 cursor-pointer items-center rounded-full bg-white/20 p-1 transition-colors aria-checked:bg-brand-primary"
                data-annual-toggle
              >
                <span
                  class="size-4 rounded-full bg-white shadow-sm transition-transform data-[on=true]:translate-x-4"
                  data-annual-knob
                  data-on="false"></span>
              </button>
              <span class="text-[0.75rem] text-white lg:text-[1rem]"
                >{ANNUAL_LABEL}{" "}<span class="text-brand-primary"
                  >+{ANNUAL_BONUS_PCT}% credits</span
                ></span
              >
            </div>
          </div>

          {/*
            credits + rollover

            The bolt hangs off the credits box's edge — its left one from `lg`,
            its right one below, per Figma. The wrapper is width-matched to the
            box on mobile so `right-0` anchors to the box rather than to the
            full column.
          */}
          <div class="flex flex-col items-start lg:shrink-0 lg:block">
            <div
              class="relative flex w-auto items-start justify-start lg:w-auto lg:justify-end"
            >
              <Image
                src={bolt}
                alt=""
                width="80"
                class="pointer-events-none absolute -top-4.5 right-0 z-10 w-20 translate-x-1/2 lg:-top-3 lg:right-auto lg:left-0 lg:w-22 lg:-translate-x-1/2"
                loading="lazy"
              />
              <div
                class="w-full rounded-[0.9375rem] bg-surface-card pl-3 pr-7 py-4.5 text-center shadow-[inset_0_1px_0_rgba(255,255,255,0.12)] lg:rounded-md lg:border lg:border-white/10 lg:bg-black/35 lg:py-4 lg:pr-7 lg:pl-10 lg:text-left"
              >
                <p
                  class="text-[2.5rem] leading-none text-brand-primary lg:text-[3.625rem]"
                  data-field="credits"
                >
                  {formatAmount(initialCredits)}
                </p>
                <p
                  class="mt-1 whitespace-nowrap text-[0.75rem] text-brand-primary lg:mt-2 lg:text-[1rem]"
                  data-field="creditsBonus"
                >
                  {bonusLabel(initialTier)}
                </p>
              </div>
            </div>

            <div
              class="mt-5 w-full flex items-center justify-start gap-2.5 lg:mt-4 lg:justify-end"
            >
              <span
                class="inline-flex w-full items-center justify-center gap-2 rounded-[100px] border border-white/10 bg-surface-card px-4 py-2.75 text-[0.75rem] capitalize text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] lg:w-auto lg:gap-2.5 lg:py-3 lg:text-[1rem]"
              >
                <svg
                  class="size-5 shrink-0 text-brand-primary lg:size-4.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
                  ></path>
                  <path d="M3 3v5h5"></path>
                  <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"
                  ></path>
                  <path d="M16 16h5v5"></path>
                </svg>
                {CREDITS_ROLLOVER}
              </span>
            </div>
          </div>
        </div>

        {/* Subscribe */}
        <a
          href={APP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 flex w-full items-center justify-center gap-2.5 rounded-full bg-button-primary px-6 py-3.75 text-[0.75rem] leading-none text-button-text transition-colors duration-300 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary lg:mt-5.5 lg:gap-1 lg:py-2.5 lg:text-[1rem]"
        >
          {SUBSCRIBE_LABEL}
          <svg
            class="size-3 shrink-0 lg:size-7.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      {/*
        Custom (Enterprise tier)
      */}
      <div
        class="px-6.5 py-6 lg:px-7 lg:pt-10 lg:pb-8"
        data-panel="custom"
        hidden={!initialTier.custom}
      >
        <div
          class="flex flex-col gap-0 lg:flex-row lg:items-start lg:justify-between lg:gap-9"
        >
          {/* "Custom" in the price slot + what the tier adds */}
          <div class="pl-0 lg:pl-9.5">
            <p class="flex items-baseline text-white">
              <span class="text-[2.5rem] leading-none lg:text-[3.625rem]"
                >{CUSTOM_PLAN.priceLabel}</span
              >
              <span class="ml-1 text-[1.125rem] text-white lg:text-[1rem]"
                >{CUSTOM_PLAN.priceSuffix}</span
              >
            </p>
            <p class="mt-1 text-[0.875rem] text-white lg:mt-4 lg:text-[1rem]">
              {PRICE_NOTE}
            </p>

            {/*
              Spacer standing in for the price body's annual toggle, so the credits box
              starts at the same height in both bodies while stacked. Keep in step with
              that toggle row's `mt-*` and height.
            */}
            <div class="h-16.5 lg:hidden"></div>
          </div>

          {/* credits + qualifier badge — mirrors the price body's column */}
          <div class="flex flex-col items-start lg:shrink-0 lg:block">
            <div
              class="relative flex w-auto items-start justify-start lg:w-auto lg:justify-end"
            >
              <Image
                src={bolt}
                alt=""
                width="80"
                class="pointer-events-none absolute -top-4.5 right-0 z-10 w-20 translate-x-1/2 lg:-top-3 lg:right-auto lg:left-0 lg:w-22 lg:-translate-x-1/2"
                loading="lazy"
              />
              <div
                class="w-full rounded-[0.9375rem] bg-surface-card py-4.5 pr-7 pl-3 text-center shadow-[inset_0_1px_0_rgba(255,255,255,0.12)] lg:rounded-md lg:border lg:border-white/10 lg:bg-black/35 lg:py-4 lg:pr-7 lg:pl-10 lg:text-left"
              >
                <p
                  class="text-[2.5rem] leading-none text-brand-primary lg:text-[3.625rem]"
                >
                  {formatAmount(SLIDER_MAX)}+
                </p>
                <p
                  class="mt-1 whitespace-nowrap text-[0.75rem] text-brand-primary lg:mt-2 lg:text-[1rem]"
                >
                  {CUSTOM_PLAN.creditsCaption}
                </p>
              </div>
            </div>

            <div
              class="mt-5 flex w-full items-center justify-start gap-2.5 lg:mt-4 lg:justify-end"
            >
              <span
                class="inline-flex w-full items-center justify-center gap-2 rounded-[100px] border border-white/10 bg-surface-card px-4 py-2.75 text-[0.75rem] capitalize text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] lg:w-auto lg:gap-2.5 lg:py-3 lg:text-[1rem]"
              >
                <svg
                  class="size-5 shrink-0 text-brand-primary lg:size-4.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                {CUSTOM_PLAN.badge}
              </span>
            </div>
          </div>
        </div>

        {/* Same button as Subscribe, in the same place, to a mailto */}
        <a
          href={`mailto:${CUSTOM_PLAN.contactEmail}?subject=${encodeURIComponent(CUSTOM_PLAN.contactSubject)}`}
          class="mt-5 flex w-full items-center justify-center gap-2.5 rounded-full bg-button-primary px-6 py-3.75 text-[0.75rem] leading-none text-button-text transition-colors duration-300 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary lg:mt-5.5 lg:gap-1 lg:py-2.5 lg:text-[1rem]"
        >
          {CUSTOM_PLAN.ctaLabel}
          <svg
            class="size-3 shrink-0 lg:size-7.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

    {/* ── Included in every plan ───────────────────────────────── */}
    <div class="mt-7.5 px-2.25 lg:mt-14 lg:px-16.5">
      <h2 class="text-[1rem] text-brand-primary lg:text-[1.125rem]">
        INCLUDED IN EVERY PLAN
      </h2>
      <ul
        class="mt-5 grid grid-cols-1 gap-x-10 gap-y-3.5 sm:grid-cols-2 lg:mt-6 lg:gap-x-20 lg:gap-y-5.5"
      >
        {
          PLAN_FEATURES.map((feature) => (
            <li class="flex items-center gap-3 lg:gap-4">
              <svg
                class="size-5 shrink-0 text-brand-primary lg:size-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10" />
                <path d="m9 12 2 2 4-4" />
              </svg>
              <span class="text-[0.875rem] capitalize text-white lg:text-[1rem]">
                {feature}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <span
      class="mt-9 block h-px w-full bg-white/30 lg:mx-6 lg:mt-12 lg:w-[calc(100%-3rem)]"
    ></span>

    {/* ── How credits work ─────────────────────────────────────── */}
    <div class="mt-8 px-2.25 lg:mt-10 lg:px-16.5">
      <h2 class="text-[1rem] text-brand-primary lg:text-[1.125rem]">
        HOW CREDITS WORK
      </h2>
      <ul class="mt-5 flex flex-col gap-2 lg:gap-2.5">
        {
          CREDIT_COSTS.map((row, i) => (
            <li class="relative flex items-center justify-between gap-4">
              <span class="flex items-center gap-1.5 text-[0.875rem] text-white lg:text-[0.9375rem]">
                {row.label}
                {row.detail && (
                  <span class="text-white/50">· {row.detail}</span>
                )}
                {/*
                  A button, not the bare svg, is the hover/focus target — natively
                  focusable, so the tooltip is keyboard-reachable without putting a
                  `tabindex` on a non-interactive element.
                */}
                <span class="group static flex shrink-0 items-center lg:relative">
                  <button
                    type="button"
                    class="flex shrink-0 cursor-help items-center text-[#BFABFF]"
                    aria-describedby={`credit-tip-${i}`}
                    aria-label={`About ${row.label}`}
                  >
                    <svg
                      class="size-3.5 shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <circle
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        stroke-width="2"
                      />
                      <path
                        d="M12 16v-4M12 8h.01"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                      />
                    </svg>
