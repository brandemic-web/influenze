---
import Button from "../common/Button.astro";
import { CUSTOM_PLAN } from "../../data/pricing";
import { CONTACT_URL } from "../../data/site";

const [before, after] = CUSTOM_PLAN.description.split(CUSTOM_PLAN.descriptionHighlight);
---

<section class="bg-background-primary pb-24" aria-labelledby="custom-plan-heading">
	<div class="mx-auto max-w-[1348px] px-4">
		<div class="flex flex-col gap-10 rounded-[20px] bg-surface-card px-8 py-[60px] lg:flex-row lg:justify-between lg:px-[88px]">
			<div>
				<p class="text-[18px] text-brand-primary">{CUSTOM_PLAN.label}</p>
				<h2 id="custom-plan-heading" class="mt-[37px] max-w-[573px] text-9xl capitalize leading-[1.1] text-white max-md:text-3xl">
					{CUSTOM_PLAN.heading}
				</h2>
			</div>
			<div class="lg:max-w-[448px] lg:pt-[11px]">
				<p class="text-[18px] leading-[28px] text-white">
					{before}<span class="font-semibold text-brand-primary">{CUSTOM_PLAN.descriptionHighlight}</span><span class="font-semibold">,</span>{after}
				</p>
				<p class="mt-7 text-[18px] leading-[28px] text-white">{CUSTOM_PLAN.availability}</p>
				<div class="mt-9">
					<Button href={CONTACT_URL}>{CUSTOM_PLAN.buttonLabel}</Button>
				</div>
			</div>
		</div>
	</div>
</section>
