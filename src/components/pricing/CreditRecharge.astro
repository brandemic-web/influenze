---
/**
 * Credit Recharge — top-up block below the pricing panel.
 *
 * A plan switch (Growth / Accelerate) drives two readouts: what you pay to
 * recharge, and the credits that buys once the bonus is applied.
 *
 * ⚠ This section is a HIDDEN layer in the Figma file, so it could not be
 * rendered for visual reference — the copy, ordering and geometry below were
 * reconstructed from the layer names and their x/y positions, and styled to
 * match the rest of the page. Re-check it against the design once the layer is
 * turned on. The amounts are PLACEHOLDERS except Growth (₹10,000 → ₹11,000);
 * see the note in data/pricing.ts.
 *
 * DOM hooks read by creditRecharge.ts:
 *   data-recharge-panel   root the script scans for
 *   data-options          JSON option data the readouts are computed from
 *   data-option           plan switch button (data-index into the options)
 *   data-field            element bound to a derived value (recharge/credits)
 */
import { CONTACT_URL } from "../../data/site";
import { CREDIT_RECHARGE } from "../../data/pricing";
import { formatPrice } from "./pricingModel";

const options = CREDIT_RECHARGE.options;
const initial = options[0];
const initialWorth = Math.round(initial.recharge * (1 + initial.bonusPct / 100));
const optionsJson = JSON.stringify(options);
---

<section
	class="relative overflow-hidden pb-20 lg:pb-32"
	aria-labelledby="credit-recharge-heading"
	data-recharge-panel
	data-options={optionsJson}
>
	<div class="relative mx-auto max-w-288 px-6">
		<h2
			id="credit-recharge-heading"
			class="text-center text-4xl capitalize leading-[1.1] text-white lg:text-6xl"
		>
			{CREDIT_RECHARGE.title}
		</h2>

		<!-- ── Plan switch ───────────────────────────────────────────── -->
		<div
			class="mt-8 flex justify-center"
			role="tablist"
			aria-label="Choose a plan to recharge"
		>
			<div
				class="flex gap-1 rounded-full border border-white/15 bg-surface-pill/60 p-1"
			>
				{
					options.map((option, i) => (
						<button
							type="button"
							role="tab"
							aria-selected={i === 0 ? "true" : "false"}
							class="cursor-pointer rounded-full px-7 py-3.5 text-[0.75rem] uppercase tracking-wide text-white transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary aria-selected:bg-brand-primary aria-selected:text-button-text lg:text-xs"
							data-option
							data-index={i}
						>
							{option.name}
						</button>
					))
				}
			</div>
		</div>

		<p
			class="mx-auto mt-8 max-w-175 text-center text-[1rem] leading-7 text-white/70"
		>
			{CREDIT_RECHARGE.body}
		</p>

		<!-- ── Readouts ──────────────────────────────────────────────── -->
		<div
			class="relative mx-auto mt-12 flex max-w-200 flex-col items-stretch gap-6 lg:flex-row lg:items-center lg:gap-10"
		>
			<!-- what you pay -->
			<div
				class="flex-1 rounded-[1.25rem] border border-white/12 bg-[rgba(73,40,179,0.22)] px-7 py-8 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),0_12px_40px_-12px_rgba(0,0,0,0.45)] backdrop-blur-2xl"
			>
				<div class="flex items-center justify-between gap-4">
					<span
						class="text-[0.6875rem] uppercase tracking-wide text-white/50"
						>{CREDIT_RECHARGE.currentPlanLabel}</span
					>
					<span
						class="rounded-full border border-brand-primary/40 bg-brand-primary/10 px-3 py-1 text-[0.6875rem] text-brand-primary"
						data-field="planName">{initial.name}</span
					>
				</div>

				<span class="mt-5 block h-px w-full bg-white/12"></span>

				<p
					class="mt-5 text-[0.6875rem] uppercase tracking-wide text-white/50"
				>
					{CREDIT_RECHARGE.rechargeLabel}
				</p>
				<p
					class="mt-2 text-[2.25rem] leading-none text-white"
					data-field="recharge"
				>
					{formatPrice(initial.recharge)}
				</p>

				<a
					href={CONTACT_URL}
					class="mt-6 inline-block text-[0.6875rem] uppercase tracking-wide text-brand-primary underline-offset-4 transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary"
				>
					{CREDIT_RECHARGE.contactLabel}
				</a>
			</div>

			<!--
				Bonus badge between the two cards. Figma draws this as a starburst
				with a "%" glyph, but the layer is hidden and could not be rendered,
				so this is a legible circular stand-in in the same palette.
			-->
			<div
				class="pointer-events-none flex shrink-0 items-center justify-center"
			>
				<div
					class="flex size-20 items-center justify-center rounded-full border border-brand-primary/50 bg-brand-primary/10 shadow-[0_0_24px_rgba(58,255,152,0.35),inset_0_1px_0_rgba(255,255,255,0.15)]"
				>
					<span
						class="text-[1.375rem] leading-none text-brand-primary"
						data-field="bonusPct">+{initial.bonusPct}%</span
					>
				</div>
			</div>

			<!-- what you get -->
			<div
				class="flex-1 rounded-[1.25rem] border border-white/12 bg-[rgba(73,40,179,0.22)] px-7 py-8 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.14),0_12px_40px_-12px_rgba(0,0,0,0.45)] backdrop-blur-2xl"
			>
				<p class="text-[0.6875rem] uppercase tracking-wide text-white/50">
					{CREDIT_RECHARGE.creditsWorthLabel}
				</p>
				<p
					class="mt-2 text-[2.25rem] leading-none text-brand-primary"
					data-field="creditsWorth"
				>
					{formatPrice(initialWorth)}
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	import { initCreditRecharge } from "./creditRecharge";

	initCreditRecharge();
</script>
