---
/**
 * "Who is it for?" — the heading, green throughout with its starred word italic, over
 * 485px cards in the homepage's marquee: rendered twice for a seamless right-to-left
 * loop that pauses on hover (scripts/use-case-cards.ts). With reduced motion, or
 * without JS, the strip scrolls sideways by hand instead.
 */
import TwoTone from "../compare/TwoTone.astro";
import type { CardText } from "../../data/platform";

interface Props {
	heading: string;
	cards: CardText[];
	/** lg top padding in rem — the gap from the section above, as drawn. */
	gap: number;
}

const { heading, cards, gap } = Astro.props;
const trim = "lg:[text-box:trim-both_cap_alphabetic]";
---

<section class="relative pt-20 lg:pt-(--gap)" style={`--gap:${gap}rem`} aria-labelledby="who-for-heading">
	<h2
		id="who-for-heading"
		class="px-6 text-center text-[1.875rem] capitalize leading-[1.15] text-brand-primary [text-box:trim-both_cap_alphabetic] lg:text-[2.25rem]"
	>
		<TwoTone text={heading} accentClass="italic" />
	</h2>
	<div class="use-case-marquee who-for-marquee relative mt-10 overflow-hidden pb-1 lg:mt-12">
		<ul class="use-case-track flex w-max gap-5">
			{
				[...cards, ...cards].map((card, i) => (
					<li aria-hidden={i >= cards.length ? "true" : undefined} class="shrink-0">
						<article class="card-edge flex h-full w-[19rem] flex-col justify-center lg:justify-start gap-5 rounded-sm px-6 py-7 lg:w-[30.3125rem] lg:gap-7 lg:px-[3.625rem] lg:py-10">
							<h3 class:list={["text-[1.25rem] leading-7 text-white lg:text-md lg:leading-7.5", trim]}>{card.title}</h3>
							<p class:list={["text-[0.9375rem] leading-6 text-[#CECECE]/70 lg:text-[1.125rem] lg:leading-6.5", trim]}>
								{card.body}
							</p>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* Reduced motion leaves the loop off, so the strip scrolls by hand instead. */
	@media (prefers-reduced-motion: reduce) {
		.who-for-marquee {
			overflow-x: auto;
			scrollbar-width: none;
		}
	}
</style>

<script>
	import "../../scripts/use-case-cards";
</script>
