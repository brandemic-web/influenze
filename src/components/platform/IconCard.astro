---
/**
 * The platform page's outlined card: an icon tile beside the title, a line of copy
 * under it — 60/40px padding round a 331px column, as drawn. Tiles are the Figma
 * exports (48px, #242433 with the glyph in green); search, users and square-check
 * are the site's existing copies of the same tiles. As drawn, the title and text run
 * past the 331px column rather than wrap.
 */
import search from "../../assets/images/common/icons/search.svg";
import users from "../../assets/images/common/icons/users.svg";
import squareCheckBig from "../../assets/images/common/icons/square_check_big.svg";
import hash from "../../assets/images/platform_page/icons/hash.svg";
import mapPin from "../../assets/images/platform_page/icons/map_pin.svg";
import userRoundGroup from "../../assets/images/platform_page/icons/user_round_group.svg";
import heart from "../../assets/images/platform_page/icons/heart.svg";
import refreshCcw from "../../assets/images/platform_page/icons/refresh_ccw.svg";
import circleUserRound from "../../assets/images/platform_page/icons/circle_user_round.svg";
import circleDollarSign from "../../assets/images/platform_page/icons/circle_dollar_sign.svg";
import type { IconTile } from "../../data/platform";

export const ICON_ASSETS: Record<IconTile, ImageMetadata> = {
	search,
	hash,
	users,
	mapPin,
	userRoundGroup,
	heart,
	squareCheckBig,
	refreshCcw,
	circleUserRound,
	circleDollarSign,
};

interface Props {
	icon: IconTile;
	title: string;
	body: string;
	class?: string;
}

const { icon, title, body, class: className = "" } = Astro.props;
---

<article
	class:list={[
		"card-edge flex h-full w-[19rem] flex-col justify-center gap-4 rounded-sm px-6 py-7 lg:w-[28.1875rem] lg:gap-5 lg:px-15 lg:py-10",
		className,
	]}
>
	<div class="flex items-center gap-4">
		<img src={ICON_ASSETS[icon].src} alt="" width="48" height="48" class="size-10 shrink-0 rounded-sm lg:size-12" loading="lazy" />
		<h3 class="text-[1.25rem] leading-7 text-white lg:text-md lg:leading-7.5 lg:whitespace-nowrap">{title}</h3>
	</div>
	<p class="text-[0.9375rem] leading-6 text-[#CECECE]/70 lg:w-[23.0625rem] lg:text-[1.125rem] lg:leading-6.5">{body}</p>
</article>
