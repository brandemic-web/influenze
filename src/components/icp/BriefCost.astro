---
/**
 * "What one client brief takes" — a panel with the credit total and the actions behind
 * it, the 3D logo standing over its right side, as drawn (575×188 panel at 577,5625).
 */
import { Image } from "astro:assets";
import Icon from "../app/common/Icon.astro";
import TwoTone from "../compare/TwoTone.astro";
import logo3d from "../../assets/images/pricing_guide_page/common/influenze_logo_3d.png";
import { plainText } from "../../data/icp";

interface Props {
	heading: string;
	subcopy: string;
	total: string;
	lines: string[];
}

const { heading, subcopy, total, lines } = Astro.props;
---

<section class="relative px-6 pt-20 text-center lg:h-[37.75rem] lg:w-[108rem] lg:mx-[calc(50%-54rem)] lg:p-0" aria-labelledby="cost-heading">
	<h2 id="cost-heading" class="text-[1.875rem] capitalize leading-[1.15] text-white [text-box:trim-both_cap_alphabetic] lg:absolute lg:top-0 lg:left-0 lg:w-full lg:text-[2.25rem]">
		<TwoTone text={heading} />
	</h2>
	<p class="mx-auto mt-4 max-w-[26.3125rem] text-[1rem] leading-6 text-[#cdcdcd]/70 [text-box:trim-both_cap_alphabetic] lg:absolute lg:top-[3.875rem] lg:left-[40.875rem] lg:mt-0 lg:text-[1.125rem] lg:leading-7">
		{plainText(subcopy)}
	</p>
	<div class="relative mx-auto mt-8 max-w-[35.9375rem] rounded-[1.25rem] bg-[#0a0718]/40 p-6 text-left backdrop-blur-md lg:absolute lg:top-[11.75rem] lg:left-[36.0625rem] lg:mt-0 lg:h-[11.75rem] lg:w-[35.9375rem] lg:p-0">
		<p class="text-md leading-none text-brand-primary lg:absolute lg:top-[1.875rem] lg:left-[4rem]">{plainText(total)}</p>
		<ul class="mt-4 flex flex-col gap-[0.8125rem] lg:absolute lg:top-[4.875rem] lg:left-[4rem] lg:mt-0">
			{
				lines.map((line) => (
					<li class="flex items-center gap-[0.375rem] text-[1rem] leading-none text-[#f3f3ff]">
						<Icon name="circleCheck" size="0.8125rem" class="text-brand-primary" />
						{line}
					</li>
				))
			}
		</ul>
	</div>
	<Image
		src={logo3d}
		alt=""
		widths={[301, 602]}
		sizes="(min-width: 1024px) 18.8125rem, 5rem"
		class="pointer-events-none absolute right-6 bottom-0 w-16 lg:top-[3.375rem] lg:right-auto lg:bottom-auto lg:left-[51.6875rem] lg:w-[18.8125rem]"
		loading="lazy"
	/>
</section>
