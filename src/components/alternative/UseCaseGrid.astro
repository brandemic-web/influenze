---
/**
 * "Use cases for brands and agencies" — four 520px glass cards on a 2×2 grid, each a
 * title over one ticked line, as drawn.
 */
import TwoTone from "../compare/TwoTone.astro";
import circleCheck from "../../assets/images/home_page/use_cases/circle_check.svg";
import type { CardText } from "../../data/alternative";

interface Props {
	heading: string;
	cards: CardText[];
}

const { heading, cards } = Astro.props;
---

<section class="relative px-6 pt-16 pb-0 lg:pt-37.5 lg:pb-37.5" aria-labelledby="use-cases-heading">
	{/* gradient background */}
	<div
		class="pointer-events-none absolute inset-x-0 -top-112 bottom-0 -z-1 lg:hidden bg-[linear-gradient(180deg,transparent_0%,#8058FF_57.3%,#241949_75.9%,#010101_100%)]"
		aria-hidden="true"
	>
	</div>
	<h2
		id="use-cases-heading"
		class="text-center text-[1.875rem] capitalize leading-[1.1] text-white lg:text-[3.4375rem]"
	>
		<TwoTone text={heading} accentBlock />
	</h2>

	<ul class="mx-auto mt-10 grid max-w-268 gap-4 lg:mt-16 lg:grid-cols-2 lg:gap-8" data-reveal data-reveal-stagger="0.12">
		{
			cards.map((card) => (
				<li
					class="flex min-h-32 flex-col justify-center gap-5 rounded-md bg-[rgba(246,246,244,0.1)] px-6 py-6 lg:h-39.75 lg:gap-7.5 lg:py-7 lg:pr-6 lg:pl-13.75"
					data-reveal-item
				>
					<h3 class="text-[1.25rem] capitalize leading-7 text-[#F6F6F4] lg:text-md">{card.title}</h3>
					<p class="flex items-center gap-3 text-[0.9375rem] leading-5.5 text-white lg:gap-3.75 lg:text-[1.125rem]">
						<img src={circleCheck.src} alt="" width="24" height="24" class="size-5 shrink-0 lg:size-6" loading="lazy" />
						{card.body}
					</p>
				</li>
			))
		}
	</ul>
</section>

<script>
	import "../../scripts/reveals";
</script>
