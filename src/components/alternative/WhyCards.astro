---
/**
 * "Why Influenze is an alternative" — 390px outlined cards in the homepage's marquee:
 * rendered twice for a seamless right-to-left loop that pauses on hover
 * (scripts/use-case-cards.ts). With reduced motion, or without JS, the strip scrolls
 * sideways by hand instead.
 */
import TwoTone from "../compare/TwoTone.astro";
import type { CardText } from "../../data/alternative";

interface Props {
	heading: string;
	cards: CardText[];
}

const { heading, cards } = Astro.props;
---

{/* -mb-1 cancels the marquee's pb-1 (kept so the cards' bottom border isn't clipped), keeping the 64px gap below lg. */}
<section class="relative pt-16 max-lg:-mb-1 lg:pt-0" aria-labelledby="why-heading">
	<h2 id="why-heading" class="px-6 text-center text-[1.875rem] capitalize leading-[1.15] text-white lg:text-[2.25rem] lg:leading-9">
		<TwoTone text={heading} />
	</h2>

	<div class="use-case-marquee why-marquee relative mt-10 overflow-hidden pb-1 lg:mt-14.5">
		<ul class="use-case-track flex w-max gap-3 lg:gap-3.5">
			{
				[...cards, ...cards].map((card, i) => (
					<li aria-hidden={i >= cards.length ? "true" : undefined} class="shrink-0">
						<article class="flex h-full min-h-47.5 w-72 flex-col rounded-sm border border-[#19123a] bg-[#010101] px-7 py-8 lg:h-41.5 lg:min-h-0 lg:w-97.5 lg:justify-center lg:py-0 lg:pr-6 lg:pl-9.5">
							<h3 class="text-[1.25rem] leading-7 text-white lg:text-md lg:leading-7.5">{card.title}</h3>
							<p class="mt-3 text-[0.9375rem] leading-6 whitespace-pre-line text-[#CECECE]/70 lg:mt-5 lg:text-[1.125rem] lg:leading-6.5">
								{card.body}
							</p>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* Reduced motion leaves the loop off, so the strip scrolls by hand instead. */
	@media (prefers-reduced-motion: reduce) {
		.why-marquee {
			overflow-x: auto;
			scrollbar-width: none;
		}
	}
</style>

<script>
	import "../../scripts/use-case-cards";
</script>
