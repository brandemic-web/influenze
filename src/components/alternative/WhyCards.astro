---
/**
 * "Why Influenze is an alternative" — 390px outlined cards in a row that outruns the
 * frame, as drawn, so it is a free-scrolling Swiper (scripts/swiper-rail.ts); without
 * JS the same markup scrolls natively.
 */
import TwoTone from "../compare/TwoTone.astro";
import type { CardText } from "../../data/alternative";

interface Props {
	heading: string;
	cards: CardText[];
}

const { heading, cards } = Astro.props;
---

<section class="relative" aria-labelledby="why-heading">
	<h2 id="why-heading" class="px-6 text-center text-[1.875rem] capitalize leading-[1.15] text-white lg:text-[2.25rem] lg:leading-9">
		<TwoTone text={heading} />
	</h2>

	<div class="why-rail swiper mt-10 lg:mt-14.5" data-swiper-rail data-inset-mobile="1.5" data-inset-desktop="2.5">
		<ul class="swiper-wrapper">
			{
				cards.map((card) => (
					// The gap is the slide's own right padding, so Swiper's measured widths include it.
					<li class="swiper-slide w-auto! pr-3 last:pr-0 lg:pr-3.5">
						<article class="flex h-full min-h-47.5 w-72 flex-col justify-items-start ;g:justify-center rounded-sm border border-[#19123a] bg-[#010101] px-7 py-8 lg:h-41.5 lg:w-97.5 lg:py-0 lg:pr-6 lg:pl-9.5">
							<h3 class="text-[1.25rem] leading-7 text-white lg:text-md lg:leading-7.5">{card.title}</h3>
							<p class="mt-3 text-[0.9375rem] leading-6 whitespace-pre-line text-[#CECECE]/70 lg:mt-5 lg:text-[1.125rem] lg:leading-6.5">
								{card.body}
							</p>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* Before Swiper runs (or without JS) the row scrolls natively. */
	.why-rail:not(:global(.swiper-initialized)) {
		overflow-x: auto;
		scrollbar-width: none;
		padding-inline: 1.5rem;
	}

	.why-rail:not(:global(.swiper-initialized))::-webkit-scrollbar {
		display: none;
	}

	@media (min-width: 1024px) {
		.why-rail:not(:global(.swiper-initialized)) {
			padding-inline: 2.5rem;
		}
	}
</style>

<script>
	import "../../scripts/swiper-rail";
</script>
