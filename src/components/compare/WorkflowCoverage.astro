---
/**
 * The campaign workflow as a timeline: an icon per step on one shared line, a card
 * under each with both platforms' coverage. Five 282px cards 50px apart (1610px) sit
 * centred on the 1728 grid with a 59px inset, so the desktop row fits without
 * scrolling; on narrower screens it is a free-scrolling Swiper (scripts/swiper-rail.ts),
 * and without JS a native sideways scroller.
 */
import Icon from "../app/common/Icon.astro";
import TwoTone from "./TwoTone.astro";
import { WORKFLOW_STEPS, plainText } from "../../data/compare";
import type { ResolvedCompetitor } from "../../lib/compare-source";

interface Props {
	competitor: ResolvedCompetitor;
}

const { competitor } = Astro.props;
---

<section class="relative pt-16 lg:pt-37.5" aria-labelledby="workflow-heading">
	<div class="flex flex-col items-center px-6 text-center">
		<h2 id="workflow-heading" class="text-[1.875rem] capitalize leading-[1.15] text-white lg:text-[2.25rem] lg:leading-9">
			<TwoTone text={competitor.copy.workflowHeading} />
		</h2>
		<p class="mt-3 max-w-102 text-[0.875rem] leading-[1.55] text-[#CDCDCD]/70 lg:mt-6.5 lg:text-[1.125rem] lg:leading-7">
			{plainText(competitor.copy.workflowSubcopy)}
		</p>
	</div>

	<div class="workflow-swiper swiper mt-10 lg:mt-19" data-swiper-rail data-inset-mobile="1.5" data-inset-desktop="3.6875">
		<ol class="swiper-wrapper">
			{/*
				One line through every icon's centre, drawn once so its green-to-white fade
				runs the whole track as in the design. It sits in the wrapper so it moves
				with the slides (Swiper only counts `.swiper-slide` children), and is sized
				from the step count, one slide pitch per gap, since the wrapper itself is
				only as wide as the viewport.
			*/}
			<span
				class="pointer-events-none absolute top-5.5 left-31 h-px w-[calc(var(--gaps)*17rem)] bg-linear-to-r from-brand-primary/70 from-30% to-white/70 lg:top-6 lg:left-[8.8125rem] lg:w-[calc(var(--gaps)*20.75rem)]"
				style={`--gaps: ${WORKFLOW_STEPS.length - 1}`}
				aria-hidden="true"></span>
			{
				WORKFLOW_STEPS.map((step) => (
					// The gap is the slide's own right padding, so Swiper's measured widths include it.
					<li class="swiper-slide w-auto! pr-6 last:pr-0 lg:pr-12.5">
						<div class="flex w-62 flex-col items-center lg:w-70.5">
							<span class="relative grid size-11 place-items-center rounded-sm bg-surface-pill text-brand-primary lg:size-12">
								<Icon name={step.icon} size="1.5rem" />
							</span>
							<div class="mt-4 w-full rounded-sm bg-black/40 py-5 pr-4 pl-6 lg:mt-5.75 lg:py-6.25 lg:pl-8.25">
								<h3 class="text-[1.25rem] leading-7 whitespace-nowrap text-white lg:text-md lg:leading-7.5">
									{step.title}
								</h3>
								<p class="mt-1.5 text-[0.9375rem] leading-6 text-white lg:text-[1.125rem] lg:leading-6.5">
									<span class="text-brand-primary">Influenze.ai</span> : {step.influenze}
								</p>
								<p class="mt-1 text-[0.9375rem] leading-6 text-white/54 lg:mt-2 lg:text-[1.125rem] lg:leading-6.5">
									{competitor.name} : {competitor.workflow[step.id]}
								</p>
							</div>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	/* Before Swiper runs (or without JS) the track scrolls natively. */
	.workflow-swiper:not(:global(.swiper-initialized)) {
		overflow-x: auto;
		scrollbar-width: none;
		padding-inline: 1.5rem;
	}

	.workflow-swiper:not(:global(.swiper-initialized))::-webkit-scrollbar {
		display: none;
	}

	@media (min-width: 1024px) {
		.workflow-swiper:not(:global(.swiper-initialized)) {
			padding-inline: 3.6875rem;
		}
	}
</style>

<script>
	import "../../scripts/swiper-rail";
</script>
