---
/**
 * Renders a heading string's `*starred*` words in brand green — see `twoTone` in
 * data/compare/shared.ts. `accentBlock` puts each green run on its own line, as
 * the pricing heading is drawn. `accentClass` restyles the starred run, for headings
 * drawn green throughout with an italic word instead.
 */
import { twoTone } from "../../data/compare";

interface Props {
	text: string;
	accentBlock?: boolean;
	accentClass?: string;
}

const { text, accentBlock = false, accentClass = "text-brand-primary" } = Astro.props;
// Headings are `capitalize`d, which would print the brand as "Influenze.Ai".
const brandSplit = (t: string) => t.split(/(Influenze\.ai)/);
---

{
	twoTone(text).map((s) => {
		const parts = brandSplit(s.text).map((part, i) => (i % 2 ? <span class="normal-case">{part}</span> : part));
		return s.accent ? <span class:list={[accentClass, accentBlock && "block"]}>{parts}</span> : parts;
	})
}
