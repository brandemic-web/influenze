---
/** The per-action credit costs as pills: "(5) Direct Search", and so on. */
import { CREDIT_CHIPS } from "../../data/compare";

interface Props {
	/** `lg` is the pricing table's larger set, drawn at 37px tall. */
	size?: "md" | "lg";
	class?: string;
}

const { size = "md", class: className = "" } = Astro.props;
const large = size === "lg";
---

<ul class:list={["flex flex-wrap justify-center gap-2", large && "lg:gap-2.75", className]} aria-label="Credits per action">
	{
		CREDIT_CHIPS.map((chip) => (
			<li
				class:list={[
					"flex items-center gap-1.5 rounded-full border border-white/25 bg-surface-pill/60 py-1 pr-2.5 pl-1 text-[0.625rem] leading-4 whitespace-nowrap text-white",
					large ? "lg:gap-2 lg:py-1.5 lg:pr-3.5 lg:pl-1.5 lg:text-[0.875rem] lg:leading-5" : "lg:py-1.25 lg:text-[0.71875rem]",
				]}
			>
				<span
					class:list={[
						"grid h-4.5 min-w-4.5 place-items-center rounded-full bg-brand-primary/35 px-1 text-brand-primary",
						large ? "lg:h-6 lg:min-w-6" : "lg:h-5 lg:min-w-5",
					]}
				>
					{chip.cost}
				</span>
				{chip.label}
			</li>
		))
	}
</ul>
