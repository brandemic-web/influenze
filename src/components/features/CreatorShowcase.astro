---
import { Image } from "astro:assets";
import listingOne from "../../assets/images/common/ui_images/creator_listing_one.png";
import listingTwo from "../../assets/images/common/ui_images/creator_listing_two.png";
import listingThree from "../../assets/images/common/ui_images/creator_listing_three.png";
---

<section class="py-24 lg:pt-32 lg:pb-0" aria-labelledby="showcase-heading">
	<h2 id="showcase-heading" class="mx-auto max-w-[1613px] px-6 text-7xl capitalize leading-[1.1] max-lg:text-6xl max-md:text-3xl lg:px-25 max-lg:text-center lg:text-left">
		<span class="text-quaternary">The</span>
		<span class="text-brand-secondary"> fastest way</span>
		<span class="text-quaternary"> To discover</span>
		<span class="block lg:text-right"><span class="text-quaternary">and evaluate the</span> <span class="text-white">right creators</span></span>
	</h2>

	<div class="mx-auto mt-4 flex max-w-200 flex-col gap-4 px-6 lg:mt-4 relative" data-reveal>
		{
			[listingOne, listingTwo, listingThree].map((listing) => (
				<Image src={listing} alt="Creator search result" class="w-full" widths={[879, 1758]} sizes="(max-width: 1498px) 100vw, 1450px" loading="lazy" data-reveal-item />
			))
		}
		<div class="bg-linear-to-b from-transparent via-transparent via-60% to-background-primary absolute top-0 left-0 h-full w-full" data-reveal-item="">
		</div>
	</div>
</section>

<script>
	import "../../scripts/reveals";
</script>
