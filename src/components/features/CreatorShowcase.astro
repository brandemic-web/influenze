---
/**
 * The features page's creator strip, built from the app's own `ProfileCard` — the same
 * component the hero mockup uses, so there is one definition of a creator row. Rows
 * only, no column header: this is a marketing strip, not a working table. `.wf-strip`
 * scales it the way the hero canvas does (see styles/app-tokens.css).
 */
import ProfileCard from "../app/common/ProfileCard.astro";
import { SHOWCASE_HANDLES, creatorByHandle } from "../../data/workflowMockup";
import { getFeaturesPage } from "../../sanity/lib/queries";
import { getPerspectiveCookie } from "../../lib/draft-mode";

const rows = SHOWCASE_HANDLES.map(creatorByHandle);

const { data: features } = await getFeaturesPage(getPerspectiveCookie(Astro.cookies));
const heading = {
	top: features?.creatorShowcase?.heading?.top || "The fastest way To discover",
	bottom: features?.creatorShowcase?.heading?.bottom || "And evaluate the right creators",
};
---

<section class="lg:pt-32 lg:pb-0" aria-labelledby="showcase-heading">
	<h2 id="showcase-heading" class="mx-auto max-w-376 px-6 text-7xl capitalize leading-[1.1] text-white max-lg:text-6xl max-md:text-md lg:px-25 max-lg:text-center lg:text-left">
		{heading.top}
		<span class="lg:block lg:text-right">{heading.bottom}</span>
	</h2>

	<div class="mx-auto mt-2 max-w-200 px-6 lg:mt-4" data-reveal>
		{/* See WorkflowMockup for what scripts/canvasScale does with these. */}
		<div class="wf-strip" data-canvas-fit>
			<div class="wf-strip-canvas flex flex-col gap-4" data-canvas>
				{rows.map((creator) => (
					<div data-reveal-item>
						<ProfileCard creator={creator} />
					</div>
				))}
			</div>

			<div class="bg-linear-to-b from-transparent via-transparent via-60% to-background-primary absolute inset-0" data-reveal-item="">
			</div>
		</div>
	</div>
</section>

<script>
	import "../../scripts/canvasScale";
	import "../../scripts/reveals";
</script>
