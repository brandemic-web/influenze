---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { FEATURE_BLOCKS } from "../../data/featureBlocks";

import bubblesTrio from "../../assets/images/home_page/featured_tabs/discover_and_analyze_image.png";
import filtersPanel from "../../assets/images/common/ui_images/creator_filters_panel.png";
import accountStats from "../../assets/images/common/ui_images/accounts_stats.svg";
import likesGraph from "../../assets/images/common/ui_images/avg_likes_graph.svg";
import creatorsListing from "../../assets/images/featured_page/blocks/contact_unlock_rows.png";
import comparisonDashboard from "../../assets/images/common/ui_images/creator_comparison_dashboard.png";
import addToList from "../../assets/images/common/ui_images/add_to_list.png";
import sharePopup from "../../assets/images/common/ui_images/share_email_popup.png";
import campaignDashboard from "../../assets/images/common/ui_images/campaign_creator_dashboard.png";
import hami_insta_handle from "../../assets/images/featured_page/blocks/hamid_insta_handle.png";

type FeatureImage = {
	src: ImageMetadata;
	alt: string;
	class: string;
	widths?: number[];
	sizes?: string;
	/** Render as a plain <img> (used for SVGs). */
	raw?: boolean;
};

type FeatureLayout = {
	/** Extra classes for the flex row wrapper. */
	rowExtra?: string;
	/** Extra classes for the text column. */
	textExtra?: string;
	/** Classes for the media (white) box. */
	mediaClass: string;
	/** Optional wrapper around the images inside the media box. */
	innerClass?: string;
	images: FeatureImage[];
};

const MEDIA_BASE =
	"flex aspect-16/10 w-full items-center justify-center rounded-[20px] bg-white/50";

/** Image + layout specifics per block, keyed by `imageKey` in featureBlocks.ts. */
const LAYOUTS: Record<string, FeatureLayout> = {
	discovery: {
		rowExtra: "justify-between",
		mediaClass: `${MEDIA_BASE} overflow-hidden p-6 lg:w-1/2 lg:p-4`,
		innerClass: "relative flex h-full w-full items-center justify-center gap-4",
		images: [
			{ src: bubblesTrio, alt: "", class: "max-h-full w-[50%] object-contain" },
			{
				src: filtersPanel,
				alt: "Creator filters panel",
				class: "max-h-full w-[50%] object-contain",
			},
			{
				src: hami_insta_handle,
				alt: "",
				class: "absolute bottom-[22%] left-[13%] w-[22%]",
			},
		],
	},
	analytics: {
		mediaClass: `${MEDIA_BASE} overflow-hidden p-6 lg:w-1/2 lg:p-10`,
		innerClass: "flex h-full w-full items-start justify-center gap-1",
		images: [
			{
				src: accountStats,
				alt: "Account stats",
				class: "max-h-full w-[48%] object-contain",
				raw: true,
			},
			{
				src: likesGraph,
				alt: "Average likes growth graph",
				class: "max-h-full w-[42%] object-contain pt-10",
				raw: true,
			},
		],
	},
	contacts: {
		mediaClass: `${MEDIA_BASE} p-6 lg:w-1/2`,
		innerClass: "w-full max-w-full",
		images: [
			{
				src: creatorsListing,
				alt: "Creator contact detail rows",
				class: "max-h-full w-full max-w-none object-contain",
				widths: [640, 1280, 1920],
				sizes: "(max-width: 1024px) 115vw, 828px",
			},
		],
	},
	comparisons: {
		mediaClass: `${MEDIA_BASE} overflow-hidden p-4 lg:w-1/2 lg:p-5`,
		images: [
			{
				src: comparisonDashboard,
				alt: "Real-Time Creator Comparisons",
				class: "max-h-full w-auto max-w-full object-contain",
				widths: [640, 1280],
				sizes: "(max-width: 1024px) 100vw, 720px",
			},
		],
	},
	shortlists: {
		mediaClass: `${MEDIA_BASE} overflow-hidden p-6 lg:w-1/2 lg:p-12`,
		images: [
			{
				src: addToList,
				alt: "Organized Creator Shortlists with import and export",
				class: "max-h-full w-auto max-w-[70%] object-contain",
				widths: [640, 1280],
				sizes: "(max-width: 1024px) 100vw, 720px",
			},
		],
	},
	sharing: {
		mediaClass: `${MEDIA_BASE} overflow-hidden p-6 lg:w-1/2 lg:p-4`,
		images: [
			{
				src: sharePopup,
				alt: "Easy Sharing",
				class: "max-h-full w-auto max-w-full object-contain",
				widths: [640, 1280],
				sizes: "(max-width: 1024px) 100vw, 720px",
			},
		],
	},
	pools: {
		textExtra: "lg:pr-30",
		mediaClass: `${MEDIA_BASE} overflow-hidden p-6 lg:w-1/2 lg:p-4`,
		images: [
			{
				src: campaignDashboard,
				alt: "Reusable Creator Pools",
				class: "max-h-full w-auto max-w-full object-contain",
				widths: [640, 1280],
				sizes: "(max-width: 1024px) 100vw, 720px",
			},
		],
	},
};

/**
 * Sticky offsets when pinned on large screens. Written as literal classes
 * (not built dynamically) so Tailwind can detect them at build time.
 */
const STICKY_TOPS = [
	"lg:top-34",
	"lg:top-40",
	"lg:top-46",
	"lg:top-52",
	"lg:top-58",
	"lg:top-64",
	"lg:top-70",
];
---

{
	FEATURE_BLOCKS.map((block, i) => {
		const layout = LAYOUTS[block.imageKey];
		const top = STICKY_TOPS[i] ?? STICKY_TOPS[STICKY_TOPS.length - 1];
		return (
			<article
				class={`relative top-auto lg:sticky ${top} mx-auto w-full rounded-[28px] backdrop-blur-md bg-white/10 border border-white/20 shadow-lg p-4`}
			>
				<div
					class={`flex flex-col gap-8 lg:flex-row lg:items-stretch ${layout.rowExtra ?? ""}`}
				>
					<div
						class={`flex min-w-0 flex-col justify-center py-8 lg:w-1/2 lg:pl-[64px] ${layout.textExtra ?? ""}`}
					>
						<h3 class="text-[58px] capitalize leading-[normal] text-white max-lg:text-4xl max-md:text-2xl">
							{block.title}
						</h3>
						<p class="mt-8 max-w-[444px] text-xs leading-[26px] text-white lg:mt-10">
							{block.description}
						</p>
					</div>
					<div class={layout.mediaClass}>
						{layout.innerClass ? (
							<div class={layout.innerClass}>
								{layout.images.map((img) =>
									img.raw ? (
										<img
											src={img.src.src}
											alt={img.alt}
											class={img.class}
											loading="lazy"
										/>
									) : (
										<Image
											src={img.src}
											alt={img.alt}
											class={img.class}
											widths={img.widths}
											sizes={img.sizes}
											loading="lazy"
										/>
									),
								)}
							</div>
						) : (
							layout.images.map((img) =>
								img.raw ? (
									<img
										src={img.src.src}
										alt={img.alt}
										class={img.class}
										loading="lazy"
									/>
								) : (
									<Image
										src={img.src}
										alt={img.alt}
										class={img.class}
										widths={img.widths}
										sizes={img.sizes}
										loading="lazy"
									/>
								),
							)
						)}
					</div>
				</div>
			</article>
		);
	})
}
