---
import { Image } from "astro:assets";
import Button from "../common/Button.astro";
import TwoTone from "../compare/TwoTone.astro";
import Icon from "../app/common/Icon.astro";
import { FEATURE_BLOCKS, type FeatureBlock } from "../../data/featureBlocks";
import { opensNewTab } from "../../data/site";
import { getFeaturesPage } from "../../sanity/lib/queries";
import { getPerspectiveCookie } from "../../lib/draft-mode";

import bubblesTrio from "../../assets/images/home_page/featured_tabs/discover_and_analyze_image.png";
import filtersPanel from "../../assets/images/common/ui_images/creator_filters_panel.png";
import accountStats from "../../assets/images/common/ui_images/accounts_stats.svg";
import likesGraph from "../../assets/images/common/ui_images/avg_likes_graph.svg";
import creatorsListing from "../../assets/images/featured_page/blocks/contact_unlock_rows.png";
import comparisonDashboard from "../../assets/images/common/ui_images/creator_comparison_dashboard.png";
import campaignDashboard from "../../assets/images/common/ui_images/campaign_creator_dashboard.png";
import hamidHandle from "../../assets/images/featured_page/blocks/hamid_insta_handle.png";
import importToolbar from "../../assets/images/featured_page/blocks/ui_widgets.png";
import csvProgress from "../../assets/images/featured_page/blocks/csv_export_progress.png";
import csvComplete from "../../assets/images/featured_page/blocks/csv_export_complete.png";
import shareToEmail from "../../assets/images/featured_page/blocks/share.svg";

interface Props {
	cards?: readonly FeatureBlock[];
	actions?: { signupHref: string; demo: { label: string; href: string } };
}

const { cards, actions } = Astro.props;
const { data: features } = cards ? { data: null } : await getFeaturesPage(getPerspectiveCookie(Astro.cookies));
const blocks = cards ?? FEATURE_BLOCKS.map((local, index) => ({
	...local,
	title: features?.featureBlocks?.[index]?.title || local.title,
	description: features?.featureBlocks?.[index]?.description || local.description,
}));

const stickyOffsets = ["lg:top-34", "lg:top-40", "lg:top-46", "lg:top-52", "lg:top-58", "lg:top-64", "lg:top-70"];
const visualLayout: Record<FeatureBlock["imageKey"], string> = {
	discovery: "items-center overflow-hidden p-6 lg:p-4",
	analytics: "items-center overflow-hidden p-6 lg:p-10",
	contacts: "items-center p-6",
	comparisons: "items-center overflow-hidden p-4 lg:p-5",
	shortlists: "flex-col items-start gap-3.5 overflow-hidden p-8 lg:p-18",
	sharing: "items-center overflow-hidden p-6 lg:p-4",
	pools: "items-center overflow-hidden p-6 lg:p-4",
};
---

{blocks.map((block, index) => (
	<article
		id={cards ? `feature-${block.imageKey}` : undefined}
		tabindex={cards ? -1 : undefined}
		class:list={["relative mx-auto w-full rounded-[1rem] border border-white/20 p-4 shadow-lg lg:sticky lg:rounded-[1.75rem]", stickyOffsets[index], cards && "scroll-mt-24 lg:scroll-mt-36"]}
		data-feature-card
	>
		<div class:list={["flex flex-col gap-4 lg:flex-row lg:items-stretch lg:gap-8", block.imageKey === "discovery" && "justify-between"]}>
			<div
				class:list={[
					"flex min-w-0 flex-col justify-center lg:w-1/2 lg:py-8",
					cards ? "px-2 lg:pl-12" : "lg:pl-16",
					block.imageKey === "pools" && "lg:pr-30",
				]}
			>
				<h3 class:list={[
					"text-white",
					cards
						? "text-[clamp(1.375rem,4.5vw,2.25rem)] leading-[1.16] lg:text-[2.875rem] lg:leading-[1.14]"
						: "text-[3.625rem] leading-8 capitalize max-lg:text-4xl max-md:text-[1.25rem] lg:leading-[normal]",
				]}>
					{cards ? <TwoTone text={block.title} accentBlock /> : block.title}
				</h3>
				<p class:list={["mt-3 max-w-111 text-[0.875rem] leading-6.5 text-white", cards ? "lg:mt-5 lg:text-[1rem]" : "lg:mt-10"]}>
					{block.description}
				</p>
				{block.highlights?.length && (
					<ul class="mt-5 grid gap-2.5 text-[0.875rem] leading-5.5 text-white/85 lg:text-[0.9375rem]">
						{block.highlights.map((item) => (
							<li class="flex items-start gap-2.5">
								<span class="mt-0.5 grid size-4.5 shrink-0 place-items-center rounded-full bg-brand-primary/15 text-brand-primary">
									<Icon name="check" size="0.75rem" />
								</span>
								<span>{item}</span>
							</li>
						))}
					</ul>
				)}
				{actions && block.ctaLabel && (
					<div class="mt-6 flex flex-wrap gap-3">
						<Button href={actions.signupHref}>{block.ctaLabel}</Button>
						<Button href={actions.demo.href} newTab={opensNewTab(actions.demo.href)}>{actions.demo.label}</Button>
					</div>
				)}
			</div>
			<div class:list={[
				"flex aspect-16/10 w-full justify-center rounded-[1rem] bg-white/50 lg:w-1/2 lg:rounded-[1.25rem]",
				visualLayout[block.imageKey],
			]}>
				{block.imageKey === "discovery" && (
					<div class="relative flex h-full w-full items-center justify-center gap-8">
						<Image src={bubblesTrio} alt="" class="max-h-full w-[50%] object-contain" loading="lazy" />
						<Image src={filtersPanel} alt="Creator filters panel" class="max-h-full w-[50%] object-contain" loading="lazy" />
						<Image src={hamidHandle} alt="" class="absolute bottom-[22%] left-[13%] w-[22%]" loading="lazy" />
					</div>
				)}
				{block.imageKey === "analytics" && (
					<div class="flex h-full w-full items-start justify-center gap-1">
						<img src={accountStats.src} alt="Account stats" class="max-h-full w-[48%] object-contain" loading="lazy" />
						<img src={likesGraph.src} alt="Average likes growth graph" class="max-h-full w-[42%] object-contain pt-10" loading="lazy" />
					</div>
				)}
				{block.imageKey === "contacts" && (
					<div class="w-full max-w-full">
						<Image src={creatorsListing} alt="Creator contact detail rows" class="max-h-full w-full max-w-none object-contain" widths={[640, 1280, 1920]} sizes="(max-width: 1024px) 115vw, 828px" loading="lazy" />
					</div>
				)}
				{block.imageKey === "comparisons" && (
					<Image src={comparisonDashboard} alt="Creator metrics compared side by side" class="max-h-full w-auto max-w-full object-contain" widths={[640, 1280]} sizes="(max-width: 1024px) 100vw, 720px" loading="lazy" />
				)}
				{block.imageKey === "shortlists" && (
					<>
						<div>
							<Image src={importToolbar} alt="Header showing import status and remaining credits" class="w-[24rem] object-contain" widths={[640, 1280]} sizes="(max-width: 1024px) 100vw, 720px" loading="lazy" />
						</div>
						<div class="flex gap-2">
							<Image src={csvProgress} alt="CSV upload showing progress, errors, and duplicates." class="w-[60%] object-contain" widths={[640, 1280]} sizes="(max-width: 1024px) 100vw, 720px" loading="lazy" />
							<Image src={csvComplete} alt="Export modal showing selected columns and download option." class="w-[40%] object-contain" widths={[640, 1280]} sizes="(max-width: 1024px) 100vw, 720px" loading="lazy" />
						</div>
					</>
				)}
				{block.imageKey === "sharing" && (
					<img src={shareToEmail.src} alt="Share to email dialog with a recipient, an expiry date and a Send button" class="max-h-full w-auto max-w-full object-contain" loading="lazy" />
				)}
				{block.imageKey === "pools" && (
					<Image src={campaignDashboard} alt="Reusable Creator Pools" class="max-h-full w-auto max-w-full object-contain" widths={[640, 1280]} sizes="(max-width: 1024px) 100vw, 720px" loading="lazy" />
				)}
			</div>
		</div>
	</article>
))}

<script>
	import "../../scripts/features-page/feature-stack";
</script>

<style>
	/* The sticky deck turns covered cards solid so their frosted layers do not compound. */
	[data-feature-card] {
		--solid: 0;
		--faded: 0;
		background-color: color-mix(in srgb, #1f1f1f calc(var(--solid) * 100%), rgb(255 255 255 / 0.1));
		-webkit-backdrop-filter: blur(calc((1 - var(--solid)) * 12px));
		backdrop-filter: blur(calc((1 - var(--solid)) * 12px));
	}

	/* Keep covered text available to assistive technology. */
	[data-feature-card] > div {
		opacity: calc(1 - var(--faded));
	}

	[data-feature-card][data-solid] {
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
	}

	[data-feature-card]:has(:focus-visible) {
		z-index: 1;
		background-color: #1f1f1f;
	}

	[data-feature-card]:has(:focus-visible) > div {
		opacity: 1;
	}
</style>
