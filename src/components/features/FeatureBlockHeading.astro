---
import SectionHeading from "../common/SectionHeading.astro";
import bg_gradient from "../../assets/images/common/decor/gradient_s_bg.svg"
import FeatureBlock from "./FeatureBlock.astro";

---

<section class="relative bg-background-primary pt-15 pb-5 lg:py-25" aria-label="The platform that actually does the work">
    <SectionHeading
        segments={[{ text: "The platform that actually" }, { text: " does the work", accent: true }]}
        class="mx-auto max-w-204 px-6 max-md:text-md"
    />
    <div class="absolute top-0 lg:-top-50 w-full mx-auto">
        <img src={bg_gradient.src} alt="" class="mx-auto w-full">
      </div>
    <div class="mt-7 flex flex-col gap-5 lg:gap-8 px-4 lg:mt-16 lg:px-19.5 relative z-2 max-w-[96.875rem] mx-auto">
        <FeatureBlock />
    </div>
</section>