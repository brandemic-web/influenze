---
import "../styles/global.css";
import { getImage } from "astro:assets";
import { APP_URL, SITE } from "../data/site";
import Header from "../components/common/Header.astro";
import CtaBand from "../components/common/CtaBand.astro";
import Footer from "../components/common/Footer.astro";
import SanityVisualEditing from "../components/common/SanityVisualEditing.tsx";
import DisableDraftMode from "../components/common/DisableDraftMode.tsx";
import { isDraftMode, getPerspectiveCookie } from "../lib/draft-mode";
import { getSiteSettings } from "../sanity/lib/queries";
import logoSource from "../assets/images/common/logos_and_icons/influenze_wordmark_mobile.png";

// Driven entirely by Sanity: the Presentation tool sets a cookie via
// /api/draft-mode/enable when you open it, and that cookie's presence is
// what turns this on — no env flag to flip.
const draftMode = isDraftMode(Astro.cookies);

interface Props {
	title?: string;
	description?: string;
	ctaButtonLabel?: string;
	hideCta?: boolean;
	/** Keeps a page out of search results. Used by 404. */
	noindex?: boolean;
	/** ISO 8601 date for the page's WebPage node. Used by the legal routes. */
	dateModified?: string;
	/** Extra JSON-LD nodes merged into the site-wide `@graph`. Ignored if `structuredDataOverride` is set. */
	schema?: Record<string, unknown>[];
	/** A full JSON-LD document that replaces all auto-generated structured data, verbatim — Sanity's seo.customSchema. */
	structuredDataOverride?: Record<string, unknown>;
	/** Overrides the auto-computed canonical URL — Sanity's seo.canonicalUrl. */
	canonicalUrl?: string;
	/**
	 * This page's own header/footer scripts — Sanity's page.scripts. Merged
	 * after the site-wide ones, which Layout fetches itself from
	 * siteSettings, so every page gets the global scripts for free.
	 */
	scripts?: { header?: string; footer?: string };
	/**
	 * Scale the whole desktop layout with the window down to 1024px, with no 12px floor
	 * on the root size — the landing-page templates are drawn at fixed design positions,
	 * so they stay an exact scaled copy of the 1728 frame at every desktop width.
	 */
	fluidRem?: boolean;
}

const {
	title = SITE.title,
	description = SITE.description,
	ctaButtonLabel,
	hideCta = false,
	noindex = false,
	dateModified,
	schema = [],
	structuredDataOverride,
	canonicalUrl,
	scripts,
	fluidRem = false,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = canonicalUrl ? new URL(canonicalUrl, site) : new URL(path, site);

// Deliberately a plain static file rather than `getImage()`. Under SSR,
// getImage emits a runtime `/_image?href=...&w=...` URL, and `&` has to be
// written `&amp;` inside an HTML attribute — scrapers that don't decode
// entities then request `amp;f=jpeg` and get a 400, so WhatsApp fell back to
// the favicon. A query-string-free URL can't be mangled that way.
//
// public/og-card.jpg is 1200x630, generated from the 2400x1260 master at
// src/assets/images/common/social/og_card.webp:
//   sharp(master).resize(1200, 630).jpeg({ quality: 90, mozjpeg: true })
const ogImage = new URL("/og-card.jpg", site);

// Set only by preview.yml: PR previews report to dev Analytics instead of GTM,
// so they never reach live numbers. Production builds leave it unset.
const devGaId = import.meta.env.PUBLIC_DEV_GA_ID;
const appHost = new URL(APP_URL).hostname;

// Independent of each other, so they run concurrently rather than adding
// their latencies — the logo render doesn't need Sanity's response or vice versa.
const [orgLogo, { data: settings }] = await Promise.all([
	// Google wants a raster logo it can crop to a square, so this points at
	// the wordmark PNG rather than the nav SVG.
	getImage({ src: logoSource, width: 600, format: "png" }),
	getSiteSettings(getPerspectiveCookie(Astro.cookies)),
]);

const organizationId = new URL("/#organization", site).href;
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": organizationId,
			name: SITE.name,
			url: site.href,
			description: SITE.description,
			logo: new URL(orgLogo.src, site).href,
		},
		{
			"@type": "WebSite",
			"@id": new URL("/#website", site).href,
			url: site.href,
			name: SITE.name,
			description: SITE.description,
			publisher: { "@id": organizationId },
			inLanguage: "en",
		},
		{
			"@type": "WebPage",
			url: canonical.href,
			name: title,
			description,
			isPartOf: { "@id": new URL("/#website", site).href },
			...(dateModified ? { dateModified } : {}),
		},
		...schema,
	],
};

const inlineHeaderScripts = [settings?.scripts?.header, scripts?.header].filter(
	(s): s is string => Boolean(s),
);
const inlineFooterScripts = [settings?.scripts?.footer, scripts?.footer].filter(
	(s): s is string => Boolean(s),
);
---

<!doctype html>
<html lang="en" class:list={[fluidRem && "fluid-rem"]}>
	<head>
		<meta name="saashub-verification" content="nfzi8lh09rn2" />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{
			devGaId ? (
				<>
					<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${devGaId}`} />
					{/* The dev app is on another domain, so the visitor ID crosses in the link (`_gl`). */}
					<script is:inline define:vars={{ devGaId, appHost }}>
						window.dataLayer = window.dataLayer || [];
						window.gtag = function () {
							window.dataLayer.push(arguments);
						};
						window.izDirectGa = true;
						gtag("js", new Date());
						gtag("config", devGaId, { linker: { domains: [appHost] } });
					</script>
				</>
			) : (
				<>
					<!-- Google Tag Manager, deferred: its tags (GA4, Meta, Clarity, Factors) cost
					     mobile 400–800 ms of blocking time and pushed LCP to 7–10 s in Lighthouse.
					     The container loads on the first interaction, or 3 s after `load`. Events
					     pushed before then (signup_cta_click) wait in dataLayer and replay. -->
					<script is:inline>
						(function (w, d, l, i) {
							w[l] = w[l] || [];
							w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
							var done = false;
							var cues = ["pointerdown", "keydown", "touchstart", "scroll", "wheel"];
							function boot() {
								if (done) return;
								done = true;
								cues.forEach(function (e) {
									w.removeEventListener(e, boot, true);
								});
								var j = d.createElement("script");
								j.async = true;
								j.src = "https://www.googletagmanager.com/gtm.js?id=" + i;
								d.head.appendChild(j);
							}
							cues.forEach(function (e) {
								w.addEventListener(e, boot, { capture: true, passive: true, once: true });
							});
							if (d.readyState === "complete") setTimeout(boot, 3000);
							else w.addEventListener("load", function () { setTimeout(boot, 3000); });
						})(window, document, "dataLayer", "GTM-TTJDWGW3");
					</script>
					<!-- End Google Tag Manager -->
				</>
			)
		}
		<!-- GA4 (G-958BZ5FG62, shared with app.influenze.ai) fires from inside the GTM
		     container; a direct gtag.js tag here as well double-counts page views. -->
		<link rel="icon" type="image/webp" href="/favicon.webp" />
		<link rel="apple-touch-icon" href="/favicon.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={SITE.name} />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={SITE.name} />
		<link
			rel="preload"
			href="/fonts/open-sauce-two-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/open-sauce-two-latin-700-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredDataOverride ?? structuredData)} />
		{inlineHeaderScripts.map((s) => <Fragment set:html={s} />)}
	</head>
	<body class="min-h-screen overflow-x-clip antialiased">
		{
			!devGaId && (
				<noscript
					><iframe
						src="https://www.googletagmanager.com/ns.html?id=GTM-TTJDWGW3"
						height="0"
						width="0"
						style="display:none;visibility:hidden"></iframe></noscript
				>
			)
		}
		<Header />
		<slot />
		{!hideCta && <CtaBand buttonLabel={ctaButtonLabel} />}
		<Footer />
		{
			draftMode && (
				<>
					<SanityVisualEditing client:only="react" />
					<DisableDraftMode client:only="react" />
				</>
			)
		}
		{inlineFooterScripts.map((s) => <Fragment set:html={s} />)}
		<script>
			import "../scripts/attribution";
		</script>
	</body>
</html>
